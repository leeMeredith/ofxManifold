# ofxManifold Manifold2D conformance vectors
# GENERATED by tests/ref/reference_manifold.py -- do not hand edit
#
# Containment in this reference uses the EDGE-SIGN test; the C++
# uses barycentric non-negativity. Different arithmetic, same
# predicate, so agreement is evidence rather than tautology.
#
# TOPOLOGY <class> <tjunctions> <orphans> <duplicates>

TOL 1e-06

# one triangle, clean topology
MANIFOLD single_triangle
NODE A 0.2 0.2 1
NODE B 0.8 0.25 1
NODE C 0.45 0.85 1
TRI T0 A B C
# centroid: exact thirds, and the containing region must be T0
QUERY centroid ANALYTIC 0.4833333333 0.4333333333 T0 A=0.3333333333 B=0.3333333333 C=0.3333333333
# a vertex is contained, and is entirely itself
QUERY at_vertex_a ANALYTIC 0.2 0.2 T0 A=1 B=0 C=0
QUERY interior CROSS 0.45 0.4 T0 A=0.417218543 B=0.298013245 C=0.2847682119
# outside the hull: inside == false, empty weights, no clamping
QUERY outside_left ANALYTIC 0.02 0.5 NONE
QUERY outside_below ANALYTIC 0.5 0.02 NONE
# forward then inverse must return the same point. Neither direction is the authority for the other
ROUNDTRIP rt_centroid ANALYTIC 0.4833333333 0.4333333333 0.4833333333 0.4333333333 1
ROUNDTRIP rt_interior CROSS 0.45 0.4 0.45 0.4 1
ROUNDTRIP rt_near_vertex CROSS 0.21 0.21 0.21 0.21 1
# an explicit even blend must land on the centroid
INVERSE inv_equal_thirds CROSS 0.4833333333 0.4333333333 1 A=0.3333333333 B=0.3333333333 C=0.3333333333
# all weight on one node lands on that node, but A alone belongs to a region only together with B and C, so this is still well posed
INVERSE inv_single_node ANALYTIC 0.2 0.2 1 A=1
# weights summing to 0.8 are not well posed; a position is still returned and the caller decides
INVERSE inv_sum_not_one SPEC 0.38125 0.29375 0 A=0.5 B=0.2 C=0.1
# a small move inside the region keeps the winding: accepted
MOVE move_small ANALYTIC A 0.22 0.22 1
# A dragged past edge B-C inverts the triangle: refused
MOVE move_across ANALYTIC A 0.65 0.8 0
# A moved onto the line through B and C flattens the region: refused
MOVE move_onto_edge ANALYTIC A 0.625 0.55 0
TOPOLOGY ANALYTIC 0 0 0
END

# two triangles sharing edge B-C, conforming, clean
MANIFOLD shared_edge
NODE A 0.1 0.1 1
NODE B 0.9 0.1 1
NODE C 0.5 0.9 1
NODE D 0.95 0.85 1
TRI T0 A B C
TRI T1 B D C
QUERY in_first CROSS 0.4 0.3 T0 A=0.5 B=0.25 C=0.25
QUERY in_second CROSS 0.8 0.55 T1 B=0.4191176471 D=0.2941176471 C=0.2867647059
# on edge B-C: both regions contain it, first-hit gives T0. Ordering is our rule, hence SPEC
QUERY on_shared_edge SPEC 0.7 0.5 T0 A=2.220446049e-16 B=0.5 C=0.5
QUERY near_edge_first CROSS 0.699 0.499 T0 A=0.001875 B=0.499375 C=0.49875
QUERY near_edge_second CROSS 0.701 0.501 T1 B=0.4985294118 D=0.003529411765 C=0.4979411765
TOPOLOGY ANALYTIC 0 0 0
END

# M lies on the interior of T0's edge A-B without being a vertex of T0. Exactly one T-junction, known by construction.
MANIFOLD t_junction
NODE A 0.1 0.1 1
NODE B 0.9 0.1 1
NODE C 0.5 0.8 1
NODE M 0.5 0.1 1
NODE D 0.5 0.02 1
TRI T0 A B C
TRI T1 A D M
QUERY interior_of_first CROSS 0.5 0.4 T0 A=0.2857142857 B=0.2857142857 C=0.4285714286
TOPOLOGY ANALYTIC 1 0 0
END

# LOST belongs to no region: exactly one orphan, zero T-junctions
MANIFOLD orphan_node
NODE A 0.2 0.2 1
NODE B 0.8 0.25 1
NODE C 0.45 0.85 1
NODE LOST 0.05 0.95 1
TRI T0 A B C
QUERY centroid CROSS 0.483333 0.433333 T0 A=0.3333341722 B=0.3333329801 C=0.3333328477
TOPOLOGY ANALYTIC 0 1 0
END

# T1 covers the same three nodes as T0: exactly one duplicate
MANIFOLD duplicate_region
NODE A 0.2 0.2 1
NODE B 0.8 0.25 1
NODE C 0.45 0.85 1
TRI T0 A B C
TRI T1 B C A
# overlapping identical regions: first-hit gives T0. SPEC, our rule
QUERY centroid SPEC 0.483333 0.433333 T0 A=0.3333341722 B=0.3333329801 C=0.3333328477
TOPOLOGY ANALYTIC 0 0 1
END

# four triangles fanned around O, conforming, clean
MANIFOLD fan
NODE N 0.5 0.9 1
NODE E 0.9 0.5 1
NODE S 0.5 0.1 1
NODE W 0.1 0.5 1
NODE O 0.5 0.5 1
TRI Q0 O N E
TRI Q1 O E S
TRI Q2 O S W
TRI Q3 O W N
QUERY q0 CROSS 0.62 0.62 Q0 O=0.4 N=0.3 E=0.3
QUERY q1 CROSS 0.62 0.38 Q1 O=0.4 E=0.3 S=0.3
QUERY q2 CROSS 0.38 0.38 Q2 O=0.4 S=0.3 W=0.3
QUERY q3 CROSS 0.38 0.62 Q3 O=0.4 W=0.3 N=0.3
# the shared vertex: every region contains it, first-hit gives Q0
QUERY at_centre SPEC 0.5 0.5 Q0 O=1 N=-0 E=-0
# beyond the diamond hull: inside == false
QUERY outside_corner ANALYTIC 0.95 0.95 NONE
# all three nodes belong to Q0: well posed
INVERSE inv_within_one_region CROSS 0.6 0.6 1 O=0.5 N=0.25 E=0.25
# N and S share NO region -- Q0 holds N, Q2 holds S. The weights sum to one and the recovered position lands exactly on O, which looks entirely plausible. Only the flag distinguishes it. This is the case that makes wellPosed worth having rather than decorative
INVERSE inv_spans_disjoint_regions ANALYTIC 0.5 0.5 0 N=0.5 S=0.5
# the other diagonal: same fault, same plausible-looking centre
INVERSE inv_opposite_rim ANALYTIC 0.5 0.5 0 E=0.5 W=0.5
TOPOLOGY ANALYTIC 0 0 0
END

# T0 and T1 overlap by design. Topology counts here are SPEC, not ANALYTIC: overlap produces incidental T-junctions that are a consequence of the construction rather than a hand-known fault.
MANIFOLD overlap
NODE A 0.05 0.05 1
NODE B 0.55 0.05 1
NODE C 0.3 0.55 1
NODE D 0.3 0.05 1
NODE E 0.8 0.05 1
NODE F 0.55 0.55 1
TRI T0 A B C
TRI T1 D E F
# no hint: first-hit gives T0
QUERY fresh_in_overlap SPEC 0.4 0.15 T0 A=0.2 B=0.6 C=0.2
QUERY exclusive_to_t1 CROSS 0.65 0.15 T1 D=0.2 E=0.6 F=0.2
# entering through T1's exclusive zone and moving into the overlap must hold T1 throughout -- hysteresis
TRACK track_enters_t1_then_overlap SPEC 0.65 0.15 T1 0.5 0.15 T1 0.4 0.15 T1
# the mirror case: entering through T0 holds T0 in the same overlap
TRACK track_enters_t0_then_overlap SPEC 0.15 0.15 T0 0.3 0.15 T0 0.4 0.15 T0
# leaving the hull clears the hint, so re-entry falls back to first-hit rather than inheriting a stale region
TRACK track_leaves_and_returns SPEC 0.65 0.15 T1 0.95 0.45 NONE 0.4 0.15 T0
TOPOLOGY SPEC 2 0 0
END

# node A biased 2.0: the bias must survive the manifold layer
MANIFOLD weighted_nodes
NODE A 0.2 0.2 2
NODE B 0.8 0.25 1
NODE C 0.45 0.85 1
TRI T0 A B C
# equal raw coordinates, so the result is the normalized bias vector
QUERY centroid_biased SPEC 0.4833333333 0.4333333333 T0 A=0.5 B=0.25 C=0.25
QUERY interior_biased SPEC 0.45 0.4 T0 A=0.5887850467 B=0.2102803738 C=0.2009345794
# THE case for un-biasing in positionOf. A naive weighted sum of node positions against biased weights lands elsewhere; only undoing the bias first returns the original point
ROUNDTRIP rt_biased_centroid ANALYTIC 0.4833333333 0.4333333333 0.4833333333 0.4333333333 1
ROUNDTRIP rt_biased_interior CROSS 0.45 0.4 0.45 0.4 1
TOPOLOGY ANALYTIC 0 0 0
END
