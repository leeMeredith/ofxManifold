# ofxManifold -- 3D map geometry vectors (round 3A-4)
# Generated by tests/ref/reference_levels.py. Do not edit.
#
# NODES name i:x,y ...          the floor plan's node positions
# TRIS name a,b,c ...           its triangles
# STACK name NODES n OPS ...    levels built by operations, each
#                               with the result it must give
# HEIGHTS name cls stack ...    every node's height, every level
# EVAL3 / EVALXYZ               weights over node@level; the
#                               runner also checks they sum to 1,
#                               are >= 0, and reproduce the point

NODES square 0:0.1,0.1 1:0.9,0.1 2:0.9,0.9 3:0.1,0.9
TRIS square 0,1,2 0,2,3

# one level: today's map. z is ignored.
STACK flat NODES square OPS 
HEIGHTS heights_flat ANALYTIC flat L0 0,0,0,0
# three flat levels, at 0, 0.5 and 1: copy the floor, then
# copy that copy
STACK three NODES square OPS COPY 0 0.5 =1 ; COPY 1 1 =2
HEIGHTS heights_three ANALYTIC three L0 0,0,0,0 L1 0.5,0.5,0.5,0.5 L2 1,1,1,1
# the middle level bent: node 2 raised from 0.5 to 0.8, a
# branch leaning up toward the top level
STACK bent NODES square OPS COPY 0 0.5 =1 ; COPY 1 1 =2 ; RAISE 1 0.3 2 =OK
HEIGHTS heights_bent ANALYTIC bent L0 0,0,0,0 L1 0.5,0.5,0.8,0.5 L2 1,1,1,1
# a level copied to a height BETWEEN two others goes between
# them: copy of 0 at 1.0 is level 1, then a copy at 0.4 is
# inserted as the new level 1
STACK between NODES square OPS COPY 0 1 =1 ; COPY 0 0.4 =1
HEIGHTS heights_between ANALYTIC between L0 0,0,0,0 L1 0.4,0.4,0.4,0.4 L2 1,1,1,1
# copying a bent level copies the bend: the new level at 1.0
# has nodes 0 and 1 at 1.2
STACK copybent NODES square OPS COPY 0 0.5 =1 ; RAISE 1 0.2 0,1 =OK ; COPY 1 1 =2
HEIGHTS heights_copybent ANALYTIC copybent L0 0,0,0,0 L1 0.7,0.7,0.5,0.5 L2 1.2,1.2,1,1

# REFUSED, changing nothing, and naming the nodes:
# raising the middle level's node 2 by 0.5 would TOUCH the top
# level (1.0): touching is refused, not just crossing. Then
# nodes 1 and 2 by 0.6: both refused, so neither moves -- all
# or nothing. Lowering node 0 below the ground: refused.
# Then node 2 up 0.3 (to 0.8, fine), and nodes 1 and 2 up 0.3
# more: node 1 would fit, node 2 would cross the top. Refused,
# and node 1 stays at 0.5 -- HEIGHTS shows it.
STACK refuse_reach NODES square OPS COPY 0 0.5 =1 ; COPY 1 1 =2 ; RAISE 1 0.5 2 =REFUSED:2 ; RAISE 1 0.6 1,2 =REFUSED:1,2 ; RAISE 1 -0.6 0 =REFUSED:0 ; RAISE 1 0.3 2 =OK ; RAISE 1 0.3 1,2 =REFUSED:2
HEIGHTS heights_refuse_reach ANALYTIC refuse_reach L0 0,0,0,0 L1 0.5,0.5,0.8,0.5 L2 1,1,1,1
# copying the ground to 0.7 puts the new level above the middle
# one -- but the middle level's node 3 was raised to 0.9, and
# 0.7 is below it: refused for node 3, nothing changes. A
# second level at 0.5: refused, one already starts there.
STACK refuse_copy NODES square OPS COPY 0 0.5 =1 ; RAISE 1 0.4 3 =OK ; COPY 0 0.7 =REFUSED:3 ; COPY 0 0.5 =REFUSED:-
HEIGHTS heights_refuse_copy ANALYTIC refuse_copy L0 0,0,0,0 L1 0.5,0.5,0.5,0.9
# the level ABOVE checks a copy too: the top level's node 1 is
# lowered to 0.4, so a copy of the ground at 0.5 would put
# node 1 above it -- refused for node 1
STACK refuse_copy_upper NODES square OPS COPY 0 1 =1 ; RAISE 1 -0.6 1 =OK ; COPY 0 0.5 =REFUSED:1
HEIGHTS heights_refuse_copy_upper ANALYTIC refuse_copy_upper L0 0,0,0,0 L1 1,0.4,1,1
# the only level cannot be removed
STACK refuse_last NODES square OPS REMOVE 0 =REFUSED
HEIGHTS heights_refuse_last ANALYTIC refuse_last L0 0,0,0,0
# removing the bent middle level leaves 0 and 1 flat
STACK remove_middle NODES square OPS COPY 0 0.5 =1 ; COPY 1 1 =2 ; RAISE 1 0.3 2 =OK ; REMOVE 1 =OK
HEIGHTS heights_remove_middle ANALYTIC remove_middle L0 0,0,0,0 L1 1,1,1,1
# set one node's height, as a file does: 1.5 fits; 0.0 on
# level 1 touches the ground and is refused; -0.25 on the
# ground fits
STACK set_heights NODES square OPS COPY 0 1 =1 ; SET 1 2 1.5 =OK ; SET 1 0 0 =REFUSED ; SET 0 1 -0.25 =OK
HEIGHTS heights_set_heights ANALYTIC set_heights L0 0,-0.25,0,0 L1 1,1,1.5,1

#--------------------------------------------------------------------
# WEIGHTS for given floor-plan weights. Every record is also
# checked for summing to 1, no negatives, and reproducing the
# point from the node positions and heights.
#--------------------------------------------------------------------
# one level: z ignored, the floor plan's weights on level 0
EVAL3 flat_ignores_z ANALYTIC flat W 0=0.25 1=0.25 2=0.25 3=0.25 Z 7 EXPECT 0@0=0.25 1@0=0.25 2@0=0.25 3@0=0.25
# flat levels are exact prisms: a quarter of the way from 0 to
# 0.5, each node weighs 0.25 x 0.75 below and 0.25 x 0.25 above
EVAL3 prism_quarter ANALYTIC three W 0=0.25 1=0.25 2=0.25 3=0.25 Z 0.125 EXPECT 0@0=0.1875 0@1=0.0625 1@0=0.1875 1@1=0.0625 2@0=0.1875 2@1=0.0625 3@0=0.1875 3@1=0.0625
# exactly on the middle level: that level alone
EVAL3 on_middle_level ANALYTIC three W 0=0.25 1=0.25 2=0.25 3=0.25 Z 0.5 EXPECT 0@1=0.25 1@1=0.25 2@1=0.25 3@1=0.25
EVAL3 on_bottom ANALYTIC three W 0=0.25 1=0.25 2=0.25 3=0.25 Z 0 EXPECT 0@0=0.25 1@0=0.25 2@0=0.25 3@0=0.25
EVAL3 on_top ANALYTIC three W 0=0.25 1=0.25 2=0.25 3=0.25 Z 1 EXPECT 0@2=0.25 1@2=0.25 2@2=0.25 3@2=0.25
EVAL3 upper_cell ANALYTIC three W 0=0.5 1=0.5 Z 0.875 EXPECT 0@1=0.125 0@2=0.375 1@1=0.125 1@2=0.375
# above the top level: OUTSIDE, as off a 2D map's edge -- not
# clamped to the top level
EVAL3 above_top ANALYTIC three W 0=0.25 1=0.25 2=0.25 3=0.25 Z 1.01 EXPECT OUTSIDE
EVAL3 below_bottom ANALYTIC three W 0=0.25 1=0.25 2=0.25 3=0.25 Z -0.2 EXPECT OUTSIDE
# the bent level: under node 2 the middle level is higher
# at node 2 the middle level is at 0.8: z = 0.5 is 5/8 of the
# way up from the ground, not on the middle level
EVAL3 bent_at_raised ANALYTIC bent W 2=1 Z 0.5 EXPECT 2@0=0.375 2@1=0.625
# at node 0 the middle level is still at 0.5
EVAL3 bent_elsewhere ANALYTIC bent W 0=1 Z 0.5 EXPECT 0@1=1
# where the bend is partial: middle level at 0.5 + 0.4 x 0.3
# = 0.62 here
EVAL3 bent_between CROSS bent W 0=0.2 1=0.3 2=0.4 3=0.1 Z 0.55 EXPECT 0@0=0.02258064516 0@1=0.1774193548 1@0=0.03387096774 1@1=0.2661290323 2@0=0.04516129032 2@1=0.3548387097 3@0=0.01129032258 3@1=0.08870967742
EVAL3 bent_upper CROSS bent W 1=0.3 2=0.7 Z 0.9 EXPECT 1@1=0.1034482759 1@2=0.1965517241 2@1=0.2413793103 2@2=0.4586206897
EVAL3 copybent_mid CROSS copybent W 0=0.5 2=0.5 Z 0.95 EXPECT 0@1=0.15 0@2=0.35 2@1=0.15 2@2=0.35
# the level copied to 0.4 sits between 0 and 1.0: z = 0.2 is
# halfway between the ground and IT
EVAL3 between_inserted ANALYTIC between W 0=0.25 1=0.25 2=0.25 3=0.25 Z 0.2 EXPECT 0@0=0.125 0@1=0.125 1@0=0.125 1@1=0.125 2@0=0.125 2@1=0.125 3@0=0.125 3@1=0.125

#--------------------------------------------------------------------
# THE WHOLE PATH: a real point (x, y, z) through the C++ floor
# plan's own evaluation, then the levels. Here the point
# reproduced is the query point itself.
#--------------------------------------------------------------------
EVALXYZ xyz_centre ANALYTIC three SQUARE P 0.5 0.5 0.25 EXPECT 0@0=0.25 0@1=0.25 2@0=0.25 2@1=0.25
EVALXYZ xyz_lower_tri CROSS bent SQUARE P 0.7 0.3 0.6 EXPECT 0@1=0.2352941176 0@2=0.01470588235 1@1=0.4705882353 1@2=0.02941176471 2@1=0.2352941176 2@2=0.01470588235
EVALXYZ xyz_upper_tri CROSS bent SQUARE P 0.3 0.7 0.6 EXPECT 0@1=0.2352941176 0@2=0.01470588235 2@1=0.2352941176 2@2=0.01470588235 3@1=0.4705882353 3@2=0.02941176471
EVALXYZ xyz_on_diagonal CROSS bent SQUARE P 0.4 0.4 0.6 EXPECT 0@0=0.01275510204 0@1=0.612244898 2@0=0.007653061224 2@1=0.3673469388
EVALXYZ xyz_near_raised CROSS bent SQUARE P 0.85 0.85 0.75 EXPECT 0@0=0.0025 0@1=0.06 2@0=0.0375 2@1=0.9
EVALXYZ xyz_outside_floor ANALYTIC three SQUARE P 0.05 0.5 0.5 EXPECT OUTSIDE
EVALXYZ xyz_top_by_rounding ANALYTIC three SQUARE P 0.108 0.124 1 EXPECT 0@2=0.97 2@2=0.01 3@2=0.02
EVALXYZ xyz_above ANALYTIC bent SQUARE P 0.85 0.85 1.2 EXPECT OUTSIDE

# CONTINUITY: sweeping across the square's diagonal -- from one
# triangle into the other -- while rising through the bent
# middle level. No step may jump: the runner bounds the change
# in every weight between neighbouring steps.
CONT sweep_diagonal CROSS bent SQUARE FROM 0.3 0.6 0.1 TO 0.7 0.4 0.95 STEPS 200 MAXSTEP 0.0120131784
CONT sweep_under_bend CROSS bent SQUARE FROM 0.2 0.2 0.45 TO 0.85 0.85 0.45 STEPS 200 MAXSTEP 0.007676115271

#--------------------------------------------------------------------
# NODES ADDED AND REMOVED. A new node needs nothing: on every
# level it sits at that level's start. Removing node 1 of four
# renumbers 2 and 3; the bend on old node 2 must follow it to
# its new id, 1.
#--------------------------------------------------------------------
NEWNODE newnode_bases ANALYTIC bent NODE 4 HEIGHTS 0,0.5,1
REMAP3 remap_follows_bend ANALYTIC bent TABLE 0 -1 1 2 L0 0,0,0 L1 0.5,0.8,0.5 L2 1,1,1
