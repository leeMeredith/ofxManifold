# and points genuinely OUTSIDE a non-convex region -- in the
# L's notch and between the star's arms -- must stay outside.
# A containment test that just said yes would pass everything
# above and fail here.
CONTAINS lshape_notch_outside ANALYTIC POLY 0.1,0.1 0.9,0.1 0.9,0.4 0.4,0.4 0.4,0.9 0.1,0.9 AT 0.7 0.7 INSIDE 0 NEGATIVE 0 EXPECT
CONTAINS star_between_arms_outside ANALYTIC POLY 0.5,0.95 0.4588550323,0.5566311896 0.07202456767,0.6390576475 0.4334260439,0.4783688104 0.2354966365,0.1359423525 0.5,0.43 0.7645033635,0.1359423525 0.5665739561,0.4783688104 0.9279754323,0.6390576475 0.5411449677,0.5566311896 AT 0.3236644243 0.7427050983 INSIDE 0 NEGATIVE 0 EXPECT

#--------------------------------------------------------------------
# NEGATIVE WEIGHTS, MEASURED RATHER THAN DESCRIBED
#
# MVC over a non-convex region produces negative weights at
# some interior points. That is the algorithm working, not a
# fault: Floater and Hormann's paper is titled 'Mean value
# coordinates for arbitrary planar polygons'.
#
# An earlier draft of the plan proposed refusing non-convex
# regions on these grounds. Sweeping the interiors is what
# showed that wrong -- a moderate star never goes negative at
# all, and where negatives do appear they are tiny.
#--------------------------------------------------------------------

# quad: 0 of 5976 interior samples negative, worst +0.000181
NEGSWEEP neg_quad ANALYTIC POLY 0.15,0.15 0.85,0.2 0.8,0.85 0.2,0.8 ANYNEGATIVE 0
# pentagon: 0 of 4382 interior samples negative, worst +0.000003
NEGSWEEP neg_pentagon ANALYTIC POLY 0.5,0.86 0.1576196541,0.611246118 0.2883973092,0.208753882 0.7116026908,0.208753882 0.8423803459,0.611246118 ANYNEGATIVE 0
# star: 0 of 3560 interior samples negative, worst +0.000001
NEGSWEEP neg_star ANALYTIC POLY 0.5,0.95 0.3883208021,0.6537132289 0.07202456767,0.6390576475 0.3192992619,0.4412867711 0.2354966365,0.1359423525 0.5,0.31 0.7645033635,0.1359423525 0.6807007381,0.4412867711 0.9279754323,0.6390576475 0.6116791979,0.6537132289 ANYNEGATIVE 0
# deepstar: 772 of 1312 interior samples negative, worst -0.000416
NEGSWEEP neg_deepstar ANALYTIC POLY 0.5,0.95 0.4588550323,0.5566311896 0.07202456767,0.6390576475 0.4334260439,0.4783688104 0.2354966365,0.1359423525 0.5,0.43 0.7645033635,0.1359423525 0.5665739561,0.4783688104 0.9279754323,0.6390576475 0.5411449677,0.5566311896 ANYNEGATIVE 1
# lshape: 3536 of 5616 interior samples negative, worst -0.012706
NEGSWEEP neg_lshape ANALYTIC POLY 0.1,0.1 0.9,0.1 0.9,0.4 0.4,0.4 0.4,0.9 0.1,0.9 ANYNEGATIVE 1

# Construction. Only genuinely ill-defined rings are refused.
# A star and an L-shape are legitimate control surfaces.
CONSTRUCT construct_triangle ANALYTIC POLY 0.2,0.2 0.8,0.25 0.45,0.85 VALID 1 REASON none
CONSTRUCT construct_quad ANALYTIC POLY 0.15,0.15 0.85,0.2 0.8,0.85 0.2,0.8 VALID 1 REASON none
CONSTRUCT construct_pentagon ANALYTIC POLY 0.5,0.86 0.1576196541,0.611246118 0.2883973092,0.208753882 0.7116026908,0.208753882 0.8423803459,0.611246118 VALID 1 REASON none
# star: non-convex and ACCEPTED
CONSTRUCT construct_star ANALYTIC POLY 0.5,0.95 0.3883208021,0.6537132289 0.07202456767,0.6390576475 0.3192992619,0.4412867711 0.2354966365,0.1359423525 0.5,0.31 0.7645033635,0.1359423525 0.6807007381,0.4412867711 0.9279754323,0.6390576475 0.6116791979,0.6537132289 VALID 1 REASON none
# lshape: one reflex vertex, ACCEPTED
CONSTRUCT construct_lshape ANALYTIC POLY 0.1,0.1 0.9,0.1 0.9,0.4 0.4,0.4 0.4,0.9 0.1,0.9 VALID 1 REASON none
# bowtie: self-intersecting, and its lobes cancel to zero signed area -- so the ORDER of the checks decides which reason is reported
CONSTRUCT construct_bowtie ANALYTIC POLY 0.2,0.2 0.8,0.8 0.8,0.2 0.2,0.8 VALID 0 REASON self-intersecting
# bowtie_uneven: self-intersecting, |signed area| 0.6655 -- an area test would ACCEPT this, so it is the only vector that proves the self-intersection check runs at all
CONSTRUCT construct_bowtie_uneven ANALYTIC POLY 0.43,0.93 0.94,0.1 0.92,0.14 0.11,0.08 VALID 0 REASON self-intersecting
# collinear: zero area
CONSTRUCT construct_collinear ANALYTIC POLY 0.1,0.1 0.4,0.4 0.7,0.7 VALID 0 REASON degenerate
# twopoint: fewer than three nodes
CONSTRUCT construct_twopoint ANALYTIC POLY 0.1,0.1 0.9,0.9 VALID 0 REASON fewer_than_three_nodes

# Convexity is INFORMATION in the topology report, beside
# orphans and duplicates -- never a reason to refuse.
CONVEX convex_triangle ANALYTIC POLY 0.2,0.2 0.8,0.25 0.45,0.85 IS 1
CONVEX convex_quad ANALYTIC POLY 0.15,0.15 0.85,0.2 0.8,0.85 0.2,0.8 IS 1
CONVEX convex_pentagon ANALYTIC POLY 0.5,0.86 0.1576196541,0.611246118 0.2883973092,0.208753882 0.7116026908,0.208753882 0.8423803459,0.611246118 IS 1
CONVEX convex_star ANALYTIC POLY 0.5,0.95 0.3883208021,0.6537132289 0.07202456767,0.6390576475 0.3192992619,0.4412867711 0.2354966365,0.1359423525 0.5,0.31 0.7645033635,0.1359423525 0.6807007381,0.4412867711 0.9279754323,0.6390576475 0.6116791979,0.6537132289 IS 0
CONVEX convex_lshape ANALYTIC POLY 0.1,0.1 0.9,0.1 0.9,0.4 0.4,0.4 0.4,0.9 0.1,0.9 IS 0
