# ofxManifold mapping layer conformance vectors
# GENERATED by tests/ref/reference_mapping.py -- do not hand edit
#
# The reference inverts the C++'s loop: it indexes
# target -> contributions and pulls, where the C++ iterates
# nodes and pushes. Node and target IDs are deliberately not
# contiguous from zero in several fixtures (D-004).

TOL 1e-06

# three nodes, three targets, one to one
MAPPING terminal
TARGET out.1
TARGET out.2
TARGET out.3
BIND 0 out.1 1
BIND 1 out.2 1
BIND 2 out.3 1
# one node, one target, weight 1.0: the weight passes through
RESOLVE identity_even ANALYTIC IN 0=0.3333333333 1=0.3333333333 2=0.3333333333 OUT out.1=0.3333333333 out.2=0.3333333333 out.3=0.3333333333
RESOLVE identity_uneven ANALYTIC IN 0=0.2 1=0.5 2=0.3 OUT out.1=0.2 out.2=0.5 out.3=0.3
# with every node bound to exactly one target and nothing null, the total is preserved
TARGETSUM sum_preserved ANALYTIC IN 0=0.2 1=0.5 2=0.3 SUM 1
# dense output has one slot per target, in TargetID order
DENSE dense_arity ANALYTIC IN 0=0.2 1=0.5 2=0.3 OUT 0.2 0.5 0.3
END

# node 2 bound to nothing -- MIAP's silent node
MAPPING null_node
TARGET out.1
TARGET out.2
BIND 0 out.1 1
BIND 1 out.2 1
# node 2 is bound to nothing. Its 0.2 is discarded, not redistributed
RESOLVE null_discards ANALYTIC IN 0=0.4 1=0.4 2=0.2 OUT out.1=0.4 out.2=0.4
# the total resolves to 0.8, NOT 1.0. That shortfall IS the fade a null node exists to produce, and correcting it would defeat the purpose
TARGETSUM sum_falls_short ANALYTIC IN 0=0.4 1=0.4 2=0.2 SUM 0.8
# all the weight on the null node: silence, and no error
TARGETSUM sum_at_null_extreme ANALYTIC IN 2=1 SUM 0
# and the sparse result is empty rather than a zero-filled vector
RESOLVE null_extreme_empty ANALYTIC IN 2=1 OUT 
END

# node 0 is composite over four corners -- MIAP's virtual node, added because not every rig has an overhead speaker
MAPPING composite
TARGET corner.NW
TARGET corner.NE
TARGET corner.SW
TARGET corner.SE
TARGET out.direct
BIND 0 corner.NW 1
BIND 0 corner.NE 1
BIND 0 corner.SW 1
BIND 0 corner.SE 1
BIND 1 out.direct 1
# node 0 feeds four corners equally: 0.2 each, and the node's total contribution is unchanged by how many targets it feeds
RESOLVE composite_splits_evenly ANALYTIC IN 0=0.8 1=0.2 OUT corner.NW=0.2 corner.NE=0.2 corner.SW=0.2 corner.SE=0.2 out.direct=0.2
TARGETSUM composite_preserves_total ANALYTIC IN 0=0.8 1=0.2 SUM 1
RESOLVE composite_alone ANALYTIC IN 0=1 OUT corner.NW=0.25 corner.NE=0.25 corner.SW=0.25 corner.SE=0.25
END

# unequal link weights on a composite node
MAPPING weighted_links
TARGET near
TARGET far
TARGET other
BIND 0 near 3
BIND 0 far 1
BIND 1 other 1
# link weights 3 and 1 normalize to 0.75 and 0.25 WITHIN the node, so the node still contributes 0.8 in total. Normalizing within the node rather than globally is our rule
RESOLVE links_normalize_within_node SPEC IN 0=0.8 1=0.2 OUT near=0.6 far=0.2 other=0.2
TARGETSUM weighted_links_preserve_total SPEC IN 0=0.8 1=0.2 SUM 1
END

# two nodes bound to the same target
MAPPING many_to_one
TARGET shared
TARGET solo
BIND 0 shared 1
BIND 1 shared 1
BIND 2 solo 1
# nodes 0 and 1 both feed 'shared', which receives 0.7. MIAP states this directly: the map is not a projection of real space, so two adjacent nodes may be the same output
RESOLVE many_to_one_accumulates ANALYTIC IN 0=0.3 1=0.4 2=0.3 OUT shared=0.7 solo=0.3
TARGETSUM many_to_one_total ANALYTIC IN 0=0.3 1=0.4 2=0.3 SUM 1
END

# the same node bound to the same target twice
MAPPING duplicate_bind
TARGET out.1
TARGET out.2
BIND 0 out.1 0.5
BIND 0 out.1 0.5
BIND 0 out.2 1
# out.1 was bound twice at 0.5, totalling 1.0, so the node splits evenly with out.2. Replacing instead of accumulating would give one third and two thirds. A caller assembling bindings from two sources must not silently lose one
RESOLVE duplicate_bind_accumulates SPEC IN 0=1 OUT out.1=0.5 out.2=0.5
END

# non-contiguous node IDs, bindings created out of order
MAPPING sparse_ids
TARGET alpha
TARGET beta
TARGET gamma
BIND 11 alpha 1
BIND 4 beta 1
BIND 7 gamma 1
BIND 7 alpha 1
# node IDs 4, 7 and 11 with targets bound out of creation order. An implementation that reindexed either side would pass with contiguous IDs and fails here
RESOLVE sparse_node_ids CROSS IN 4=0.25 7=0.5 11=0.25 OUT alpha=0.5 beta=0.25 gamma=0.25
# dense order follows TargetID, which follows creation order: alpha, beta, gamma
DENSE sparse_dense_order CROSS IN 4=0.25 7=0.5 11=0.25 OUT 0.5 0.25 0.25
# only node 7 active: it is composite over gamma and alpha
RESOLVE sparse_partial CROSS IN 7=1 OUT alpha=0.5 gamma=0.5
END

# a declared target with no bindings
MAPPING unbound_target
TARGET out.1
TARGET out.unused
TARGET out.2
BIND 0 out.1 1
BIND 1 out.2 1
# 'out.unused' has no bindings but still occupies slot 1 of the dense vector. Arity is a property of the mapping, not of the point -- otherwise an OSC receiver reading argument 3 would be reading a different output from one frame to the next
DENSE unbound_target_is_zero ANALYTIC IN 0=0.6 1=0.4 OUT 0.6 0 0.4
# the sparse result omits it, matching the convention evaluate() uses outside the hull
RESOLVE unbound_absent_from_sparse SPEC IN 0=0.6 1=0.4 OUT out.1=0.6 out.2=0.4
END

# aggregators are SpaceMap's derived nodes -- they run the routing backwards and are not part of any region
MAPPING aggregators
TARGET out.1
TARGET out.2
TARGET out.3
TARGET out.4
BIND 0 out.1 1
BIND 1 out.2 1
BIND 2 out.3 1
BIND 3 out.4 1
AGGREGATOR sub.house linear 0 1
AGGREGATOR sub.power power 0 1
AGGREGATOR sub.all linear 0 1 2 3
# linear: 0.3 + 0.4 = 0.7. Power: sqrt(0.09 + 0.16) = 0.5. The third watches every node and must total 1.0
AGGREGATE aggregate_linear ANALYTIC IN 0=0.3 1=0.4 2=0.2 3=0.1 OUT 0.7 0.5 1
# a source node absent from the weight vector contributes zero rather than being an error
AGGREGATE aggregate_absent_source CROSS IN 0=1 OUT 1 1 1
# empty weight vector: every aggregate is zero, and the power mode does not take the root of a negative
AGGREGATE aggregate_empty_input ANALYTIC IN  OUT 0 0 0
END
