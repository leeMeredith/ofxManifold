# ofxManifold outputs conformance vectors
# GENERATED by tests/ref/reference_outputs.py -- do not hand edit
#
# Resolution here is computed per DESTINATION, and silence
# directly rather than as 1 - routed. The C++ accumulates per
# node. The two only agree if silence really is the complement
# of routing.

TOL 1e-06

MAP legacy
TARGET out.1
TARGET out.2
TARGET out.3
TARGET out.sub
BIND 0 OUTPUT out.1 1
BIND 1 OUTPUT out.2 1
BIND 2 OUTPUT out.1 1
BIND 2 OUTPUT out.2 1
BIND 2 OUTPUT out.3 1
BIND 3 OUTPUT out.sub 3
BIND 3 OUTPUT out.3 1
ENDMAP

# A mapping using none of the new features. Outputs made the
# old way get channel = their id, so the new by-channel vector
# must EQUAL the existing toDenseVector(). The 35 vectors in
# mapping.vec prove the old behaviour; these prove the new
# view of it is the same thing.
LEGACY legacy_equal_0 ANALYTIC MAP legacy IN 0=0.5 1=0.3 2=0.2 DENSE 0.5666666667 0.3666666667 0.06666666667 0
LEGACY legacy_equal_1 ANALYTIC MAP legacy IN 2=0.6 3=0.4 DENSE 0.2 0.2 0.3 0.3
LEGACY legacy_equal_2 ANALYTIC MAP legacy IN 0=0.2 4=0.8 DENSE 0.2 0 0 0

MAP fade
OUT out.1 0 1
OUT out.2 1 1
BIND 0 OUTPUT out.1 0.7
BIND 0 SILENCE 0.3
BIND 1 OUTPUT out.2 1
BIND 2 SILENCE 1
BIND 3 OUTPUT out.1 1
BIND 3 OUTPUT out.2 1
BIND 3 SILENCE 2
ENDMAP

# PARTIAL FADE: node 0 bound 0.7 to out.1 and 0.3 to silence.
# Its whole weight arriving gives exactly 0.7 on out.1 and 0.3
# silent -- MIAP's virtual-to-silent link, which ofxManifold
# could not express before.
RESOLVE silence_partial_fade ANALYTIC MAP fade IN 0=1 ROUTED 0.7 0 SILENCE 0.3 LEVELS 0.7 0
# a genuinely UNBOUND node -- no links at all -- in the input.
# Its whole share is silence. Until this existed no resolution
# contained one, and silenceShare() could forget null nodes
# entirely with every vector still green.
RESOLVE silence_counts_null_nodes ANALYTIC MAP fade IN 0=0.5 4=0.5 ROUTED 0.35 0 SILENCE 0.65 LEVELS 0.35 0
# silence alone behaves exactly as a null node
RESOLVE silence_alone_is_null ANALYTIC MAP fade IN 2=1 ROUTED 0 0 SILENCE 1 LEVELS 0 0
# composite bound to two outputs at 1 each and silence at 2:
# a quarter to each output, half silent
RESOLVE silence_composite_half ANALYTIC MAP fade IN 3=1 ROUTED 0.25 0.25 SILENCE 0.5 LEVELS 0.25 0.25
# a mixed weight vector: routed plus silence totals exactly 1
RESOLVE silence_mixed_0 CROSS MAP fade IN 0=0.4 1=0.35 3=0.25 ROUTED 0.3425 0.4125 SILENCE 0.245 LEVELS 0.3425 0.4125
RESOLVE silence_mixed_1 CROSS MAP fade IN 0=0.1 2=0.6 3=0.3 ROUTED 0.145 0.075 SILENCE 0.78 LEVELS 0.145 0.075
RESOLVE silence_mixed_2 CROSS MAP fade IN 1=0.5 2=0.5 ROUTED 0 0.5 SILENCE 0.5 LEVELS 0 0.5

MAP rig
OUT L 1 1
OUT R 2 0.8
OUT C 5 0.5
BIND 0 OUTPUT L 1
BIND 1 OUTPUT R 1
BIND 2 OUTPUT C 1
BIND 3 OUTPUT L 1
BIND 3 OUTPUT R 1
DERIVED sub 7 0.9 linear SRC 0:3 1:1
DERIVED front 8 1 power SRC 0:1 1:1
ENDMAP

# channels 1, 2, 5, 7, 8: the vector is indexed by channel
# EXACTLY, length highest + 1, zeros at 0, 3, 4 and 6
RESOLVE channels_with_gaps ANALYTIC MAP rig IN 0=0.5 1=0.3 2=0.2 ROUTED 0 0.5 0.3 0 0 0.2 0 1.8 0.5830951895 SILENCE 0 LEVELS 0 0.5 0.24 0 0 0.1 0 1.62 0.5830951895
# TRIM changes levels and NEVER routed share: R is trimmed to
# 0.8 and C to 0.5, and their routed values are untouched
RESOLVE trim_levels_only ANALYTIC MAP rig IN 1=0.6 2=0.4 ROUTED 0 0 0.6 0 0 0.4 0 0.6 0.6 SILENCE 0 LEVELS 0 0 0.48 0 0 0.2 0 0.54 0.6
# DERIVED with weighted sources, at its channel: a sub fed three
# parts from node 0 to one part from node 1 -- source weights are
# gains, as MIAP's derived links are
RESOLVE derived_weighted ANALYTIC MAP rig IN 0=0.6 1=0.4 ROUTED 0 0.6 0.4 0 0 0 0 2.2 0.7211102551 SILENCE 0 LEVELS 0 0.6 0.32 0 0 0 0 1.98 0.7211102551
# power-mode derived: source weight on amplitude, powers summed
RESOLVE derived_power SPEC MAP rig IN 0=0.8 1=0.6 ROUTED 0 0.8 0.6 0 0 0 0 3 1 SILENCE 0 LEVELS 0 0.8 0.48 0 0 0 0 2.7 1
RESOLVE rig_mixed_0 CROSS MAP rig IN 0=0.25 1=0.25 2=0.25 3=0.25 ROUTED 0 0.375 0.375 0 0 0.25 0 1 0.3535533906 SILENCE 0 LEVELS 0 0.375 0.3 0 0 0.125 0 0.9 0.3535533906
RESOLVE rig_mixed_1 CROSS MAP rig IN 3=0.7 2=0.3 ROUTED 0 0.35 0.35 0 0 0.3 0 0 0 SILENCE 0 LEVELS 0 0.35 0.28 0 0 0.15 0 0 0

# A CHANNEL may be used once, across outputs and derived alike.
# Two outputs on one channel would make the vector ambiguous --
# the kernel accepting a state a consumer trips over, which is
# the D-018/019/020 pattern
REFUSE refuse_duplicate_channel ANALYTIC OUTPUT a 3 OUTPUT b 3
REFUSE refuse_channel_taken_by_derived ANALYTIC DERIVEDFIRST d 4 OUTPUT a 4
REFUSE refuse_duplicate_name ANALYTIC OUTPUT a 3 OUTPUT a 6
REFUSE refuse_negative_channel ANALYTIC OUTPUT a -1

# A node's type is COMPUTED from its bindings, never stored
# (decision F), and FRACTION is how much of its share reaches
# an output -- what the node's fill shows in the editor
LABEL label_fade_0 ANALYTIC MAP fade NODE 0 EXPECT partial FRACTION 0.7
LABEL label_fade_1 ANALYTIC MAP fade NODE 1 EXPECT terminal FRACTION 1
LABEL label_fade_2 ANALYTIC MAP fade NODE 2 EXPECT null FRACTION 0
LABEL label_fade_3 ANALYTIC MAP fade NODE 3 EXPECT partial FRACTION 0.5
LABEL label_fade_4 ANALYTIC MAP fade NODE 4 EXPECT null FRACTION 0
LABEL label_legacy_0 ANALYTIC MAP legacy NODE 0 EXPECT terminal FRACTION 1
LABEL label_legacy_1 ANALYTIC MAP legacy NODE 1 EXPECT terminal FRACTION 1
LABEL label_legacy_2 ANALYTIC MAP legacy NODE 2 EXPECT composite FRACTION 1
LABEL label_legacy_3 ANALYTIC MAP legacy NODE 3 EXPECT composite FRACTION 1
LABEL label_legacy_4 ANALYTIC MAP legacy NODE 4 EXPECT null FRACTION 0

#--------------------------------------------------------------------
# REMAPPING AFTER NODE REMOVAL (decision E)
#
# removeNodes() renumbers nodes (D-020). Bindings held by NodeID
# must follow, or deleting a node silently re-routes every
# binding after it to the wrong node. Checked as D-020 checked
# the geometry: the remapped mapping must resolve IDENTICALLY to
# one built fresh from the survivors.
#--------------------------------------------------------------------
REMAP remap_drop_first ANALYTIC MAP rig TABLE -1 0 1 2 3 4 IN 0=0.3333333333 1=0.3333333333 2=0.3333333333 ROUTED 0 0.1666666667 0.5 0 0 0.3333333333 0 0.3333333333 0.3333333333 SILENCE 0 LEVELS 0 0.1666666667 0.4 0 0 0.1666666667 0 0.3 0.3333333333
REMAP remap_drop_middle ANALYTIC MAP rig TABLE 0 1 -1 2 3 4 IN 0=0.3333333333 1=0.3333333333 2=0.3333333333 ROUTED 0 0.5 0.5 0 0 0 0 1.333333333 0.4714045208 SILENCE 0 LEVELS 0 0.5 0.4 0 0 0 0 1.2 0.4714045208
REMAP remap_drop_derived_source ANALYTIC MAP rig TABLE 0 -1 1 2 3 4 IN 0=0.3333333333 1=0.3333333333 2=0.3333333333 ROUTED 0 0.5 0.1666666667 0 0 0.3333333333 0 1 0.3333333333 SILENCE 0 LEVELS 0 0.5 0.1333333333 0 0 0.1666666667 0 0.9 0.3333333333
REMAP remap_drop_partial ANALYTIC MAP fade TABLE -1 0 1 2 3 4 IN 0=0.3333333333 1=0.3333333333 2=0.3333333333 ROUTED 0.08333333333 0.4166666667 SILENCE 0.5 LEVELS 0.08333333333 0.4166666667
REMAP remap_drop_nothing ANALYTIC MAP fade TABLE 0 1 2 3 4 5 IN 0=0.25 1=0.25 2=0.25 3=0.25 ROUTED 0.2375 0.3125 SILENCE 0.45 LEVELS 0.2375 0.3125

MAP reorder
TARGET L
TARGET R
TARGET spare
BIND 0 OUTPUT R 1
BIND 1 OUTPUT L 1
ENDMAP

#--------------------------------------------------------------------
# WHAT MUST SURVIVE SAVE AND RELOAD
#
# The version 1 file lists bindings only; outputs are recreated
# as bindings mention them. So an output bound to nothing was
# DROPPED, and outputs came back in the order bindings mention
# them rather than the order they were made. Measured on this
# mapping before any code changed: 'spare' vanished and L and R
# swapped indices -- an OSC receiver reading argument 1 as the
# right speaker got the left one after reopening the file.
#
# So version 1 is written ONLY when a version 1 reload would
# reproduce the mapping exactly. This one must become version 2,
# which lists outputs explicitly (D-022).
#--------------------------------------------------------------------
MAPPRESERVE preserve_order_and_unbound ANALYTIC MAP reorder MANIFOLD outputs_manifold.json VERSION 2

# ONE fault per fixture. The mapping above has both faults at
# once, so removing EITHER check left the other forcing version
# 2 -- each masked the other, and mutation testing removed each
# check with the suite still green. The bowtie lesson again:
# one case exercising two checks proves neither on its own.
MAP reorder_only
TARGET L
TARGET R
BIND 0 OUTPUT R 1
BIND 1 OUTPUT L 1
ENDMAP

# every output bound, but first mentioned out of order
MAPPRESERVE preserve_reorder_only ANALYTIC MAP reorder_only MANIFOLD outputs_manifold.json VERSION 2
MAP unbound_only
TARGET L
TARGET R
TARGET spare
BIND 0 OUTPUT L 1
BIND 1 OUTPUT R 1
ENDMAP

# in order, but one output bound to nothing
MAPPRESERVE preserve_unbound_only ANALYTIC MAP unbound_only MANIFOLD outputs_manifold.json VERSION 2
# the legacy mapping IS safe as version 1: every output bound,
# first mentioned in the order made -- so it stays version 1,
# byte-identical, and still round-trips exactly
MAPPRESERVE preserve_legacy ANALYTIC MAP legacy MANIFOLD outputs_manifold.json VERSION 1
MAPPRESERVE preserve_rig ANALYTIC MAP rig MANIFOLD outputs_manifold.json VERSION 2
MAPPRESERVE preserve_fade ANALYTIC MAP fade MANIFOLD outputs_manifold.json VERSION 2

# FILES. A version 2 mapping carries channels, trims, silence
# and weighted derived sources, and round-trips byte-stable.
MAPFILE file_v2_loads ANALYTIC outputs_manifold.json outputs_v2.json OK
MAPROUNDTRIP file_v2_roundtrip ANALYTIC outputs_manifold.json outputs_v2.json
# a mapping using NO new feature is written as version 1,
# byte-identical to before (decision G). Checked against every
# existing mapping fixture in the serialize suite as well.
MAPVERSION file_legacy_stays_v1 ANALYTIC outputs_manifold.json LEGACYMAP 1
MAPVERSION file_new_features_v2 ANALYTIC outputs_manifold.json outputs_v2.json 2
# refused, each for its OWN reason (D-007). 'layer' is refused
# as a kind until layers exist -- reserved, not accepted and
# ignored, which would silently drop a binding
MAPFILE bad_out_dup_channel ANALYTIC outputs_manifold.json bad_out_dup_channel.json REFUSE channel
MAPFILE bad_out_unknown_kind ANALYTIC outputs_manifold.json bad_out_unknown_kind.json REFUSE kind
MAPFILE bad_out_silence_with_target ANALYTIC outputs_manifold.json bad_out_silence_with_target.json REFUSE silence
MAPFILE bad_out_future_version ANALYTIC outputs_manifold.json bad_out_future_version.json REFUSE version
