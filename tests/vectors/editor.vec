DO cycle
EXPECT 0 0 "current output: out0"
STATE N n0@0.2,0.2 n1@0.8,0.2 | R  | O out0:0:1 out1:1:1 | L n0>out0:1 n0>out1:1 n0>~:0.105263 | D sum2:2:n0,n1 | C out0 | S out0 | A 0
DO trim -1
EXPECT 1 0 ""
STATE N n0@0.2,0.2 n1@0.8,0.2 | R  | O out0:0:0.891251 out1:1:1 | L n0>out0:1 n0>out1:1 n0>~:0.105263 | D sum2:2:n0,n1 | C out0 | S out0 | A 0
DO trim 20
EXPECT 1 0 ""
STATE N n0@0.2,0.2 n1@0.8,0.2 | R  | O out0:0:3.98107 out1:1:1 | L n0>out0:1 n0>out1:1 n0>~:0.105263 | D sum2:2:n0,n1 | C out0 | S out0 | A 0
DO pick out1
EXPECT 0 0 "current output: out1"
STATE N n0@0.2,0.2 n1@0.8,0.2 | R  | O out0:0:3.98107 out1:1:1 | L n0>out0:1 n0>out1:1 n0>~:0.105263 | D sum2:2:n0,n1 | C out1 | S out1 | A 0
DO pick nothing
EXPECT 0 0 ""
STATE N n0@0.2,0.2 n1@0.8,0.2 | R  | O out0:0:3.98107 out1:1:1 | L n0>out0:1 n0>out1:1 n0>~:0.105263 | D sum2:2:n0,n1 | C out1 | S out1 | A 0
DO removeoutput
EXPECT 1 1 "removed output out1 -- 1 node no longer reach it"
STATE N n0@0.2,0.2 n1@0.8,0.2 | R  | O out0:0:3.98107 | L n0>out0:1 n0>~:0.105263 | D sum2:2:n0,n1 | C out0 | S out0 | A 0
DO newoutput
EXPECT 1 0 "new output out1 on channel 1 -- select nodes and press b"
STATE N n0@0.2,0.2 n1@0.8,0.2 | R  | O out0:0:3.98107 out1:1:1 | L n0>out0:1 n0>~:0.105263 | D sum2:2:n0,n1 | C out1 | S out1 | A 0
ENDEDIT

