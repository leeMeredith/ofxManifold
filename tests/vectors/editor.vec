ENDEDIT

# outputs: new, derived, bind, silence, clear, cycle, trim, remove. Silence adds a QUARTER SHARE per press today; round 2 replaces it with 5% fill steps and changes this vector
EDIT outputs ANALYTIC
GRID FREE
DO auto
EXPECT 0 0 "auto-output off: new nodes start unbound"
STATE N  | R  | O  | L  | D  | C - | A 0
DO place 0.2 0.2
EXPECT 1 0 ""
STATE N n0@0.2,0.2 | R  | O  | L  | D  | C - | A 0
DO place 0.8 0.2
EXPECT 1 0 ""
STATE N n0@0.2,0.2 n1@0.8,0.2 | R  | O  | L  | D  | C - | A 0
SEL only n0
DO bind
EXPECT 0 1 "no output yet -- press o to make one"
STATE N n0@0.2,0.2 n1@0.8,0.2 | R  | O  | L  | D  | C - | A 0
DO newoutput
EXPECT 1 0 "new output out0 on channel 0 -- select nodes and press b"
STATE N n0@0.2,0.2 n1@0.8,0.2 | R  | O out0:0:1 | L  | D  | C out0 | A 0
DO bind
EXPECT 1 0 "bound 1 to out0"
STATE N n0@0.2,0.2 n1@0.8,0.2 | R  | O out0:0:1 | L n0>out0:1 | D  | C out0 | A 0
DO newoutput
EXPECT 1 0 "new output out1 on channel 1 -- select nodes and press b"
STATE N n0@0.2,0.2 n1@0.8,0.2 | R  | O out0:0:1 out1:1:1 | L n0>out0:1 | D  | C out1 | A 0
SEL only n0
SEL toggle n1
DO bind
EXPECT 1 0 "bound 2 to out1"
STATE N n0@0.2,0.2 n1@0.8,0.2 | R  | O out0:0:1 out1:1:1 | L n0>out0:1 n0>out1:1 n1>out1:1 | D  | C out1 | A 0
SEL only n0
DO silence
EXPECT 1 0 "added a silence share -- the fill drops"
STATE N n0@0.2,0.2 n1@0.8,0.2 | R  | O out0:0:1 out1:1:1 | L n0>out0:1 n0>out1:1 n0>~:0.25 n1>out1:1 | D  | C out1 | A 0
DO silence
EXPECT 1 0 "added a silence share -- the fill drops"
STATE N n0@0.2,0.2 n1@0.8,0.2 | R  | O out0:0:1 out1:1:1 | L n0>out0:1 n0>out1:1 n0>~:0.5 n1>out1:1 | D  | C out1 | A 0
SEL only n1
DO clear
EXPECT 1 0 "cleared bindings on 1"
STATE N n0@0.2,0.2 n1@0.8,0.2 | R  | O out0:0:1 out1:1:1 | L n0>out0:1 n0>out1:1 n0>~:0.5 | D  | C out1 | A 0
DO silence
EXPECT 1 0 "silence on a node with no output: still silent"
STATE N n0@0.2,0.2 n1@0.8,0.2 | R  | O out0:0:1 out1:1:1 | L n0>out0:1 n0>out1:1 n0>~:0.5 n1>~:0.25 | D  | C out1 | A 0
SEL clear
DO derived
EXPECT 0 1 "select the nodes a derived output should sum"
STATE N n0@0.2,0.2 n1@0.8,0.2 | R  | O out0:0:1 out1:1:1 | L n0>out0:1 n0>out1:1 n0>~:0.5 n1>~:0.25 | D  | C out1 | A 0
SEL only n0
SEL toggle n1
DO derived
EXPECT 1 0 "derived sum2 on channel 2, sum of 2"
STATE N n0@0.2,0.2 n1@0.8,0.2 | R  | O out0:0:1 out1:1:1 | L n0>out0:1 n0>out1:1 n0>~:0.5 n1>~:0.25 | D sum2:2:n0,n1 | C out1 | A 0
DO cycle
EXPECT 0 0 "current output: out0"
STATE N n0@0.2,0.2 n1@0.8,0.2 | R  | O out0:0:1 out1:1:1 | L n0>out0:1 n0>out1:1 n0>~:0.5 n1>~:0.25 | D sum2:2:n0,n1 | C out0 | A 0
DO trim -1
EXPECT 1 0 ""
STATE N n0@0.2,0.2 n1@0.8,0.2 | R  | O out0:0:0.891251 out1:1:1 | L n0>out0:1 n0>out1:1 n0>~:0.5 n1>~:0.25 | D sum2:2:n0,n1 | C out0 | A 0
DO trim 20
EXPECT 1 0 ""
STATE N n0@0.2,0.2 n1@0.8,0.2 | R  | O out0:0:3.98107 out1:1:1 | L n0>out0:1 n0>out1:1 n0>~:0.5 n1>~:0.25 | D sum2:2:n0,n1 | C out0 | A 0
DO removeoutput
EXPECT 1 1 "removed output out0 -- 1 node no longer reach it"
STATE N n0@0.2,0.2 n1@0.8,0.2 | R  | O out1:1:1 | L n0>out1:1 n0>~:0.5 n1>~:0.25 | D sum2:2:n0,n1 | C out1 | A 0
DO newoutput
EXPECT 1 0 "new output out0 on channel 0 -- select nodes and press b"
STATE N n0@0.2,0.2 n1@0.8,0.2 | R  | O out1:1:1 out0:0:1 | L n0>out1:1 n0>~:0.5 n1>~:0.25 | D sum2:2:n0,n1 | C out0 | A 0
ENDEDIT

# the example map, and its outputs, exactly
EDIT example ANALYTIC
GRID FREE
DO example
EXPECT 1 0 ""
STATE N O@0.3,0.5 N@0.3,0.8 E@0.5,0.5 S@0.3,0.2 W@0.1,0.5 A@0.65,0.35 B@0.9,0.35 C@0.9,0.65 D@0.65,0.65 | R O,N,E O,E,S O,S,W O,W,N A,B,C,D | O front:0:1 left:1:1 right:2:1 rear:3:1 | L O>front:1 O>left:1 O>right:1 O>rear:1 N>front:1 E>right:1 S>rear:1 W>left:1 B>right:1 B>~:1 C>left:1 C>right:1 D>rear:1 D>~:0.333333 | D sub:4:N,O | C front | A 1
SEL only B
DO silence
EXPECT 1 0 "added a silence share -- the fill drops"
STATE N O@0.3,0.5 N@0.3,0.8 E@0.5,0.5 S@0.3,0.2 W@0.1,0.5 A@0.65,0.35 B@0.9,0.35 C@0.9,0.65 D@0.65,0.65 | R O,N,E O,E,S O,S,W O,W,N A,B,C,D | O front:0:1 left:1:1 right:2:1 rear:3:1 | L O>front:1 O>left:1 O>right:1 O>rear:1 N>front:1 E>right:1 S>rear:1 W>left:1 B>right:1 B>~:1.25 C>left:1 C>right:1 D>rear:1 D>~:0.333333 | D sub:4:N,O | C front | A 1
DO empty
EXPECT 1 0 ""
STATE N  | R  | O  | L  | D  | C - | A 1
ENDEDIT

