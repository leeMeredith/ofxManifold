# on the free grid there is nothing to lay out on
EDIT layout_free ANALYTIC
GRID FREE
KEYS drag=0 aud=0 grid=free EXPECT place:1 box:0 toggle:0 all:0 none:0 move:0 freehand:0 join:0 unjoin:0 remove:0 gridkind:1 rotate:0 spacing:0 spokes:0 deadzone:0 layoutsize:0 layout:0 newoutput:1 pickoutput:0 addoutput:0 nextoutput:0 bind:0 bindall:0 fill:0 clear:0 silence:0 derivedafter:0 derived:0 trim:0 removeoutput:0 autooutput:1 levelswitch:0 newlevel:1 raise:0 movelevel:0 match:0 removelevel:0 view3d:1 newvalue:1 pickvalue:0 stepvalue:0 editvalue:0 removevalue:0 audition:1 lock:1 undo:0 redo:0 save:1 saveas:1 open:1 userig:1 saverig:0 empty:1 example:1 fullscreen:1 textsize:1 keysheet:1 BIND bind or unbind selected
DO layout 0.5 0.5 3 0
EXPECT 0 1 "pick a square, triangular or polar grid first (2, 3 or 4)"
STATE N  | R  | O  | L  | D  | C - | S - | A 1
ENDEDIT

#--------------------------------------------------------------------
# ROUND 3A-9: THE CURVES ON EVERY LEVEL
#
# A new level copies the links between nodes as a pattern: A to
# B's output is A to B-2 on level 2. A line is drawn to the node
# an output belongs to, so B-2's line lands on B.
#--------------------------------------------------------------------
# a new level keeps the links between nodes, pointed at the level's own outputs, weights kept; the curves are drawn on every level, to the node whose output it is
EDIT curves_on_levels ANALYTIC
GRID FREE
DO empty
EXPECT 1 0 ""
STATE N  | R  | O  | L  | D  | C - | S - | A 1
DO place 0.2 0.2
EXPECT 1 0 ""
STATE N n0@0.2,0.2 | R  | O n0:0:1 | L n0>n0:1 | D  | C n0 | S n0 | A 1
DO place 0.8 0.2
EXPECT 1 0 ""
STATE N n0@0.2,0.2 n1@0.8,0.2 | R  | O n0:0:1 n1:1:1 | L n0>n0:1 n1>n1:1 | D  | C n0 | S n0 | A 1
SEL only n0
DO pick n1
EXPECT 0 0 "current output: n1"
STATE N n0@0.2,0.2 n1@0.8,0.2 | R  | O n0:0:1 n1:1:1 | L n0>n0:1 n1>n1:1 | D  | C n1 | S n1 | A 1
DO bind
EXPECT 1 0 "bound 1 to n1"
STATE N n0@0.2,0.2 n1@0.8,0.2 | R  | O n0:0:1 n1:1:1 | L n0>n0:1 n0>n1:1 n1>n1:1 | D  | C n1 | S n1 | A 1
LINKS n0>n1:0.5:1:0:1:0.35,0.25625
# level 2: n0 sends to n0-2 and n1-2, as it sent to n0 and n1
DO newlevel 1
EXPECT 1 0 "new level 2 of 2, at 0.25, with 2 outputs of its own"
STATE N n0@0.2,0.2 n1@0.8,0.2 | R  | O n0:0:1 n1:1:1 n0-2:2:1 n1-2:3:1 | L n0>n0-2:1 n0>n1-2:1 n1>n1-2:1 | D  | C n1 | S n1 | A 1 | V 1 | Z0 0 K n0>n0:1 n0>n1:1 n1>n1:1 | Z1 0.25 K n0>n0-2:1 n0>n1-2:1 n1>n1-2:1
LINKS n0>n1:0.5:1:0:1:0.35,0.25625
# a node placed on level 2, bound on level 2 to n0-2: its line
# lands on n0; on level 1 it has none
DO place 0.5 0.8
EXPECT 1 0 ""
STATE N n0@0.2,0.2 n1@0.8,0.2 n2@0.5,0.8 | R  | O n0:0:1 n1:1:1 n0-2:2:1 n1-2:3:1 n2:4:1 n2-2:5:1 | L n0>n0-2:1 n0>n1-2:1 n1>n1-2:1 n2>n2-2:1 | D  | C n1 | S n1 | A 1 | V 1 | Z0 0 K n0>n0:1 n0>n1:1 n1>n1:1 n2>n2:1 | Z1 0.25 K n0>n0-2:1 n0>n1-2:1 n1>n1-2:1 n2>n2-2:1
SEL only n2
DO pick n0-2
EXPECT 0 0 "current output: n0-2"
STATE N n0@0.2,0.2 n1@0.8,0.2 n2@0.5,0.8 | R  | O n0:0:1 n1:1:1 n0-2:2:1 n1-2:3:1 n2:4:1 n2-2:5:1 | L n0>n0-2:1 n0>n1-2:1 n1>n1-2:1 n2>n2-2:1 | D  | C n0-2 | S n0-2 | A 1 | V 1 | Z0 0 K n0>n0:1 n0>n1:1 n1>n1:1 n2>n2:1 | Z1 0.25 K n0>n0-2:1 n0>n1-2:1 n1>n1-2:1 n2>n2-2:1
DO bind
EXPECT 1 0 "bound 1 to n0-2"
STATE N n0@0.2,0.2 n1@0.8,0.2 n2@0.5,0.8 | R  | O n0:0:1 n1:1:1 n0-2:2:1 n1-2:3:1 n2:4:1 n2-2:5:1 | L n0>n0-2:1 n0>n1-2:1 n1>n1-2:1 n2>n2-2:1 n2>n0-2:1 | D  | C n0-2 | S n0-2 | A 1 | V 1 | Z0 0 K n0>n0:1 n0>n1:1 n1>n1:1 n2>n2:1 | Z1 0.25 K n0>n0-2:1 n0>n1-2:1 n1>n1-2:1 n2>n2-2:1 n2>n0-2:1
LINKS n2>n0:0.5:1:0:1:0.36875,0.678125
SEL only n0
LINKS n0>n1:0.5:1:0:-1:0.35,0.14375 n2>n0:0.5:0:0:1:0.36875,0.678125
DO leveldown
EXPECT 0 0 "level 1 of 2, at 0"
STATE N n0@0.2,0.2 n1@0.8,0.2 n2@0.5,0.8 | R  | O n0:0:1 n1:1:1 n0-2:2:1 n1-2:3:1 n2:4:1 n2-2:5:1 | L n0>n0:1 n0>n1:1 n1>n1:1 n2>n2:1 | D  | C n0-2 | S n0-2 | A 1 | V 0 | Z0 0 K n0>n0:1 n0>n1:1 n1>n1:1 n2>n2:1 | Z1 0.25 K n0>n0-2:1 n0>n1-2:1 n1>n1-2:1 n2>n2-2:1 n2>n0-2:1
SEL only n2
LINKS NONE
ENDEDIT

#--------------------------------------------------------------------
# ROUND 3A-10: c GIVES A NODE BACK ITS OWN OUTPUT, C SILENCES IT
#
# c: every binding on this level gone but the node's own output,
# at full fill, as when placed -- made if it has none and
# auto-output is on. C: silent on purpose.
#--------------------------------------------------------------------
# c puts the selected nodes back to their own output on this level, fill 100%, links to other nodes dropped; C makes them silent; c brings a silent node back; on a level past the first its own output is P-2
EDIT own_output_and_silence ANALYTIC
GRID FREE
DO empty
EXPECT 1 0 ""
STATE N  | R  | O  | L  | D  | C - | S - | A 1
DO place 0.2 0.2
EXPECT 1 0 ""
STATE N n0@0.2,0.2 | R  | O n0:0:1 | L n0>n0:1 | D  | C n0 | S n0 | A 1
DO place 0.8 0.2
EXPECT 1 0 ""
STATE N n0@0.2,0.2 n1@0.8,0.2 | R  | O n0:0:1 n1:1:1 | L n0>n0:1 n1>n1:1 | D  | C n0 | S n0 | A 1
SEL only n0
DO pick n1
EXPECT 0 0 "current output: n1"
STATE N n0@0.2,0.2 n1@0.8,0.2 | R  | O n0:0:1 n1:1:1 | L n0>n0:1 n1>n1:1 | D  | C n1 | S n1 | A 1
DO bind
EXPECT 1 0 "bound 1 to n1"
STATE N n0@0.2,0.2 n1@0.8,0.2 | R  | O n0:0:1 n1:1:1 | L n0>n0:1 n0>n1:1 n1>n1:1 | D  | C n1 | S n1 | A 1
DO fill -1 0
EXPECT 1 0 "fill 95%"
STATE N n0@0.2,0.2 n1@0.8,0.2 | R  | O n0:0:1 n1:1:1 | L n0>n0:1 n0>n1:1 n0>~:0.105263 n1>n1:1 | D  | C n1 | S n1 | A 1
KEYS drag=0 aud=0 grid=lattice EXPECT place:1 box:1 toggle:1 all:1 none:1 move:1 freehand:0 join:0 unjoin:0 remove:1 gridkind:1 rotate:1 spacing:1 spokes:0 deadzone:1 layoutsize:1 layout:1 newoutput:1 pickoutput:1 addoutput:1 nextoutput:1 bind:1 bindall:1 fill:1 clear:1 silence:1 derivedafter:1 derived:1 trim:1 removeoutput:1 autooutput:1 levelswitch:0 newlevel:1 raise:1 movelevel:0 match:1 removelevel:0 view3d:1 newvalue:1 pickvalue:0 stepvalue:0 editvalue:0 removevalue:0 audition:1 lock:1 undo:1 redo:0 save:1 saveas:1 open:1 userig:1 saverig:1 empty:1 example:1 fullscreen:1 textsize:1 keysheet:1 BIND unbind 1 from n1
DO clear
EXPECT 1 0 "n0 back to its own output"
STATE N n0@0.2,0.2 n1@0.8,0.2 | R  | O n0:0:1 n1:1:1 | L n0>n0:1 n1>n1:1 | D  | C n1 | S n1 | A 1
DO silence
EXPECT 1 0 "n0 now silent -- c gives back its own output"
STATE N n0@0.2,0.2 n1@0.8,0.2 | R  | O n0:0:1 n1:1:1 | L n1>n1:1 | D  | C n1 | S n1 | A 1
KEYS drag=0 aud=0 grid=lattice EXPECT place:1 box:1 toggle:1 all:1 none:1 move:1 freehand:0 join:0 unjoin:0 remove:1 gridkind:1 rotate:1 spacing:1 spokes:0 deadzone:1 layoutsize:1 layout:1 newoutput:1 pickoutput:1 addoutput:1 nextoutput:1 bind:1 bindall:1 fill:0 clear:1 silence:0 derivedafter:1 derived:1 trim:1 removeoutput:1 autooutput:1 levelswitch:0 newlevel:1 raise:1 movelevel:0 match:1 removelevel:0 view3d:1 newvalue:1 pickvalue:0 stepvalue:0 editvalue:0 removevalue:0 audition:1 lock:1 undo:1 redo:0 save:1 saveas:1 open:1 userig:1 saverig:1 empty:1 example:1 fullscreen:1 textsize:1 keysheet:1 BIND bind 1 to n1
DO clear
EXPECT 1 0 "n0 back to its own output"
STATE N n0@0.2,0.2 n1@0.8,0.2 | R  | O n0:0:1 n1:1:1 | L n0>n0:1 n1>n1:1 | D  | C n1 | S n1 | A 1
# level 2: its own output there is n0-2
DO newlevel 1
EXPECT 1 0 "new level 2 of 2, at 0.25, with 2 outputs of its own"
STATE N n0@0.2,0.2 n1@0.8,0.2 | R  | O n0:0:1 n1:1:1 n0-2:2:1 n1-2:3:1 | L n0>n0-2:1 n1>n1-2:1 | D  | C n1 | S n1 | A 1 | V 1 | Z0 0 K n0>n0:1 n1>n1:1 | Z1 0.25 K n0>n0-2:1 n1>n1-2:1
DO silence
EXPECT 1 0 "n0 now silent -- c gives back its own output"
STATE N n0@0.2,0.2 n1@0.8,0.2 | R  | O n0:0:1 n1:1:1 n0-2:2:1 n1-2:3:1 | L n1>n1-2:1 | D  | C n1 | S n1 | A 1 | V 1 | Z0 0 K n0>n0:1 n1>n1:1 | Z1 0.25 K n1>n1-2:1
DO clear
EXPECT 1 0 "n0 back to its own output"
STATE N n0@0.2,0.2 n1@0.8,0.2 | R  | O n0:0:1 n1:1:1 n0-2:2:1 n1-2:3:1 | L n0>n0-2:1 n1>n1-2:1 | D  | C n1 | S n1 | A 1 | V 1 | Z0 0 K n0>n0:1 n1>n1:1 | Z1 0.25 K n0>n0-2:1 n1>n1-2:1
# its own output removed: c makes it again
DO pick n0-2
EXPECT 0 0 "current output: n0-2"
STATE N n0@0.2,0.2 n1@0.8,0.2 | R  | O n0:0:1 n1:1:1 n0-2:2:1 n1-2:3:1 | L n0>n0-2:1 n1>n1-2:1 | D  | C n0-2 | S n0-2 | A 1 | V 1 | Z0 0 K n0>n0:1 n1>n1:1 | Z1 0.25 K n0>n0-2:1 n1>n1-2:1
DO removeoutput
EXPECT 1 1 "removed output n0-2 -- 1 node no longer reach it"
STATE N n0@0.2,0.2 n1@0.8,0.2 | R  | O n0:0:1 n1:1:1 n1-2:3:1 | L n1>n1-2:1 | D  | C n0 | S n0 | A 1 | V 1 | Z0 0 K n0>n0:1 n1>n1:1 | Z1 0.25 K n1>n1-2:1
DO clear
EXPECT 1 0 "n0 back to its own output, 1 output made"
STATE N n0@0.2,0.2 n1@0.8,0.2 | R  | O n0:0:1 n1:1:1 n1-2:3:1 n0-2:2:1 | L n0>n0-2:1 n1>n1-2:1 | D  | C n0 | S n0 | A 1 | V 1 | Z0 0 K n0>n0:1 n1>n1:1 | Z1 0.25 K n0>n0-2:1 n1>n1-2:1
# auto-output off: c makes nothing; a node without one is named
DO pick n1-2
EXPECT 0 0 "current output: n1-2"
STATE N n0@0.2,0.2 n1@0.8,0.2 | R  | O n0:0:1 n1:1:1 n1-2:3:1 n0-2:2:1 | L n0>n0-2:1 n1>n1-2:1 | D  | C n1-2 | S n1-2 | A 1 | V 1 | Z0 0 K n0>n0:1 n1>n1:1 | Z1 0.25 K n0>n0-2:1 n1>n1-2:1
DO removeoutput
EXPECT 1 1 "removed output n1-2 -- 1 node no longer reach it"
STATE N n0@0.2,0.2 n1@0.8,0.2 | R  | O n0:0:1 n1:1:1 n0-2:2:1 | L n0>n0-2:1 | D  | C n0 | S n0 | A 1 | V 1 | Z0 0 K n0>n0:1 n1>n1:1 | Z1 0.25 K n0>n0-2:1
DO auto
EXPECT 0 0 "auto-output off: new nodes start unbound"
STATE N n0@0.2,0.2 n1@0.8,0.2 | R  | O n0:0:1 n1:1:1 n0-2:2:1 | L n0>n0-2:1 | D  | C n0 | S n0 | A 0 | V 1 | Z0 0 K n0>n0:1 n1>n1:1 | Z1 0.25 K n0>n0-2:1
SEL only n1
DO clear
EXPECT 0 1 "n1: no output of its own -- p turns auto-output on, or pick a fader and press b"
STATE N n0@0.2,0.2 n1@0.8,0.2 | R  | O n0:0:1 n1:1:1 n0-2:2:1 | L n0>n0-2:1 | D  | C n0 | S n0 | A 0 | V 1 | Z0 0 K n0>n0:1 n1>n1:1 | Z1 0.25 K n0>n0-2:1
SEL only n0
SEL toggle n1
DO silence
EXPECT 1 0 "2 nodes now silent -- c gives back its own output"
STATE N n0@0.2,0.2 n1@0.8,0.2 | R  | O n0:0:1 n1:1:1 n0-2:2:1 | L  | D  | C n0 | S n0 | A 0 | V 1 | Z0 0 K n0>n0:1 n1>n1:1 | Z1 0.25 K
DO clear
EXPECT 1 1 "n0 back to its own output -- n1 left: no output of its own, p turns auto-output on"
STATE N n0@0.2,0.2 n1@0.8,0.2 | R  | O n0:0:1 n1:1:1 n0-2:2:1 | L n0>n0-2:1 | D  | C n0 | S n0 | A 0 | V 1 | Z0 0 K n0>n0:1 n1>n1:1 | Z1 0.25 K n0>n0-2:1
# level 1 still has n1's own output
DO leveldown
EXPECT 0 0 "level 1 of 2, at 0"
STATE N n0@0.2,0.2 n1@0.8,0.2 | R  | O n0:0:1 n1:1:1 n0-2:2:1 | L n0>n0:1 n1>n1:1 | D  | C n0 | S n0 | A 0 | V 0 | Z0 0 K n0>n0:1 n1>n1:1 | Z1 0.25 K n0>n0-2:1
SEL only n1
DO silence
EXPECT 1 0 "n1 now silent -- c gives back its own output"
STATE N n0@0.2,0.2 n1@0.8,0.2 | R  | O n0:0:1 n1:1:1 n0-2:2:1 | L n0>n0:1 | D  | C n0 | S n0 | A 0 | V 0 | Z0 0 K n0>n0:1 | Z1 0.25 K n0>n0-2:1
DO clear
EXPECT 1 0 "n1 back to its own output"
STATE N n0@0.2,0.2 n1@0.8,0.2 | R  | O n0:0:1 n1:1:1 n0-2:2:1 | L n0>n0:1 n1>n1:1 | D  | C n0 | S n0 | A 0 | V 0 | Z0 0 K n0>n0:1 n1>n1:1 | Z1 0.25 K n0>n0-2:1
ENDEDIT

