# d makes a derived output from the PICKED FADERS, after their faders; D one from the selected NODES, before them, as d did. Three nodes, each its own output; pick n0 and shift-pick n1, press d; select n2, press D
EDIT derived_after_and_before ANALYTIC
GRID FREE
DO place 0.2 0.2
EXPECT 1 0 ""
STATE N n0@0.2,0.2 | R  | O n0:0:1 | L n0>n0:1 | D  | C n0 | S n0 | A 1
DO place 0.8 0.2
EXPECT 1 0 ""
STATE N n0@0.2,0.2 n1@0.8,0.2 | R  | O n0:0:1 n1:1:1 | L n0>n0:1 n1>n1:1 | D  | C n0 | S n0 | A 1
DO place 0.5 0.8
EXPECT 1 0 ""
STATE N n0@0.2,0.2 n1@0.8,0.2 n2@0.5,0.8 | R  | O n0:0:1 n1:1:1 n2:2:1 | L n0>n0:1 n1>n1:1 n2>n2:1 | D  | C n0 | S n0 | A 1
KEYS drag=0 aud=0 grid=lattice EXPECT place:1 box:1 toggle:1 all:1 none:0 move:1 freehand:0 join:0 unjoin:0 remove:0 gridkind:1 rotate:1 spacing:1 spokes:0 deadzone:1 layoutsize:1 layout:1 newoutput:1 pickoutput:1 addoutput:1 nextoutput:1 bind:0 bindall:0 fill:0 clear:0 silence:0 derivedafter:1 derived:0 trim:1 removeoutput:1 autooutput:1 levelswitch:0 newlevel:1 raise:0 movelevel:0 match:0 removelevel:0 view3d:1 newvalue:1 pickvalue:0 stepvalue:0 editvalue:0 removevalue:0 audition:1 lock:1 undo:1 redo:0 save:1 saveas:1 open:1 userig:1 saverig:1 empty:1 example:1 fullscreen:1 textsize:1 keysheet:1 BIND bind or unbind selected
DO pick n0
EXPECT 0 0 "current output: n0"
STATE N n0@0.2,0.2 n1@0.8,0.2 n2@0.5,0.8 | R  | O n0:0:1 n1:1:1 n2:2:1 | L n0>n0:1 n1>n1:1 n2>n2:1 | D  | C n0 | S n0 | A 1
DO toggleout n1
EXPECT 0 0 "outputs: n0, n1"
STATE N n0@0.2,0.2 n1@0.8,0.2 n2@0.5,0.8 | R  | O n0:0:1 n1:1:1 n2:2:1 | L n0>n0:1 n1>n1:1 n2>n2:1 | D  | C n1 | S n0,n1 | A 1
DO derivedafter
EXPECT 1 0 "derived sum3 on channel 3, after n0, n1"
STATE N n0@0.2,0.2 n1@0.8,0.2 n2@0.5,0.8 | R  | O n0:0:1 n1:1:1 n2:2:1 | L n0>n0:1 n1>n1:1 n2>n2:1 | D sum3:3:>n0,>n1 | C n1 | S n0,n1 | A 1
SEL only n2
DO derived
EXPECT 1 0 "derived sum4 on channel 4, sum of 1"
STATE N n0@0.2,0.2 n1@0.8,0.2 n2@0.5,0.8 | R  | O n0:0:1 n1:1:1 n2:2:1 | L n0>n0:1 n1>n1:1 n2>n2:1 | D sum3:3:>n0,>n1 sum4:4:n2 | C n1 | S n0,n1 | A 1
KEYS drag=0 aud=0 grid=lattice EXPECT place:1 box:1 toggle:1 all:1 none:1 move:1 freehand:0 join:0 unjoin:0 remove:1 gridkind:1 rotate:1 spacing:1 spokes:0 deadzone:1 layoutsize:1 layout:1 newoutput:1 pickoutput:1 addoutput:1 nextoutput:1 bind:1 bindall:1 fill:1 clear:1 silence:1 derivedafter:1 derived:1 trim:1 removeoutput:0 autooutput:1 levelswitch:0 newlevel:1 raise:1 movelevel:0 match:1 removelevel:0 view3d:1 newvalue:1 pickvalue:0 stepvalue:0 editvalue:0 removevalue:0 audition:1 lock:1 undo:1 redo:0 save:1 saveas:1 open:1 userig:1 saverig:1 empty:1 example:1 fullscreen:1 textsize:1 keysheet:1 BIND bind 1 to n0, n1
TAPS sum4
CONTRIB n0=0.5 n2=0.5 EXPECT 0 0 0.5 0 0
# n1 removed with its node: the after-fed sum loses that
# source and stays, reading n0 alone
SEL only n1
DO remove
EXPECT 1 0 "removed 1 node, and 1 output"
STATE N n0@0.2,0.2 n2@0.5,0.8 | R  | O n0:0:1 n2:2:1 | L n0>n0:1 n2>n2:1 | D sum3:3:>n0 sum4:4:n2 | C n0 | S n0 | A 1
SEL clear
DO undo
EXPECT 1 0 "undid delete"
STATE N n0@0.2,0.2 n1@0.8,0.2 n2@0.5,0.8 | R  | O n0:0:1 n1:1:1 n2:2:1 | L n0>n0:1 n1>n1:1 n2>n2:1 | D sum3:3:>n0,>n1 sum4:4:n2 | C n1 | S n0,n1 | A 1
DO undo
EXPECT 1 0 "undid derived output"
STATE N n0@0.2,0.2 n1@0.8,0.2 n2@0.5,0.8 | R  | O n0:0:1 n1:1:1 n2:2:1 | L n0>n0:1 n1>n1:1 n2>n2:1 | D sum3:3:>n0,>n1 | C n1 | S n0,n1 | A 1
ENDEDIT

# an empty map has no faders to follow: d is refused and says why; D with nothing selected likewise
EDIT derived_after_needs_an_output ANALYTIC
GRID FREE
DO empty
EXPECT 1 0 ""
STATE N  | R  | O  | L  | D  | C - | S - | A 1
KEYS drag=0 aud=0 grid=lattice EXPECT place:1 box:0 toggle:0 all:0 none:0 move:0 freehand:0 join:0 unjoin:0 remove:0 gridkind:1 rotate:1 spacing:1 spokes:0 deadzone:1 layoutsize:1 layout:1 newoutput:1 pickoutput:0 addoutput:0 nextoutput:0 bind:0 bindall:0 fill:0 clear:0 silence:0 derivedafter:0 derived:0 trim:0 removeoutput:0 autooutput:1 levelswitch:0 newlevel:1 raise:0 movelevel:0 match:0 removelevel:0 view3d:1 newvalue:1 pickvalue:0 stepvalue:0 editvalue:0 removevalue:0 audition:1 lock:1 undo:1 redo:0 save:1 saveas:1 open:1 userig:1 saverig:0 empty:1 example:1 fullscreen:1 textsize:1 keysheet:1 BIND bind or unbind selected
DO derivedafter
EXPECT 0 1 "no output yet -- press o to make one"
STATE N  | R  | O  | L  | D  | C - | S - | A 1
DO derived
EXPECT 0 1 "select the nodes a derived output should sum"
STATE N  | R  | O  | L  | D  | C - | S - | A 1
ENDEDIT

# save the outputs as a rig; make a second map with two of the speakers, placed differently, n0 trimmed differently; use the rig on it. Outputs, channels and trims come from the rig, in its order; bindings follow by name; the after-fed sum comes with the rig. One undo step
EDIT rig_save_and_use ANALYTIC
GRID FREE
DO place 0.2 0.2
EXPECT 1 0 ""
STATE N n0@0.2,0.2 | R  | O n0:0:1 | L n0>n0:1 | D  | C n0 | S n0 | A 1
DO place 0.8 0.2
EXPECT 1 0 ""
STATE N n0@0.2,0.2 n1@0.8,0.2 | R  | O n0:0:1 n1:1:1 | L n0>n0:1 n1>n1:1 | D  | C n0 | S n0 | A 1
DO place 0.5 0.8
EXPECT 1 0 ""
STATE N n0@0.2,0.2 n1@0.8,0.2 n2@0.5,0.8 | R  | O n0:0:1 n1:1:1 n2:2:1 | L n0>n0:1 n1>n1:1 n2>n2:1 | D  | C n0 | S n0 | A 1
DO pick n0
EXPECT 0 0 "current output: n0"
STATE N n0@0.2,0.2 n1@0.8,0.2 n2@0.5,0.8 | R  | O n0:0:1 n1:1:1 n2:2:1 | L n0>n0:1 n1>n1:1 n2>n2:1 | D  | C n0 | S n0 | A 1
DO toggleout n1
EXPECT 0 0 "outputs: n0, n1"
STATE N n0@0.2,0.2 n1@0.8,0.2 n2@0.5,0.8 | R  | O n0:0:1 n1:1:1 n2:2:1 | L n0>n0:1 n1>n1:1 n2>n2:1 | D  | C n1 | S n0,n1 | A 1
DO derivedafter
EXPECT 1 0 "derived sum3 on channel 3, after n0, n1"
STATE N n0@0.2,0.2 n1@0.8,0.2 n2@0.5,0.8 | R  | O n0:0:1 n1:1:1 n2:2:1 | L n0>n0:1 n1>n1:1 n2>n2:1 | D sum3:3:>n0,>n1 | C n1 | S n0,n1 | A 1
DO pick n1
EXPECT 0 0 "current output: n1"
STATE N n0@0.2,0.2 n1@0.8,0.2 n2@0.5,0.8 | R  | O n0:0:1 n1:1:1 n2:2:1 | L n0>n0:1 n1>n1:1 n2>n2:1 | D sum3:3:>n0,>n1 | C n1 | S n1 | A 1
DO trim -6
EXPECT 1 0 ""
STATE N n0@0.2,0.2 n1@0.8,0.2 n2@0.5,0.8 | R  | O n0:0:1 n1:1:0.501187 n2:2:1 | L n0>n0:1 n1>n1:1 n2>n2:1 | D sum3:3:>n0,>n1 | C n1 | S n1 | A 1
DO saverig room
EXPECT 0 0 "saved rig room-rig.json"
STATE N n0@0.2,0.2 n1@0.8,0.2 n2@0.5,0.8 | R  | O n0:0:1 n1:1:0.501187 n2:2:1 | L n0>n0:1 n1>n1:1 n2>n2:1 | D sum3:3:>n0,>n1 | C n1 | S n1 | A 1
DO saverig room-rig.json
EXPECT 0 0 "saved rig room-rig.json"
STATE N n0@0.2,0.2 n1@0.8,0.2 n2@0.5,0.8 | R  | O n0:0:1 n1:1:0.501187 n2:2:1 | L n0>n0:1 n1>n1:1 n2>n2:1 | D sum3:3:>n0,>n1 | C n1 | S n1 | A 1
DO empty
EXPECT 1 0 ""
STATE N  | R  | O  | L  | D  | C - | S - | A 1
DO place 0.5 0.8
EXPECT 1 0 ""
STATE N n0@0.5,0.8 | R  | O n0:0:1 | L n0>n0:1 | D  | C n0 | S n0 | A 1
DO place 0.2 0.2
EXPECT 1 0 ""
STATE N n0@0.5,0.8 n1@0.2,0.2 | R  | O n0:0:1 n1:1:1 | L n0>n0:1 n1>n1:1 | D  | C n0 | S n0 | A 1
DO pick n0
EXPECT 0 0 "current output: n0"
STATE N n0@0.5,0.8 n1@0.2,0.2 | R  | O n0:0:1 n1:1:1 | L n0>n0:1 n1>n1:1 | D  | C n0 | S n0 | A 1
DO trim -3
EXPECT 1 0 ""
STATE N n0@0.5,0.8 n1@0.2,0.2 | R  | O n0:0:0.707946 n1:1:1 | L n0>n0:1 n1>n1:1 | D  | C n0 | S n0 | A 1
DO toggleout n1
EXPECT 0 0 "outputs: n0, n1"
STATE N n0@0.5,0.8 n1@0.2,0.2 | R  | O n0:0:0.707946 n1:1:1 | L n0>n0:1 n1>n1:1 | D  | C n1 | S n0,n1 | A 1
# the rig brings n2 and the sum, n0's trim back to 0 dB, and
# n1's -6 dB; the bindings here stay as they are, and n1 --
# not the rig's first output -- stays the current one, with
# n0 still picked beside it
DO userig room
EXPECT 1 0 "using rig room: 3 outputs"
STATE N n0@0.5,0.8 n1@0.2,0.2 | R  | O n0:0:1 n1:1:0.501187 n2:2:1 | L n0>n0:1 n1>n1:1 | D sum3:3:>n0,>n1 | C n1 | S n0,n1 | A 1
