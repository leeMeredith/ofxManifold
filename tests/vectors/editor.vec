DO derivedafter
EXPECT 1 0 "derived sum2 on channel 2, after n0"
STATE N n0@0.2,0.2 n1@0.8,0.2 | R  | O n0:0:1 n1:1:1 | L n0>n0:1 n1>n1:1 | D sum2:2:>n0 | C n0 | S n0 | A 1
DO saverig kinds
EXPECT 0 0 "saved rig kinds-rig.json"
STATE N n0@0.2,0.2 n1@0.8,0.2 | R  | O n0:0:1 n1:1:1 | L n0>n0:1 n1>n1:1 | D sum2:2:>n0 | C n0 | S n0 | A 1
DO empty
EXPECT 1 0 ""
STATE N  | R  | O  | L  | D  | C - | S - | A 1
DO place 0.2 0.2
EXPECT 1 0 ""
STATE N n0@0.2,0.2 | R  | O n0:0:1 | L n0>n0:1 | D  | C n0 | S n0 | A 1
DO place 0.8 0.2
EXPECT 1 0 ""
STATE N n0@0.2,0.2 n1@0.8,0.2 | R  | O n0:0:1 n1:1:1 | L n0>n0:1 n1>n1:1 | D  | C n0 | S n0 | A 1
SEL only n0
DO derived
EXPECT 1 0 "derived sum2 on channel 2, sum of 1"
