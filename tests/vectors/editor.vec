# outputs: new, derived, bind, silence, clear, cycle, trim, remove. Round 2 replaced the quarter share of silence per press with fill steps, and this vector changed with it
EDIT outputs ANALYTIC
GRID FREE
DO auto
EXPECT 0 0 "auto-output off: new nodes start unbound"
STATE N  | R  | O  | L  | D  | C - | A 0
DO place 0.2 0.2
EXPECT 1 0 ""
STATE N n0@0.2,0.2 | R  | O  | L  | D  | C - | A 0
DO place 0.8 0.2
EXPECT 1 0 ""
STATE N n0@0.2,0.2 n1@0.8,0.2 | R  | O  | L  | D  | C - | A 0
SEL only n0
DO bind
EXPECT 0 1 "no output yet -- press o to make one"
STATE N n0@0.2,0.2 n1@0.8,0.2 | R  | O  | L  | D  | C - | A 0
DO newoutput
EXPECT 1 0 "new output out0 on channel 0 -- select nodes and press b"
STATE N n0@0.2,0.2 n1@0.8,0.2 | R  | O out0:0:1 | L  | D  | C out0 | A 0
DO bind
EXPECT 1 0 "bound 1 to out0"
STATE N n0@0.2,0.2 n1@0.8,0.2 | R  | O out0:0:1 | L n0>out0:1 | D  | C out0 | A 0
DO newoutput
EXPECT 1 0 "new output out1 on channel 1 -- select nodes and press b"
STATE N n0@0.2,0.2 n1@0.8,0.2 | R  | O out0:0:1 out1:1:1 | L n0>out0:1 | D  | C out1 | A 0
SEL only n0
SEL toggle n1
DO bind
EXPECT 1 0 "bound 2 to out1"
STATE N n0@0.2,0.2 n1@0.8,0.2 | R  | O out0:0:1 out1:1:1 | L n0>out0:1 n0>out1:1 n1>out1:1 | D  | C out1 | A 0
SEL only n0
DO fill -1 0
EXPECT 1 0 "fill 95%"
STATE N n0@0.2,0.2 n1@0.8,0.2 | R  | O out0:0:1 out1:1:1 | L n0>out0:1 n0>out1:1 n0>~:0.105263 n1>out1:1 | D  | C out1 | A 0
DO fill -1 0
EXPECT 1 0 "fill 90%"
STATE N n0@0.2,0.2 n1@0.8,0.2 | R  | O out0:0:1 out1:1:1 | L n0>out0:1 n0>out1:1 n0>~:0.222222 n1>out1:1 | D  | C out1 | A 0
DO fill -1 1
EXPECT 1 0 "fill 89%"
STATE N n0@0.2,0.2 n1@0.8,0.2 | R  | O out0:0:1 out1:1:1 | L n0>out0:1 n0>out1:1 n0>~:0.247191 n1>out1:1 | D  | C out1 | A 0
DO fill 1 1
EXPECT 1 0 "fill 90%"
STATE N n0@0.2,0.2 n1@0.8,0.2 | R  | O out0:0:1 out1:1:1 | L n0>out0:1 n0>out1:1 n0>~:0.222222 n1>out1:1 | D  | C out1 | A 0
DO fill 1 0
EXPECT 1 0 "fill 95%"
STATE N n0@0.2,0.2 n1@0.8,0.2 | R  | O out0:0:1 out1:1:1 | L n0>out0:1 n0>out1:1 n0>~:0.105263 n1>out1:1 | D  | C out1 | A 0
SEL only n1
DO clear
EXPECT 1 0 "cleared bindings on 1"
STATE N n0@0.2,0.2 n1@0.8,0.2 | R  | O out0:0:1 out1:1:1 | L n0>out0:1 n0>out1:1 n0>~:0.105263 | D  | C out1 | A 0
DO fill -1 0
EXPECT 0 1 "no output to fill -- bind the node first"
STATE N n0@0.2,0.2 n1@0.8,0.2 | R  | O out0:0:1 out1:1:1 | L n0>out0:1 n0>out1:1 n0>~:0.105263 | D  | C out1 | A 0
SEL clear
DO derived
EXPECT 0 1 "select the nodes a derived output should sum"
STATE N n0@0.2,0.2 n1@0.8,0.2 | R  | O out0:0:1 out1:1:1 | L n0>out0:1 n0>out1:1 n0>~:0.105263 | D  | C out1 | A 0
SEL only n0
SEL toggle n1
DO derived
EXPECT 1 0 "derived sum2 on channel 2, sum of 2"
STATE N n0@0.2,0.2 n1@0.8,0.2 | R  | O out0:0:1 out1:1:1 | L n0>out0:1 n0>out1:1 n0>~:0.105263 | D sum2:2:n0,n1 | C out1 | A 0
DO cycle
EXPECT 0 0 "current output: out0"
STATE N n0@0.2,0.2 n1@0.8,0.2 | R  | O out0:0:1 out1:1:1 | L n0>out0:1 n0>out1:1 n0>~:0.105263 | D sum2:2:n0,n1 | C out0 | A 0
DO trim -1
EXPECT 1 0 ""
STATE N n0@0.2,0.2 n1@0.8,0.2 | R  | O out0:0:0.891251 out1:1:1 | L n0>out0:1 n0>out1:1 n0>~:0.105263 | D sum2:2:n0,n1 | C out0 | A 0
DO trim 20
EXPECT 1 0 ""
STATE N n0@0.2,0.2 n1@0.8,0.2 | R  | O out0:0:3.98107 out1:1:1 | L n0>out0:1 n0>out1:1 n0>~:0.105263 | D sum2:2:n0,n1 | C out0 | A 0
DO pick out1
EXPECT 0 0 "current output: out1"
STATE N n0@0.2,0.2 n1@0.8,0.2 | R  | O out0:0:3.98107 out1:1:1 | L n0>out0:1 n0>out1:1 n0>~:0.105263 | D sum2:2:n0,n1 | C out1 | A 0
DO pick nothing
EXPECT 0 0 ""
STATE N n0@0.2,0.2 n1@0.8,0.2 | R  | O out0:0:3.98107 out1:1:1 | L n0>out0:1 n0>out1:1 n0>~:0.105263 | D sum2:2:n0,n1 | C out1 | A 0
DO removeoutput
EXPECT 1 1 "removed output out1 -- 1 node no longer reach it"
STATE N n0@0.2,0.2 n1@0.8,0.2 | R  | O out0:0:3.98107 | L n0>out0:1 n0>~:0.105263 | D sum2:2:n0,n1 | C out0 | A 0
DO newoutput
EXPECT 1 0 "new output out1 on channel 1 -- select nodes and press b"
STATE N n0@0.2,0.2 n1@0.8,0.2 | R  | O out0:0:3.98107 out1:1:1 | L n0>out0:1 n0>~:0.105263 | D sum2:2:n0,n1 | C out1 | A 0
ENDEDIT

