ENDEDIT

# with auto-output off a node starts unbound and no output appears
EDIT auto_output_off ANALYTIC
GRID FREE
DO auto
EXPECT 0 0 "auto-output off: new nodes start unbound"
STATE N  | R  | O  | L  | D  | C - | S - | A 0
DO place 0.3 0.3
EXPECT 1 0 ""
STATE N n0@0.3,0.3 | R  | O  | L  | D  | C - | S - | A 0
DO bind
EXPECT 0 1 "no output yet -- press o to make one"
STATE N n0@0.3,0.3 | R  | O  | L  | D  | C - | S - | A 0
DO auto
EXPECT 0 0 "auto-output on: each new node gets its own output"
STATE N n0@0.3,0.3 | R  | O  | L  | D  | C - | S - | A 1
DO place 0.6 0.3
EXPECT 1 0 ""
STATE N n0@0.3,0.3 n1@0.6,0.3 | R  | O n1:0:1 | L n1>n1:1 | D  | C n1 | S n1 | A 1
ENDEDIT

# joining: fewer than three refused; click order kept; a box joins in angle order; a set already joined is refused; a click order that crosses itself is refused WITH the reason
EDIT join_orders ANALYTIC
GRID FREE
DO place 0.2 0.2
EXPECT 1 0 ""
STATE N n0@0.2,0.2 | R  | O n0:0:1 | L n0>n0:1 | D  | C n0 | S n0 | A 1
DO place 0.8 0.2
EXPECT 1 0 ""
STATE N n0@0.2,0.2 n1@0.8,0.2 | R  | O n0:0:1 n1:1:1 | L n0>n0:1 n1>n1:1 | D  | C n0 | S n0 | A 1
DO place 0.8 0.8
EXPECT 1 0 ""
STATE N n0@0.2,0.2 n1@0.8,0.2 n2@0.8,0.8 | R  | O n0:0:1 n1:1:1 n2:2:1 | L n0>n0:1 n1>n1:1 n2>n2:1 | D  | C n0 | S n0 | A 1
DO place 0.2 0.8
EXPECT 1 0 ""
STATE N n0@0.2,0.2 n1@0.8,0.2 n2@0.8,0.8 n3@0.2,0.8 | R  | O n0:0:1 n1:1:1 n2:2:1 n3:3:1 | L n0>n0:1 n1>n1:1 n2>n2:1 n3>n3:1 | D  | C n0 | S n0 | A 1
