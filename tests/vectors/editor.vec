STATE N n0@0.2,0.866025 n1@0.15,0.779423 n2@0.25,0.779423 n3@0.5,0.866025 n4@0.45,0.779423 n5@0.55,0.779423 n6@0.5,0.69282 | R n0,n1,n2 n3,n4,n5 n4,n6,n5 | O n0:0:1 n1:1:1 n2:2:1 n3:3:1 n4:4:1 n5:5:1 n6:6:1 | L n0>n0:1 n1>n1:1 n2>n2:1 n3>n3:1 n4>n4:1 n5>n5:1 n6>n6:1 | D  | C n0 | S n0 | A 1
DO undo
EXPECT 1 0 "undid lay out"
STATE N n0@0.2,0.866025 n1@0.15,0.779423 n2@0.25,0.779423 | R n0,n1,n2 | O n0:0:1 n1:1:1 n2:2:1 | L n0>n0:1 n1>n1:1 n2>n2:1 | D  | C n0 | S n0 | A 1
DO undo
EXPECT 1 0 "undid lay out"
STATE N  | R  | O  | L  | D  | C - | S - | A 1
DO layout 0.49 0.47 13 1
EXPECT 1 0 "triangle of 36 nodes"
STATE N n0@0.5,0.866025 n1@0.45,0.779423 n2@0.55,0.779423 n3@0.4,0.69282 n4@0.5,0.69282 n5@0.6,0.69282 n6@0.35,0.606218 n7@0.45,0.606218 n8@0.55,0.606218 n9@0.65,0.606218 n10@0.3,0.519615 n11@0.4,0.519615 n12@0.5,0.519615 n13@0.6,0.519615 n14@0.7,0.519615 n15@0.25,0.433013 n16@0.35,0.433013 n17@0.45,0.433013 n18@0.55,0.433013 n19@0.65,0.433013 n20@0.75,0.433013 n21@0.2,0.34641 n22@0.3,0.34641 n23@0.4,0.34641 n24@0.5,0.34641 n25@0.6,0.34641 n26@0.7,0.34641 n27@0.8,0.34641 n28@0.15,0.259808 n29@0.25,0.259808 n30@0.35,0.259808 n31@0.45,0.259808 n32@0.55,0.259808 n33@0.65,0.259808 n34@0.75,0.259808 n35@0.85,0.259808 | R n0,n1,n2 n1,n3,n4 n1,n4,n2 n2,n4,n5 n3,n6,n7 n3,n7,n4 n4,n7,n8 n4,n8,n5 n5,n8,n9 n6,n10,n11 n6,n11,n7 n7,n11,n12 n7,n12,n8 n8,n12,n13 n8,n13,n9 n9,n13,n14 n10,n15,n16 n10,n16,n11 n11,n16,n17 n11,n17,n12 n12,n17,n18 n12,n18,n13 n13,n18,n19 n13,n19,n14 n14,n19,n20 n15,n21,n22 n15,n22,n16 n16,n22,n23 n16,n23,n17 n17,n23,n24 n17,n24,n18 n18,n24,n25 n18,n25,n19 n19,n25,n26 n19,n26,n20 n20,n26,n27 n21,n28,n29 n21,n29,n22 n22,n29,n30 n22,n30,n23 n23,n30,n31 n23,n31,n24 n24,n31,n32 n24,n32,n25 n25,n32,n33 n25,n33,n26 n26,n33,n34 n26,n34,n27 n27,n34,n35 | O n0:0:1 n1:1:1 n2:2:1 n3:3:1 n4:4:1 n5:5:1 n6:6:1 n7:7:1 n8:8:1 n9:9:1 n10:10:1 n11:11:1 n12:12:1 n13:13:1 n14:14:1 n15:15:1 n16:16:1 n17:17:1 n18:18:1 n19:19:1 n20:20:1 n21:21:1 n22:22:1 n23:23:1 n24:24:1 n25:25:1 n26:26:1 n27:27:1 n28:28:1 n29:29:1 n30:30:1 n31:31:1 n32:32:1 n33:33:1 n34:34:1 n35:35:1 | L n0>n0:1 n1>n1:1 n2>n2:1 n3>n3:1 n4>n4:1 n5>n5:1 n6>n6:1 n7>n7:1 n8>n8:1 n9>n9:1 n10>n10:1 n11>n11:1 n12>n12:1 n13>n13:1 n14>n14:1 n15>n15:1 n16>n16:1 n17>n17:1 n18>n18:1 n19>n19:1 n20>n20:1 n21>n21:1 n22>n22:1 n23>n23:1 n24>n24:1 n25>n25:1 n26>n26:1 n27>n27:1 n28>n28:1 n29>n29:1 n30>n30:1 n31>n31:1 n32>n32:1 n33>n33:1 n34>n34:1 n35>n35:1 | D  | C n0 | S n0 | A 1
