# ofxManifoldEditor model conformance vectors
# GENERATED by tests/ref/reference_editor.py -- do not hand edit
#
# Scripts: every operation followed by the complete state. The
# reference tracks everything by NAME and renumbers nothing; the
# C++ tracks ids and renumbers on every delete.

TOL 1e-5

# placing nodes, free-hand: each gets its own output, on the next free channel, and becomes the current output
EDIT place_auto_output ANALYTIC
GRID FREE
DO place 0.2 0.2
EXPECT 1 0 ""
STATE N n0@0.2,0.2 | R  | O n0:0:1 | L n0>n0:1 | D  | C n0 | A 1
DO place 0.8 0.2
EXPECT 1 0 ""
STATE N n0@0.2,0.2 n1@0.8,0.2 | R  | O n0:0:1 n1:1:1 | L n0>n0:1 n1>n1:1 | D  | C n0 | A 1
DO place 0.5 0.8
EXPECT 1 0 ""
STATE N n0@0.2,0.2 n1@0.8,0.2 n2@0.5,0.8 | R  | O n0:0:1 n1:1:1 n2:2:1 | L n0>n0:1 n1>n1:1 n2>n2:1 | D  | C n0 | A 1
DO place 0.2004 0.2
EXPECT 0 1 "a node is already there"
STATE N n0@0.2,0.2 n1@0.8,0.2 n2@0.5,0.8 | R  | O n0:0:1 n1:1:1 n2:2:1 | L n0>n0:1 n1>n1:1 n2>n2:1 | D  | C n0 | A 1
DO place 1.3 0.5
EXPECT 0 0 ""
STATE N n0@0.2,0.2 n1@0.8,0.2 n2@0.5,0.8 | R  | O n0:0:1 n1:1:1 n2:2:1 | L n0>n0:1 n1>n1:1 n2>n2:1 | D  | C n0 | A 1
ENDEDIT

# on a square grid the node lands on the grid point, and a second click at the same address is refused
EDIT place_on_grid ANALYTIC
GRID LATTICE 0.05 0 0 0.05 0 0 0
DO place 0.123 0.337
EXPECT 1 0 ""
STATE N n0@0.1,0.35 | R  | O n0:0:1 | L n0>n0:1 | D  | C n0 | A 1
DO place 0.11 0.34
EXPECT 0 1 "a node is already there"
STATE N n0@0.1,0.35 | R  | O n0:0:1 | L n0>n0:1 | D  | C n0 | A 1
DO place 0.3 0.3
EXPECT 1 0 ""
STATE N n0@0.1,0.35 n1@0.3,0.3 | R  | O n0:0:1 n1:1:1 | L n0>n0:1 n1>n1:1 | D  | C n0 | A 1
ENDEDIT

# with auto-output off a node starts unbound and no output appears
EDIT auto_output_off ANALYTIC
GRID FREE
DO auto
EXPECT 0 0 "auto-output off: new nodes start unbound"
STATE N  | R  | O  | L  | D  | C - | A 0
DO place 0.3 0.3
EXPECT 1 0 ""
STATE N n0@0.3,0.3 | R  | O  | L  | D  | C - | A 0
DO bind
EXPECT 0 1 "no output yet -- press o to make one"
STATE N n0@0.3,0.3 | R  | O  | L  | D  | C - | A 0
DO auto
EXPECT 0 0 "auto-output on: each new node gets its own output"
STATE N n0@0.3,0.3 | R  | O  | L  | D  | C - | A 1
DO place 0.6 0.3
EXPECT 1 0 ""
STATE N n0@0.3,0.3 n1@0.6,0.3 | R  | O n1:0:1 | L n1>n1:1 | D  | C n1 | A 1
ENDEDIT

# joining: fewer than three refused; click order kept; a box joins in angle order; a set already joined is refused; a click order that crosses itself is refused WITH the reason
EDIT join_orders ANALYTIC
GRID FREE
DO place 0.2 0.2
EXPECT 1 0 ""
STATE N n0@0.2,0.2 | R  | O n0:0:1 | L n0>n0:1 | D  | C n0 | A 1
DO place 0.8 0.2
EXPECT 1 0 ""
STATE N n0@0.2,0.2 n1@0.8,0.2 | R  | O n0:0:1 n1:1:1 | L n0>n0:1 n1>n1:1 | D  | C n0 | A 1
DO place 0.8 0.8
EXPECT 1 0 ""
STATE N n0@0.2,0.2 n1@0.8,0.2 n2@0.8,0.8 | R  | O n0:0:1 n1:1:1 n2:2:1 | L n0>n0:1 n1>n1:1 n2>n2:1 | D  | C n0 | A 1
DO place 0.2 0.8
EXPECT 1 0 ""
STATE N n0@0.2,0.2 n1@0.8,0.2 n2@0.8,0.8 n3@0.2,0.8 | R  | O n0:0:1 n1:1:1 n2:2:1 n3:3:1 | L n0>n0:1 n1>n1:1 n2>n2:1 n3>n3:1 | D  | C n0 | A 1
SEL only n0
SEL toggle n1
DO join
EXPECT 0 1 "select at least three nodes to join"
STATE N n0@0.2,0.2 n1@0.8,0.2 n2@0.8,0.8 n3@0.2,0.8 | R  | O n0:0:1 n1:1:1 n2:2:1 n3:3:1 | L n0>n0:1 n1>n1:1 n2>n2:1 n3>n3:1 | D  | C n0 | A 1
SEL only n0
SEL toggle n2
SEL toggle n1
SEL toggle n3
DO join
EXPECT 0 1 "refused: self-intersecting (in click order)"
STATE N n0@0.2,0.2 n1@0.8,0.2 n2@0.8,0.8 n3@0.2,0.8 | R  | O n0:0:1 n1:1:1 n2:2:1 n3:3:1 | L n0>n0:1 n1>n1:1 n2>n2:1 n3>n3:1 | D  | C n0 | A 1
SEL only n0
SEL toggle n1
SEL toggle n2
SEL toggle n3
DO join
EXPECT 1 0 "joined 4 nodes in click order"
STATE N n0@0.2,0.2 n1@0.8,0.2 n2@0.8,0.8 n3@0.2,0.8 | R n0,n1,n2,n3 | O n0:0:1 n1:1:1 n2:2:1 n3:3:1 | L n0>n0:1 n1>n1:1 n2>n2:1 n3>n3:1 | D  | C n0 | A 1
SEL clear
SEL box n3 n1 n0 n2
DO join
EXPECT 0 1 "those nodes already form a region"
STATE N n0@0.2,0.2 n1@0.8,0.2 n2@0.8,0.8 n3@0.2,0.8 | R n0,n1,n2,n3 | O n0:0:1 n1:1:1 n2:2:1 n3:3:1 | L n0>n0:1 n1>n1:1 n2>n2:1 n3>n3:1 | D  | C n0 | A 1
SEL clear
SEL box n0 n1 n2
DO join
EXPECT 1 0 "joined 3 nodes in angle order"
STATE N n0@0.2,0.2 n1@0.8,0.2 n2@0.8,0.8 n3@0.2,0.8 | R n0,n1,n2,n3 n0,n1,n2 | O n0:0:1 n1:1:1 n2:2:1 n3:3:1 | L n0>n0:1 n1>n1:1 n2>n2:1 n3>n3:1 | D  | C n0 | A 1
ENDEDIT

# a box over four fresh corners, caught in CROSSING order. Angle order makes the square; the selection's own order would cross itself. The earlier box join landed on a set already joined, so the duplicate check answered before ordering was consulted, and ordering went untested -- one step exercising two checks proves neither, as with the bowties and D-022
EDIT box_join_orders_by_angle ANALYTIC
GRID FREE
DO place 0.2 0.2
EXPECT 1 0 ""
STATE N n0@0.2,0.2 | R  | O n0:0:1 | L n0>n0:1 | D  | C n0 | A 1
DO place 0.8 0.2
EXPECT 1 0 ""
STATE N n0@0.2,0.2 n1@0.8,0.2 | R  | O n0:0:1 n1:1:1 | L n0>n0:1 n1>n1:1 | D  | C n0 | A 1
DO place 0.8 0.8
EXPECT 1 0 ""
STATE N n0@0.2,0.2 n1@0.8,0.2 n2@0.8,0.8 | R  | O n0:0:1 n1:1:1 n2:2:1 | L n0>n0:1 n1>n1:1 n2>n2:1 | D  | C n0 | A 1
DO place 0.2 0.8
EXPECT 1 0 ""
STATE N n0@0.2,0.2 n1@0.8,0.2 n2@0.8,0.8 n3@0.2,0.8 | R  | O n0:0:1 n1:1:1 n2:2:1 n3:3:1 | L n0>n0:1 n1>n1:1 n2>n2:1 n3>n3:1 | D  | C n0 | A 1
SEL clear
SEL box n0 n2 n1 n3
DO join
EXPECT 1 0 "joined 4 nodes in angle order"
STATE N n0@0.2,0.2 n1@0.8,0.2 n2@0.8,0.8 n3@0.2,0.8 | R n0,n1,n2,n3 | O n0:0:1 n1:1:1 n2:2:1 n3:3:1 | L n0>n0:1 n1>n1:1 n2>n2:1 n3>n3:1 | D  | C n0 | A 1
SEL only n0
SEL toggle n2
SEL toggle n1
SEL toggle n3
DO unjoin
EXPECT 1 0 "unjoined 1 region"
STATE N n0@0.2,0.2 n1@0.8,0.2 n2@0.8,0.8 n3@0.2,0.8 | R  | O n0:0:1 n1:1:1 n2:2:1 n3:3:1 | L n0>n0:1 n1>n1:1 n2>n2:1 n3>n3:1 | D  | C n0 | A 1
SEL only n0
SEL toggle n2
SEL toggle n1
SEL toggle n3
DO join
EXPECT 0 1 "refused: self-intersecting (in click order)"
STATE N n0@0.2,0.2 n1@0.8,0.2 n2@0.8,0.8 n3@0.2,0.8 | R  | O n0:0:1 n1:1:1 n2:2:1 n3:3:1 | L n0>n0:1 n1>n1:1 n2>n2:1 n3>n3:1 | D  | C n0 | A 1
ENDEDIT

# removing an output that comes BEFORE the current one: output ids after it shift down, so the current output must shift with them and still name the same output. Every earlier removal hit the current output or one after it
EDIT current_output_follows_renumbering ANALYTIC
GRID FREE
DO place 0.2 0.2
EXPECT 1 0 ""
STATE N n0@0.2,0.2 | R  | O n0:0:1 | L n0>n0:1 | D  | C n0 | A 1
DO place 0.8 0.2
EXPECT 1 0 ""
STATE N n0@0.2,0.2 n1@0.8,0.2 | R  | O n0:0:1 n1:1:1 | L n0>n0:1 n1>n1:1 | D  | C n0 | A 1
DO place 0.5 0.8
EXPECT 1 0 ""
STATE N n0@0.2,0.2 n1@0.8,0.2 n2@0.5,0.8 | R  | O n0:0:1 n1:1:1 n2:2:1 | L n0>n0:1 n1>n1:1 n2>n2:1 | D  | C n0 | A 1
DO pick n2
EXPECT 0 0 "current output: n2"
STATE N n0@0.2,0.2 n1@0.8,0.2 n2@0.5,0.8 | R  | O n0:0:1 n1:1:1 n2:2:1 | L n0>n0:1 n1>n1:1 n2>n2:1 | D  | C n2 | A 1
SEL only n0
DO remove
EXPECT 1 0 "removed 1 node, and 1 output"
STATE N n1@0.8,0.2 n2@0.5,0.8 | R  | O n1:1:1 n2:2:1 | L n1>n1:1 n2>n2:1 | D  | C n2 | A 1
SEL clear
SEL only n1
DO bind
EXPECT 1 0 "bound 1 to n2"
STATE N n1@0.8,0.2 n2@0.5,0.8 | R  | O n1:1:1 n2:2:1 | L n1>n1:1 n1>n2:1 n2>n2:1 | D  | C n2 | A 1
ENDEDIT

