ENDEDIT

# placing a node on a map with levels: it gets an output of its own on every level -- P, P-2, P-3 -- and it starts at each level's own height. Removing nodes takes their heights and bindings from every level; a node's own output stays while ANY level still feeds it
EDIT levels_nodes ANALYTIC
GRID FREE
DO place 0.2 0.2
EXPECT 1 0 ""
STATE N n0@0.2,0.2 | R  | O n0:0:1 | L n0>n0:1 | D  | C n0 | S n0 | A 1
DO place 0.8 0.2
EXPECT 1 0 ""
STATE N n0@0.2,0.2 n1@0.8,0.2 | R  | O n0:0:1 n1:1:1 | L n0>n0:1 n1>n1:1 | D  | C n0 | S n0 | A 1
DO newlevel 1
EXPECT 1 0 "new level 2 of 2, at 0.25, with 2 outputs of its own"
STATE N n0@0.2,0.2 n1@0.8,0.2 | R  | O n0:0:1 n1:1:1 n0-2:2:1 n1-2:3:1 | L n0>n0-2:1 n1>n1-2:1 | D  | C n0 | S n0 | A 1 | V 1 | Z0 0 K n0>n0:1 n1>n1:1 | Z1 0.25 K n0>n0-2:1 n1>n1-2:1
DO newlevel 1
EXPECT 1 0 "new level 3 of 3, at 0.5, with 2 outputs of its own"
STATE N n0@0.2,0.2 n1@0.8,0.2 | R  | O n0:0:1 n1:1:1 n0-2:2:1 n1-2:3:1 n0-3:4:1 n1-3:5:1 | L n0>n0-3:1 n1>n1-3:1 | D  | C n0 | S n0 | A 1 | V 2 | Z0 0 K n0>n0:1 n1>n1:1 | Z1 0.25 K n0>n0-2:1 n1>n1-2:1 | Z2 0.5 K n0>n0-3:1 n1>n1-3:1
DO place 0.5 0.8
EXPECT 1 0 ""
STATE N n0@0.2,0.2 n1@0.8,0.2 n2@0.5,0.8 | R  | O n0:0:1 n1:1:1 n0-2:2:1 n1-2:3:1 n0-3:4:1 n1-3:5:1 n2:6:1 n2-2:7:1 n2-3:8:1 | L n0>n0-3:1 n1>n1-3:1 n2>n2-3:1 | D  | C n0 | S n0 | A 1 | V 2 | Z0 0 K n0>n0:1 n1>n1:1 n2>n2:1 | Z1 0.25 K n0>n0-2:1 n1>n1-2:1 n2>n2-2:1 | Z2 0.5 K n0>n0-3:1 n1>n1-3:1 n2>n2-3:1
SEL only n2
DO raise -1 0
EXPECT 1 0 "height -0.05"
STATE N n0@0.2,0.2 n1@0.8,0.2 n2@0.5,0.8 | R  | O n0:0:1 n1:1:1 n0-2:2:1 n1-2:3:1 n0-3:4:1 n1-3:5:1 n2:6:1 n2-2:7:1 n2-3:8:1 | L n0>n0-3:1 n1>n1-3:1 n2>n2-3:1 | D  | C n0 | S n0 | A 1 | V 2 | Z0 0 K n0>n0:1 n1>n1:1 n2>n2:1 | Z1 0.25 K n0>n0-2:1 n1>n1-2:1 n2>n2-2:1 | Z2 0.5 n2=0.45 K n0>n0-3:1 n1>n1-3:1 n2>n2-3:1
DO leveldown
EXPECT 0 0 "level 2 of 3, at 0.25"
STATE N n0@0.2,0.2 n1@0.8,0.2 n2@0.5,0.8 | R  | O n0:0:1 n1:1:1 n0-2:2:1 n1-2:3:1 n0-3:4:1 n1-3:5:1 n2:6:1 n2-2:7:1 n2-3:8:1 | L n0>n0-2:1 n1>n1-2:1 n2>n2-2:1 | D  | C n0 | S n0 | A 1 | V 1 | Z0 0 K n0>n0:1 n1>n1:1 n2>n2:1 | Z1 0.25 K n0>n0-2:1 n1>n1-2:1 n2>n2-2:1 | Z2 0.5 n2=0.45 K n0>n0-3:1 n1>n1-3:1 n2>n2-3:1
SEL only n0
DO pick n1
EXPECT 0 0 "current output: n1"
STATE N n0@0.2,0.2 n1@0.8,0.2 n2@0.5,0.8 | R  | O n0:0:1 n1:1:1 n0-2:2:1 n1-2:3:1 n0-3:4:1 n1-3:5:1 n2:6:1 n2-2:7:1 n2-3:8:1 | L n0>n0-2:1 n1>n1-2:1 n2>n2-2:1 | D  | C n1 | S n1 | A 1 | V 1 | Z0 0 K n0>n0:1 n1>n1:1 n2>n2:1 | Z1 0.25 K n0>n0-2:1 n1>n1-2:1 n2>n2-2:1 | Z2 0.5 n2=0.45 K n0>n0-3:1 n1>n1-3:1 n2>n2-3:1
DO bind
EXPECT 1 0 "bound 1 to n1"
STATE N n0@0.2,0.2 n1@0.8,0.2 n2@0.5,0.8 | R  | O n0:0:1 n1:1:1 n0-2:2:1 n1-2:3:1 n0-3:4:1 n1-3:5:1 n2:6:1 n2-2:7:1 n2-3:8:1 | L n0>n0-2:1 n0>n1:1 n1>n1-2:1 n2>n2-2:1 | D  | C n1 | S n1 | A 1 | V 1 | Z0 0 K n0>n0:1 n1>n1:1 n2>n2:1 | Z1 0.25 K n0>n0-2:1 n0>n1:1 n1>n1-2:1 n2>n2-2:1 | Z2 0.5 n2=0.45 K n0>n0-3:1 n1>n1-3:1 n2>n2-3:1
DO leveldown
EXPECT 0 0 "level 1 of 3, at 0"
STATE N n0@0.2,0.2 n1@0.8,0.2 n2@0.5,0.8 | R  | O n0:0:1 n1:1:1 n0-2:2:1 n1-2:3:1 n0-3:4:1 n1-3:5:1 n2:6:1 n2-2:7:1 n2-3:8:1 | L n0>n0:1 n1>n1:1 n2>n2:1 | D  | C n1 | S n1 | A 1 | V 0 | Z0 0 K n0>n0:1 n1>n1:1 n2>n2:1 | Z1 0.25 K n0>n0-2:1 n0>n1:1 n1>n1-2:1 n2>n2-2:1 | Z2 0.5 n2=0.45 K n0>n0-3:1 n1>n1-3:1 n2>n2-3:1
SEL only n1
DO remove
EXPECT 1 0 "removed 1 node, and 2 outputs"
STATE N n0@0.2,0.2 n2@0.5,0.8 | R  | O n0:0:1 n1:1:1 n0-2:2:1 n0-3:4:1 n2:6:1 n2-2:7:1 n2-3:8:1 | L n0>n0:1 n2>n2:1 | D  | C n1 | S n1 | A 1 | V 0 | Z0 0 K n0>n0:1 n2>n2:1 | Z1 0.25 K n0>n0-2:1 n0>n1:1 n2>n2-2:1 | Z2 0.5 n2=0.45 K n0>n0-3:1 n2>n2-3:1
SEL clear
# n1's own outputs on the upper levels go; n1 itself stays: n0
# still feeds it on the middle level
SEL only n2
DO remove
EXPECT 1 0 "removed 1 node, and 3 outputs"
STATE N n0@0.2,0.2 | R  | O n0:0:1 n1:1:1 n0-2:2:1 n0-3:4:1 | L n0>n0:1 | D  | C n1 | S n1 | A 1 | V 0 | Z0 0 K n0>n0:1 | Z1 0.25 K n0>n0-2:1 n0>n1:1 | Z2 0.5 K n0>n0-3:1
SEL clear
DO undo
EXPECT 1 0 "undid delete"
STATE N n0@0.2,0.2 n2@0.5,0.8 | R  | O n0:0:1 n1:1:1 n0-2:2:1 n0-3:4:1 n2:6:1 n2-2:7:1 n2-3:8:1 | L n0>n0:1 n2>n2:1 | D  | C n1 | S n1 | A 1 | V 0 | Z0 0 K n0>n0:1 n2>n2:1 | Z1 0.25 K n0>n0-2:1 n0>n1:1 n2>n2-2:1 | Z2 0.5 n2=0.45 K n0>n0-3:1 n2>n2-3:1
ENDEDIT

# outputs belong to every level: a new output, a trim, a derived output and a removal reach all of them; the removal counts each node that fed it on any level once
EDIT levels_outputs ANALYTIC
GRID FREE
DO place 0.2 0.2
EXPECT 1 0 ""
STATE N n0@0.2,0.2 | R  | O n0:0:1 | L n0>n0:1 | D  | C n0 | S n0 | A 1
DO place 0.8 0.2
EXPECT 1 0 ""
STATE N n0@0.2,0.2 n1@0.8,0.2 | R  | O n0:0:1 n1:1:1 | L n0>n0:1 n1>n1:1 | D  | C n0 | S n0 | A 1
DO newlevel 1
EXPECT 1 0 "new level 2 of 2, at 0.25, with 2 outputs of its own"
STATE N n0@0.2,0.2 n1@0.8,0.2 | R  | O n0:0:1 n1:1:1 n0-2:2:1 n1-2:3:1 | L n0>n0-2:1 n1>n1-2:1 | D  | C n0 | S n0 | A 1 | V 1 | Z0 0 K n0>n0:1 n1>n1:1 | Z1 0.25 K n0>n0-2:1 n1>n1-2:1
DO newoutput
EXPECT 1 0 "new output out4 on channel 4 -- select nodes and press b"
STATE N n0@0.2,0.2 n1@0.8,0.2 | R  | O n0:0:1 n1:1:1 n0-2:2:1 n1-2:3:1 out4:4:1 | L n0>n0-2:1 n1>n1-2:1 | D  | C out4 | S out4 | A 1 | V 1 | Z0 0 K n0>n0:1 n1>n1:1 | Z1 0.25 K n0>n0-2:1 n1>n1-2:1
SEL only n0
DO bind
EXPECT 1 0 "bound 1 to out4"
STATE N n0@0.2,0.2 n1@0.8,0.2 | R  | O n0:0:1 n1:1:1 n0-2:2:1 n1-2:3:1 out4:4:1 | L n0>n0-2:1 n0>out4:1 n1>n1-2:1 | D  | C out4 | S out4 | A 1 | V 1 | Z0 0 K n0>n0:1 n1>n1:1 | Z1 0.25 K n0>n0-2:1 n0>out4:1 n1>n1-2:1
DO leveldown
EXPECT 0 0 "level 1 of 2, at 0"
STATE N n0@0.2,0.2 n1@0.8,0.2 | R  | O n0:0:1 n1:1:1 n0-2:2:1 n1-2:3:1 out4:4:1 | L n0>n0:1 n1>n1:1 | D  | C out4 | S out4 | A 1 | V 0 | Z0 0 K n0>n0:1 n1>n1:1 | Z1 0.25 K n0>n0-2:1 n0>out4:1 n1>n1-2:1
SEL only n0
SEL toggle n1
DO bind
EXPECT 1 0 "bound 2 to out4"
STATE N n0@0.2,0.2 n1@0.8,0.2 | R  | O n0:0:1 n1:1:1 n0-2:2:1 n1-2:3:1 out4:4:1 | L n0>n0:1 n0>out4:1 n1>n1:1 n1>out4:1 | D  | C out4 | S out4 | A 1 | V 0 | Z0 0 K n0>n0:1 n0>out4:1 n1>n1:1 n1>out4:1 | Z1 0.25 K n0>n0-2:1 n0>out4:1 n1>n1-2:1
DO trim -6
EXPECT 1 0 ""
STATE N n0@0.2,0.2 n1@0.8,0.2 | R  | O n0:0:1 n1:1:1 n0-2:2:1 n1-2:3:1 out4:4:0.501187 | L n0>n0:1 n0>out4:1 n1>n1:1 n1>out4:1 | D  | C out4 | S out4 | A 1 | V 0 | Z0 0 K n0>n0:1 n0>out4:1 n1>n1:1 n1>out4:1 | Z1 0.25 K n0>n0-2:1 n0>out4:1 n1>n1-2:1
DO derivedafter
EXPECT 1 0 "derived sum5 on channel 5, after out4"
STATE N n0@0.2,0.2 n1@0.8,0.2 | R  | O n0:0:1 n1:1:1 n0-2:2:1 n1-2:3:1 out4:4:0.501187 | L n0>n0:1 n0>out4:1 n1>n1:1 n1>out4:1 | D sum5:5:>out4 | C out4 | S out4 | A 1 | V 0 | Z0 0 K n0>n0:1 n0>out4:1 n1>n1:1 n1>out4:1 | Z1 0.25 K n0>n0-2:1 n0>out4:1 n1>n1-2:1
# removed from the upper level, where only n0 feeds it: n1 feeds
# it on the ground, so two nodes no longer reach it
DO levelup
EXPECT 0 0 "level 2 of 2, at 0.25"
STATE N n0@0.2,0.2 n1@0.8,0.2 | R  | O n0:0:1 n1:1:1 n0-2:2:1 n1-2:3:1 out4:4:0.501187 | L n0>n0-2:1 n0>out4:1 n1>n1-2:1 | D sum5:5:>out4 | C out4 | S out4 | A 1 | V 1 | Z0 0 K n0>n0:1 n0>out4:1 n1>n1:1 n1>out4:1 | Z1 0.25 K n0>n0-2:1 n0>out4:1 n1>n1-2:1
DO removeoutput
EXPECT 1 1 "removed output out4 -- 2 nodes no longer reach it"
STATE N n0@0.2,0.2 n1@0.8,0.2 | R  | O n0:0:1 n1:1:1 n0-2:2:1 n1-2:3:1 | L n0>n0-2:1 n1>n1-2:1 | D sum5:5: | C n0 | S n0 | A 1 | V 1 | Z0 0 K n0>n0:1 n1>n1:1 | Z1 0.25 K n0>n0-2:1 n1>n1-2:1
ENDEDIT

# a map with three levels, one bent, saved and opened again: every level, its heights and its bindings come back; the first level is current
EDIT levels_files ANALYTIC
GRID FREE
DO example
EXPECT 1 0 ""
STATE N O@0.3,0.5 N@0.3,0.8 E@0.5,0.5 S@0.3,0.2 W@0.1,0.5 A@0.65,0.35 B@0.9,0.35 C@0.9,0.65 D@0.65,0.65 | R O,N,E O,E,S O,S,W O,W,N A,B,C,D | O front:0:1 left:1:1 right:2:1 rear:3:1 | L O>front:1 O>left:1 O>right:1 O>rear:1 N>front:1 E>right:1 S>rear:1 W>left:1 B>right:1 B>~:1 C>left:1 C>right:1 D>rear:1 D>~:0.333333 | D sub:4:N,O | C front | S front | A 1
DO newlevel 1
EXPECT 1 0 "new level 2 of 2, at 0.25, with 9 outputs of its own"
