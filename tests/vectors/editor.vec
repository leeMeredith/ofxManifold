# a rig used on a map with levels moves every level onto it: each keeps its own bindings, by name
EDIT levels_rig ANALYTIC
GRID FREE
DO place 0.2 0.2
EXPECT 1 0 ""
STATE N n0@0.2,0.2 | R  | O n0:0:1 | L n0>n0:1 | D  | C n0 | S n0 | A 1
DO place 0.8 0.2
EXPECT 1 0 ""
STATE N n0@0.2,0.2 n1@0.8,0.2 | R  | O n0:0:1 n1:1:1 | L n0>n0:1 n1>n1:1 | D  | C n0 | S n0 | A 1
DO place 0.5 0.8
EXPECT 1 0 ""
STATE N n0@0.2,0.2 n1@0.8,0.2 n2@0.5,0.8 | R  | O n0:0:1 n1:1:1 n2:2:1 | L n0>n0:1 n1>n1:1 n2>n2:1 | D  | C n0 | S n0 | A 1
DO pick n0
EXPECT 0 0 "current output: n0"
STATE N n0@0.2,0.2 n1@0.8,0.2 n2@0.5,0.8 | R  | O n0:0:1 n1:1:1 n2:2:1 | L n0>n0:1 n1>n1:1 n2>n2:1 | D  | C n0 | S n0 | A 1
DO trim -6
EXPECT 1 0 ""
STATE N n0@0.2,0.2 n1@0.8,0.2 n2@0.5,0.8 | R  | O n0:0:0.501187 n1:1:1 n2:2:1 | L n0>n0:1 n1>n1:1 n2>n2:1 | D  | C n0 | S n0 | A 1
DO saverig room
EXPECT 0 0 "saved rig room-rig.json"
STATE N n0@0.2,0.2 n1@0.8,0.2 n2@0.5,0.8 | R  | O n0:0:0.501187 n1:1:1 n2:2:1 | L n0>n0:1 n1>n1:1 n2>n2:1 | D  | C n0 | S n0 | A 1
DO empty
EXPECT 1 0 ""
STATE N  | R  | O  | L  | D  | C - | S - | A 1
DO place 0.8 0.2
EXPECT 1 0 ""
STATE N n0@0.8,0.2 | R  | O n0:0:1 | L n0>n0:1 | D  | C n0 | S n0 | A 1
DO place 0.2 0.2
EXPECT 1 0 ""
STATE N n0@0.8,0.2 n1@0.2,0.2 | R  | O n0:0:1 n1:1:1 | L n0>n0:1 n1>n1:1 | D  | C n0 | S n0 | A 1
# auto-output off: the new level shares the first's outputs
DO auto
EXPECT 0 0 "auto-output off: new nodes start unbound"
STATE N n0@0.8,0.2 n1@0.2,0.2 | R  | O n0:0:1 n1:1:1 | L n0>n0:1 n1>n1:1 | D  | C n0 | S n0 | A 0
DO newlevel 1
EXPECT 1 0 "new level 2 of 2, at 0.25"
STATE N n0@0.8,0.2 n1@0.2,0.2 | R  | O n0:0:1 n1:1:1 | L n0>n0:1 n1>n1:1 | D  | C n0 | S n0 | A 0 | V 1 | Z0 0 K n0>n0:1 n1>n1:1 | Z1 0.25 K n0>n0:1 n1>n1:1
SEL only n0
DO pick n1
EXPECT 0 0 "current output: n1"
STATE N n0@0.8,0.2 n1@0.2,0.2 | R  | O n0:0:1 n1:1:1 | L n0>n0:1 n1>n1:1 | D  | C n1 | S n1 | A 0 | V 1 | Z0 0 K n0>n0:1 n1>n1:1 | Z1 0.25 K n0>n0:1 n1>n1:1
DO bind
EXPECT 1 0 "bound 1 to n1"
STATE N n0@0.8,0.2 n1@0.2,0.2 | R  | O n0:0:1 n1:1:1 | L n0>n0:1 n0>n1:1 n1>n1:1 | D  | C n1 | S n1 | A 0 | V 1 | Z0 0 K n0>n0:1 n1>n1:1 | Z1 0.25 K n0>n0:1 n0>n1:1 n1>n1:1
DO userig room
EXPECT 1 0 "using rig room: 3 outputs"
STATE N n0@0.8,0.2 n1@0.2,0.2 | R  | O n0:0:0.501187 n1:1:1 n2:2:1 | L n0>n0:1 n0>n1:1 n1>n1:1 | D  | C n1 | S n1 | A 0 | V 1 | Z0 0 K n0>n0:1 n1>n1:1 | Z1 0.25 K n0>n0:1 n0>n1:1 n1>n1:1
DO undo
EXPECT 1 0 "undid use rig"
STATE N n0@0.8,0.2 n1@0.2,0.2 | R  | O n0:0:1 n1:1:1 | L n0>n0:1 n0>n1:1 n1>n1:1 | D  | C n1 | S n1 | A 0 | V 1 | Z0 0 K n0>n0:1 n1>n1:1 | Z1 0.25 K n0>n0:1 n0>n1:1 n1>n1:1
# auto-output on: a new level brings outputs the rig lacks
DO auto
EXPECT 0 0 "auto-output on: each new node gets its own output"
STATE N n0@0.8,0.2 n1@0.2,0.2 | R  | O n0:0:1 n1:1:1 | L n0>n0:1 n0>n1:1 n1>n1:1 | D  | C n1 | S n1 | A 1 | V 1 | Z0 0 K n0>n0:1 n1>n1:1 | Z1 0.25 K n0>n0:1 n0>n1:1 n1>n1:1
DO newlevel 1
EXPECT 1 0 "new level 3 of 3, at 0.5, with 2 outputs of its own"
STATE N n0@0.8,0.2 n1@0.2,0.2 | R  | O n0:0:1 n1:1:1 n0-3:2:1 n1-3:3:1 | L n0>n0-3:1 n0>n1-3:1 n1>n1-3:1 | D  | C n1 | S n1 | A 1 | V 2 | Z0 0 K n0>n0:1 n1>n1:1 | Z1 0.25 K n0>n0:1 n0>n1:1 n1>n1:1 | Z2 0.5 K n0>n0-3:1 n0>n1-3:1 n1>n1-3:1
DO userig room
EXPECT 0 1 "cannot use rig room -- not in it, or not the same kind: n0-3, n1-3"
STATE N n0@0.8,0.2 n1@0.2,0.2 | R  | O n0:0:1 n1:1:1 n0-3:2:1 n1-3:3:1 | L n0>n0-3:1 n0>n1-3:1 n1>n1-3:1 | D  | C n1 | S n1 | A 1 | V 2 | Z0 0 K n0>n0:1 n1>n1:1 | Z1 0.25 K n0>n0:1 n0>n1:1 n1>n1:1 | Z2 0.5 K n0>n0-3:1 n0>n1-3:1 n1>n1-3:1
ENDEDIT

# audition in three dimensions: it starts on the current level under the point; up and down glide it through the levels and past them. The chart is handed what reaches the room there, and the column of dots places the listening mark between the levels it lies between, or past the ends, greyed, outside
EDIT levels_listening ANALYTIC
GRID FREE
DO example
EXPECT 1 0 ""
STATE N O@0.3,0.5 N@0.3,0.8 E@0.5,0.5 S@0.3,0.2 W@0.1,0.5 A@0.65,0.35 B@0.9,0.35 C@0.9,0.65 D@0.65,0.65 | R O,N,E O,E,S O,S,W O,W,N A,B,C,D | O front:0:1 left:1:1 right:2:1 rear:3:1 | L O>front:1 O>left:1 O>right:1 O>rear:1 N>front:1 E>right:1 S>rear:1 W>left:1 B>right:1 B>~:1 C>left:1 C>right:1 D>rear:1 D>~:0.333333 | D sub:4:N,O | C front | S front | A 1
# one level: z changes nothing, and there are no dots
HEAR O=0.5 N=0.25 E=0.25 Z 0 COL 0 90 1 EXPECT 1 ROUTED 0.375 0.125 0.375 0.125 0.75 SILENCE 0 SEL - DOTS NONE
HEAR O=0.5 N=0.25 E=0.25 Z 3 COL 0 90 1 EXPECT 1 ROUTED 0.375 0.125 0.375 0.125 0.75 SILENCE 0 SEL - DOTS NONE
KEYS drag=0 aud=1 grid=lattice EXPECT place:0 box:0 toggle:0 all:1 none:0 move:0 freehand:0 join:0 unjoin:0 remove:0 gridkind:1 rotate:1 spacing:1 spokes:0 deadzone:1 layoutsize:1 layout:1 newoutput:1 pickoutput:1 addoutput:1 nextoutput:1 bind:0 bindall:0 fill:0 clear:0 silence:0 derivedafter:1 derived:0 trim:1 removeoutput:1 autooutput:1 levelswitch:1 newlevel:1 raise:0 movelevel:0 match:0 removelevel:0 view3d:1 newvalue:1 pickvalue:0 stepvalue:0 editvalue:0 removevalue:0 audition:1 lock:1 undo:1 redo:0 save:1 saveas:1 open:1 userig:1 saverig:1 empty:1 example:1 fullscreen:1 textsize:1 keysheet:1 BIND bind or unbind selected
DO newlevel 1
EXPECT 1 0 "new level 2 of 2, at 0.25, with 9 outputs of its own"
STATE N O@0.3,0.5 N@0.3,0.8 E@0.5,0.5 S@0.3,0.2 W@0.1,0.5 A@0.65,0.35 B@0.9,0.35 C@0.9,0.65 D@0.65,0.65 | R O,N,E O,E,S O,S,W O,W,N A,B,C,D | O front:0:1 left:1:1 right:2:1 rear:3:1 O-2:5:1 N-2:6:1 E-2:7:1 S-2:8:1 W-2:9:1 A-2:10:1 B-2:11:1 C-2:12:1 D-2:13:1 | L O>O-2:4 N>N-2:1 E>E-2:1 S>S-2:1 W>W-2:1 A>A-2:1 B>B-2:1 B>~:1 C>C-2:2 D>D-2:1 D>~:0.333333 | D sub:4:N,O | C front | S front | A 1 | V 1 | Z0 0 K O>front:1 O>left:1 O>right:1 O>rear:1 N>front:1 E>right:1 S>rear:1 W>left:1 B>right:1 B>~:1 C>left:1 C>right:1 D>rear:1 D>~:0.333333 | Z1 0.25 K O>O-2:4 N>N-2:1 E>E-2:1 S>S-2:1 W>W-2:1 A>A-2:1 B>B-2:1 B>~:1 C>C-2:2 D>D-2:1 D>~:0.333333
