# shift-B binds a node to EVERY output equally, replacing its output bindings rather than adding to them -- adding would feed the output it already had double -- and keeps its fill
EDIT bind_to_every_output ANALYTIC
GRID FREE
SEL only n0
DO bindall
EXPECT 0 1 "no output yet -- press o to make one"
STATE N  | R  | O  | L  | D  | C - | A 1
DO place 0.2 0.2
EXPECT 1 0 ""
STATE N n0@0.2,0.2 | R  | O n0:0:1 | L n0>n0:1 | D  | C n0 | A 1
DO place 0.8 0.2
EXPECT 1 0 ""
STATE N n0@0.2,0.2 n1@0.8,0.2 | R  | O n0:0:1 n1:1:1 | L n0>n0:1 n1>n1:1 | D  | C n0 | A 1
DO place 0.5 0.8
EXPECT 1 0 ""
STATE N n0@0.2,0.2 n1@0.8,0.2 n2@0.5,0.8 | R  | O n0:0:1 n1:1:1 n2:2:1 | L n0>n0:1 n1>n1:1 n2>n2:1 | D  | C n0 | A 1
SEL only n0
DO bindall
EXPECT 1 0 "bound 1 node to every output (3)"
STATE N n0@0.2,0.2 n1@0.8,0.2 n2@0.5,0.8 | R  | O n0:0:1 n1:1:1 n2:2:1 | L n0>n0:1 n0>n1:1 n0>n2:1 n1>n1:1 n2>n2:1 | D  | C n0 | A 1
DO fill -1 0
EXPECT 1 0 "fill 95%"
STATE N n0@0.2,0.2 n1@0.8,0.2 n2@0.5,0.8 | R  | O n0:0:1 n1:1:1 n2:2:1 | L n0>n0:1 n0>n1:1 n0>n2:1 n0>~:0.157895 n1>n1:1 n2>n2:1 | D  | C n0 | A 1
DO fill -1 0
EXPECT 1 0 "fill 90%"
STATE N n0@0.2,0.2 n1@0.8,0.2 n2@0.5,0.8 | R  | O n0:0:1 n1:1:1 n2:2:1 | L n0>n0:1 n0>n1:1 n0>n2:1 n0>~:0.333333 n1>n1:1 n2>n2:1 | D  | C n0 | A 1
DO bindall
EXPECT 1 0 "bound 1 node to every output (3)"
STATE N n0@0.2,0.2 n1@0.8,0.2 n2@0.5,0.8 | R  | O n0:0:1 n1:1:1 n2:2:1 | L n0>n0:1 n0>n1:1 n0>n2:1 n0>~:0.333333 n1>n1:1 n2>n2:1 | D  | C n0 | A 1
SEL only n1
SEL toggle n2
DO bindall
EXPECT 1 0 "bound 2 nodes to every output (3)"
STATE N n0@0.2,0.2 n1@0.8,0.2 n2@0.5,0.8 | R  | O n0:0:1 n1:1:1 n2:2:1 | L n0>n0:1 n0>n1:1 n0>n2:1 n0>~:0.333333 n1>n0:1 n1>n1:1 n1>n2:1 n2>n0:1 n2>n1:1 n2>n2:1 | D  | C n0 | A 1
ENDEDIT

# placing a node no longer moves the current output. It used to follow every new node, so b on the newest node unbound it from its own output and left it silent. An unbind that leaves a node with no output says so: by name for one node, by count for several, and as a warning
EDIT current_output_stays_put ANALYTIC
GRID FREE
DO place 0.2 0.2
EXPECT 1 0 ""
STATE N n0@0.2,0.2 | R  | O n0:0:1 | L n0>n0:1 | D  | C n0 | A 1
DO place 0.8 0.2
EXPECT 1 0 ""
STATE N n0@0.2,0.2 n1@0.8,0.2 | R  | O n0:0:1 n1:1:1 | L n0>n0:1 n1>n1:1 | D  | C n0 | A 1
DO pick n1
EXPECT 0 0 "current output: n1"
STATE N n0@0.2,0.2 n1@0.8,0.2 | R  | O n0:0:1 n1:1:1 | L n0>n0:1 n1>n1:1 | D  | C n1 | A 1
DO place 0.5 0.8
EXPECT 1 0 ""
STATE N n0@0.2,0.2 n1@0.8,0.2 n2@0.5,0.8 | R  | O n0:0:1 n1:1:1 n2:2:1 | L n0>n0:1 n1>n1:1 n2>n2:1 | D  | C n1 | A 1
SEL only n2
DO bind
EXPECT 1 0 "bound 1 to n1"
STATE N n0@0.2,0.2 n1@0.8,0.2 n2@0.5,0.8 | R  | O n0:0:1 n1:1:1 n2:2:1 | L n0>n0:1 n1>n1:1 n2>n2:1 n2>n1:1 | D  | C n1 | A 1
DO bind
EXPECT 1 0 "unbound 1 from n1"
STATE N n0@0.2,0.2 n1@0.8,0.2 n2@0.5,0.8 | R  | O n0:0:1 n1:1:1 n2:2:1 | L n0>n0:1 n1>n1:1 n2>n2:1 | D  | C n1 | A 1
DO pick n2
EXPECT 0 0 "current output: n2"
STATE N n0@0.2,0.2 n1@0.8,0.2 n2@0.5,0.8 | R  | O n0:0:1 n1:1:1 n2:2:1 | L n0>n0:1 n1>n1:1 n2>n2:1 | D  | C n2 | A 1
DO bind
EXPECT 1 1 "unbound 1 from n2 -- n2 now silent; cmd-z undoes"
STATE N n0@0.2,0.2 n1@0.8,0.2 n2@0.5,0.8 | R  | O n0:0:1 n1:1:1 n2:2:1 | L n0>n0:1 n1>n1:1 | D  | C n2 | A 1
DO undo
EXPECT 1 0 "undid binding"
STATE N n0@0.2,0.2 n1@0.8,0.2 n2@0.5,0.8 | R  | O n0:0:1 n1:1:1 n2:2:1 | L n0>n0:1 n1>n1:1 n2>n2:1 | D  | C n2 | A 1
DO pick n0
EXPECT 0 0 "current output: n0"
STATE N n0@0.2,0.2 n1@0.8,0.2 n2@0.5,0.8 | R  | O n0:0:1 n1:1:1 n2:2:1 | L n0>n0:1 n1>n1:1 n2>n2:1 | D  | C n0 | A 1
SEL only n1
DO bind
EXPECT 1 0 "bound 1 to n0"
STATE N n0@0.2,0.2 n1@0.8,0.2 n2@0.5,0.8 | R  | O n0:0:1 n1:1:1 n2:2:1 | L n0>n0:1 n1>n1:1 n1>n0:1 n2>n2:1 | D  | C n0 | A 1
DO pick n1
EXPECT 0 0 "current output: n1"
STATE N n0@0.2,0.2 n1@0.8,0.2 n2@0.5,0.8 | R  | O n0:0:1 n1:1:1 n2:2:1 | L n0>n0:1 n1>n1:1 n1>n0:1 n2>n2:1 | D  | C n1 | A 1
DO bind
EXPECT 1 0 "unbound 1 from n1"
STATE N n0@0.2,0.2 n1@0.8,0.2 n2@0.5,0.8 | R  | O n0:0:1 n1:1:1 n2:2:1 | L n0>n0:1 n1>n0:1 n2>n2:1 | D  | C n1 | A 1
DO pick n0
EXPECT 0 0 "current output: n0"
STATE N n0@0.2,0.2 n1@0.8,0.2 n2@0.5,0.8 | R  | O n0:0:1 n1:1:1 n2:2:1 | L n0>n0:1 n1>n0:1 n2>n2:1 | D  | C n0 | A 1
SEL only n0
SEL toggle n1
DO bind
EXPECT 1 1 "unbound 2 from n0 -- 2 nodes now silent; cmd-z undoes"
STATE N n0@0.2,0.2 n1@0.8,0.2 n2@0.5,0.8 | R  | O n0:0:1 n1:1:1 n2:2:1 | L n2>n2:1 | D  | C n0 | A 1
ENDEDIT

# b toggles each selected node's binding to the CURRENT output. Pressing it twice unbinds rather than feeding the output double; a mixed selection binds only the nodes not yet bound; fill is kept through every change; a node losing its last output becomes cleanly null
EDIT bind_toggles ANALYTIC
GRID FREE
DO place 0.2 0.2
EXPECT 1 0 ""
STATE N n0@0.2,0.2 | R  | O n0:0:1 | L n0>n0:1 | D  | C n0 | A 1
DO place 0.8 0.2
EXPECT 1 0 ""
STATE N n0@0.2,0.2 n1@0.8,0.2 | R  | O n0:0:1 n1:1:1 | L n0>n0:1 n1>n1:1 | D  | C n0 | A 1
DO place 0.5 0.8
EXPECT 1 0 ""
