# shift-B binds a node to EVERY output equally, replacing its output bindings rather than adding to them -- adding would feed the output it already had double -- and keeps its fill
EDIT bind_to_every_output ANALYTIC
GRID FREE
SEL only n0
DO bindall
EXPECT 0 1 "no output yet -- press o to make one"
STATE N  | R  | O  | L  | D  | C - | S - | A 1
DO place 0.2 0.2
EXPECT 1 0 ""
STATE N n0@0.2,0.2 | R  | O n0:0:1 | L n0>n0:1 | D  | C n0 | S n0 | A 1
DO place 0.8 0.2
EXPECT 1 0 ""
STATE N n0@0.2,0.2 n1@0.8,0.2 | R  | O n0:0:1 n1:1:1 | L n0>n0:1 n1>n1:1 | D  | C n0 | S n0 | A 1
DO place 0.5 0.8
EXPECT 1 0 ""
STATE N n0@0.2,0.2 n1@0.8,0.2 n2@0.5,0.8 | R  | O n0:0:1 n1:1:1 n2:2:1 | L n0>n0:1 n1>n1:1 n2>n2:1 | D  | C n0 | S n0 | A 1
SEL only n0
DO bindall
EXPECT 1 0 "bound 1 node to every output (3)"
STATE N n0@0.2,0.2 n1@0.8,0.2 n2@0.5,0.8 | R  | O n0:0:1 n1:1:1 n2:2:1 | L n0>n0:1 n0>n1:1 n0>n2:1 n1>n1:1 n2>n2:1 | D  | C n0 | S n0 | A 1
DO fill -1 0
EXPECT 1 0 "fill 95%"
STATE N n0@0.2,0.2 n1@0.8,0.2 n2@0.5,0.8 | R  | O n0:0:1 n1:1:1 n2:2:1 | L n0>n0:1 n0>n1:1 n0>n2:1 n0>~:0.157895 n1>n1:1 n2>n2:1 | D  | C n0 | S n0 | A 1
DO fill -1 0
EXPECT 1 0 "fill 90%"
STATE N n0@0.2,0.2 n1@0.8,0.2 n2@0.5,0.8 | R  | O n0:0:1 n1:1:1 n2:2:1 | L n0>n0:1 n0>n1:1 n0>n2:1 n0>~:0.333333 n1>n1:1 n2>n2:1 | D  | C n0 | S n0 | A 1
DO bindall
EXPECT 1 0 "bound 1 node to every output (3)"
STATE N n0@0.2,0.2 n1@0.8,0.2 n2@0.5,0.8 | R  | O n0:0:1 n1:1:1 n2:2:1 | L n0>n0:1 n0>n1:1 n0>n2:1 n0>~:0.333333 n1>n1:1 n2>n2:1 | D  | C n0 | S n0 | A 1
SEL only n1
SEL toggle n2
DO bindall
EXPECT 1 0 "bound 2 nodes to every output (3)"
STATE N n0@0.2,0.2 n1@0.8,0.2 n2@0.5,0.8 | R  | O n0:0:1 n1:1:1 n2:2:1 | L n0>n0:1 n0>n1:1 n0>n2:1 n0>~:0.333333 n1>n0:1 n1>n1:1 n1>n2:1 n2>n0:1 n2>n1:1 n2>n2:1 | D  | C n0 | S n0 | A 1
ENDEDIT

# shift-click selects several faders: b binds or unbinds every selected node to EVERY selected output, t and T trim them all, and removing an output needs exactly one selected. The set follows removals like the current output does
EDIT outputs_selected_together ANALYTIC
GRID FREE
DO place 0.2 0.2
EXPECT 1 0 ""
STATE N n0@0.2,0.2 | R  | O n0:0:1 | L n0>n0:1 | D  | C n0 | S n0 | A 1
DO place 0.8 0.2
EXPECT 1 0 ""
STATE N n0@0.2,0.2 n1@0.8,0.2 | R  | O n0:0:1 n1:1:1 | L n0>n0:1 n1>n1:1 | D  | C n0 | S n0 | A 1
DO place 0.5 0.8
EXPECT 1 0 ""
STATE N n0@0.2,0.2 n1@0.8,0.2 n2@0.5,0.8 | R  | O n0:0:1 n1:1:1 n2:2:1 | L n0>n0:1 n1>n1:1 n2>n2:1 | D  | C n0 | S n0 | A 1
DO place 0.5 0.45
EXPECT 1 0 ""
STATE N n0@0.2,0.2 n1@0.8,0.2 n2@0.5,0.8 n3@0.5,0.45 | R  | O n0:0:1 n1:1:1 n2:2:1 n3:3:1 | L n0>n0:1 n1>n1:1 n2>n2:1 n3>n3:1 | D  | C n0 | S n0 | A 1
DO pick n1
EXPECT 0 0 "current output: n1"
STATE N n0@0.2,0.2 n1@0.8,0.2 n2@0.5,0.8 n3@0.5,0.45 | R  | O n0:0:1 n1:1:1 n2:2:1 n3:3:1 | L n0>n0:1 n1>n1:1 n2>n2:1 n3>n3:1 | D  | C n1 | S n1 | A 1
DO toggleout n2
EXPECT 0 0 "outputs: n1, n2"
STATE N n0@0.2,0.2 n1@0.8,0.2 n2@0.5,0.8 n3@0.5,0.45 | R  | O n0:0:1 n1:1:1 n2:2:1 n3:3:1 | L n0>n0:1 n1>n1:1 n2>n2:1 n3>n3:1 | D  | C n2 | S n1,n2 | A 1
SEL only n3
DO bind
EXPECT 1 0 "bound 1 to n1, n2"
STATE N n0@0.2,0.2 n1@0.8,0.2 n2@0.5,0.8 n3@0.5,0.45 | R  | O n0:0:1 n1:1:1 n2:2:1 n3:3:1 | L n0>n0:1 n1>n1:1 n2>n2:1 n3>n3:1 n3>n1:1 n3>n2:1 | D  | C n2 | S n1,n2 | A 1
DO bind
EXPECT 1 0 "unbound 1 from n1, n2"
STATE N n0@0.2,0.2 n1@0.8,0.2 n2@0.5,0.8 n3@0.5,0.45 | R  | O n0:0:1 n1:1:1 n2:2:1 n3:3:1 | L n0>n0:1 n1>n1:1 n2>n2:1 n3>n3:1 | D  | C n2 | S n1,n2 | A 1
DO bind
EXPECT 1 0 "bound 1 to n1, n2"
STATE N n0@0.2,0.2 n1@0.8,0.2 n2@0.5,0.8 n3@0.5,0.45 | R  | O n0:0:1 n1:1:1 n2:2:1 n3:3:1 | L n0>n0:1 n1>n1:1 n2>n2:1 n3>n3:1 n3>n1:1 n3>n2:1 | D  | C n2 | S n1,n2 | A 1
DO trim -3
EXPECT 1 0 ""
