SEL only n0
LINKS n0>n1:0.5:1:0:1:0.35,0.55625
ENDEDIT

# a selected node that a derived output reads from is marked on that fader: a tap, a copy the node loses nothing to
EDIT derived_taps ANALYTIC
GRID FREE
DO example
EXPECT 1 0 ""
STATE N O@0.3,0.5 N@0.3,0.8 E@0.5,0.5 S@0.3,0.2 W@0.1,0.5 A@0.65,0.35 B@0.9,0.35 C@0.9,0.65 D@0.65,0.65 | R O,N,E O,E,S O,S,W O,W,N A,B,C,D | O front:0:1 left:1:1 right:2:1 rear:3:1 | L O>front:1 O>left:1 O>right:1 O>rear:1 N>front:1 E>right:1 S>rear:1 W>left:1 B>right:1 B>~:1 C>left:1 C>right:1 D>rear:1 D>~:0.333333 | D sub:4:N,O | C front | S front | A 1
SEL only N
TAPS sub
SEL only O
SEL toggle A
TAPS sub
SEL only A
TAPS NONE
ENDEDIT

# placing a node no longer moves the current output. It used to follow every new node, so b on the newest node unbound it from its own output and left it silent. An unbind that leaves a node with no output says so: by name for one node, by count for several, and as a warning
EDIT current_output_stays_put ANALYTIC
GRID FREE
DO place 0.2 0.2
EXPECT 1 0 ""
STATE N n0@0.2,0.2 | R  | O n0:0:1 | L n0>n0:1 | D  | C n0 | S n0 | A 1
DO place 0.8 0.2
EXPECT 1 0 ""
STATE N n0@0.2,0.2 n1@0.8,0.2 | R  | O n0:0:1 n1:1:1 | L n0>n0:1 n1>n1:1 | D  | C n0 | S n0 | A 1
DO pick n1
EXPECT 0 0 "current output: n1"
STATE N n0@0.2,0.2 n1@0.8,0.2 | R  | O n0:0:1 n1:1:1 | L n0>n0:1 n1>n1:1 | D  | C n1 | S n1 | A 1
DO place 0.5 0.8
EXPECT 1 0 ""
STATE N n0@0.2,0.2 n1@0.8,0.2 n2@0.5,0.8 | R  | O n0:0:1 n1:1:1 n2:2:1 | L n0>n0:1 n1>n1:1 n2>n2:1 | D  | C n1 | S n1 | A 1
SEL only n2
DO bind
EXPECT 1 0 "bound 1 to n1"
STATE N n0@0.2,0.2 n1@0.8,0.2 n2@0.5,0.8 | R  | O n0:0:1 n1:1:1 n2:2:1 | L n0>n0:1 n1>n1:1 n2>n2:1 n2>n1:1 | D  | C n1 | S n1 | A 1
DO bind
EXPECT 1 0 "unbound 1 from n1"
STATE N n0@0.2,0.2 n1@0.8,0.2 n2@0.5,0.8 | R  | O n0:0:1 n1:1:1 n2:2:1 | L n0>n0:1 n1>n1:1 n2>n2:1 | D  | C n1 | S n1 | A 1
DO pick n2
EXPECT 0 0 "current output: n2"
STATE N n0@0.2,0.2 n1@0.8,0.2 n2@0.5,0.8 | R  | O n0:0:1 n1:1:1 n2:2:1 | L n0>n0:1 n1>n1:1 n2>n2:1 | D  | C n2 | S n2 | A 1
DO bind
EXPECT 1 1 "unbound 1 from n2 -- n2 now silent; cmd-z undoes"
STATE N n0@0.2,0.2 n1@0.8,0.2 n2@0.5,0.8 | R  | O n0:0:1 n1:1:1 n2:2:1 | L n0>n0:1 n1>n1:1 | D  | C n2 | S n2 | A 1
DO undo
EXPECT 1 0 "undid binding"
STATE N n0@0.2,0.2 n1@0.8,0.2 n2@0.5,0.8 | R  | O n0:0:1 n1:1:1 n2:2:1 | L n0>n0:1 n1>n1:1 n2>n2:1 | D  | C n2 | S n2 | A 1
DO pick n0
EXPECT 0 0 "current output: n0"
STATE N n0@0.2,0.2 n1@0.8,0.2 n2@0.5,0.8 | R  | O n0:0:1 n1:1:1 n2:2:1 | L n0>n0:1 n1>n1:1 n2>n2:1 | D  | C n0 | S n0 | A 1
SEL only n1
DO bind
EXPECT 1 0 "bound 1 to n0"
STATE N n0@0.2,0.2 n1@0.8,0.2 n2@0.5,0.8 | R  | O n0:0:1 n1:1:1 n2:2:1 | L n0>n0:1 n1>n1:1 n1>n0:1 n2>n2:1 | D  | C n0 | S n0 | A 1
DO pick n1
EXPECT 0 0 "current output: n1"
STATE N n0@0.2,0.2 n1@0.8,0.2 n2@0.5,0.8 | R  | O n0:0:1 n1:1:1 n2:2:1 | L n0>n0:1 n1>n1:1 n1>n0:1 n2>n2:1 | D  | C n1 | S n1 | A 1
DO bind
EXPECT 1 0 "unbound 1 from n1"
STATE N n0@0.2,0.2 n1@0.8,0.2 n2@0.5,0.8 | R  | O n0:0:1 n1:1:1 n2:2:1 | L n0>n0:1 n1>n0:1 n2>n2:1 | D  | C n1 | S n1 | A 1
DO pick n0
EXPECT 0 0 "current output: n0"
STATE N n0@0.2,0.2 n1@0.8,0.2 n2@0.5,0.8 | R  | O n0:0:1 n1:1:1 n2:2:1 | L n0>n0:1 n1>n0:1 n2>n2:1 | D  | C n0 | S n0 | A 1
