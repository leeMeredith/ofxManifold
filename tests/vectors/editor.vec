DO place 0.65 0.585
EXPECT 1 0 ""
STATE N n0@0.2,0.5 n1@0.8,0.5 n2@0.35,0.585 n3@0.65,0.585 | R  | O n0:0:1 n1:1:1 n2:2:1 n3:3:1 | L n0>n0:1 n1>n1:1 n2>n2:1 n3>n3:1 | D  | C n0 | S n0 | A 1
DO place 0.5 0.415
EXPECT 1 0 ""
STATE N n0@0.2,0.5 n1@0.8,0.5 n2@0.35,0.585 n3@0.65,0.585 n4@0.5,0.415 | R  | O n0:0:1 n1:1:1 n2:2:1 n3:3:1 n4:4:1 | L n0>n0:1 n1>n1:1 n2>n2:1 n3>n3:1 n4>n4:1 | D  | C n0 | S n0 | A 1
DO pick n1
EXPECT 0 0 "current output: n1"
STATE N n0@0.2,0.5 n1@0.8,0.5 n2@0.35,0.585 n3@0.65,0.585 n4@0.5,0.415 | R  | O n0:0:1 n1:1:1 n2:2:1 n3:3:1 n4:4:1 | L n0>n0:1 n1>n1:1 n2>n2:1 n3>n3:1 n4>n4:1 | D  | C n1 | S n1 | A 1
SEL only n0
DO bind
EXPECT 1 0 "bound 1 to n1"
