DO place 0.5 0.8
EXPECT 1 0 ""
STATE N n0@0.2,0.2 n1@0.8,0.2 n2@0.5,0.8 | R  | O n0:0:1 n1:1:1 n2:2:1 | L n0>n0:1 n1>n1:1 n2>n2:1 | D  | C n0 | S n0 | A 1
DO pick n2
EXPECT 0 0 "current output: n2"
STATE N n0@0.2,0.2 n1@0.8,0.2 n2@0.5,0.8 | R  | O n0:0:1 n1:1:1 n2:2:1 | L n0>n0:1 n1>n1:1 n2>n2:1 | D  | C n2 | S n2 | A 1
SEL only n0
DO remove
EXPECT 1 0 "removed 1 node, and 1 output"
STATE N n1@0.8,0.2 n2@0.5,0.8 | R  | O n1:1:1 n2:2:1 | L n1>n1:1 n2>n2:1 | D  | C n2 | S n2 | A 1
SEL clear
SEL only n1
DO bind
EXPECT 1 0 "bound 1 to n2"
STATE N n1@0.8,0.2 n2@0.5,0.8 | R  | O n1:1:1 n2:2:1 | L n1>n1:1 n1>n2:1 n2>n2:1 | D  | C n2 | S n2 | A 1
ENDEDIT

