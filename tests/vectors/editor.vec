SEL only n0
LINKS n0>n1:0.3:1:1:1:0.35,0.25625 n0>n2:0.3:1:0:1:0.21875,0.378125 n1>n0:0.5:0:-1:-1:0.65,0.14375
SEL only n0
SEL toggle n1
LINKS n0>n1:0.3:1:1:1:0.35,0.25625 n0>n2:0.3:1:0:1:0.21875,0.378125 n1>n0:0.5:1:-1:-1:0.65,0.14375
SEL only n2
LINKS n0>n2:0.3:0:0:1:0.21875,0.378125
SEL only n3
LINKS NONE
SEL clear
LINKS NONE
SEL only n0
CONTRIB n0=0.5 n1=0.3 n2=0.2 EXPECT 0.15 0.15 0.15 0
SEL only n0
SEL toggle n1
CONTRIB n0=0.5 n1=0.3 n2=0.2 EXPECT 0.3 0.3 0.15 0
ENDEDIT

# a link arcs to the side with more CLEARANCE from other nodes, so a line never looks as if it connects to a node it passes. n2 sits just above the straight path from n0 to n1, so that line arcs BELOW; n2 to n3 has nothing near either side and takes +1; a mutual pair arcs to opposite sides. The point a quarter of the way from the sender is where its percentage goes
EDIT link_arcs_avoid_nodes ANALYTIC
GRID FREE
DO place 0.2 0.5
EXPECT 1 0 ""
STATE N n0@0.2,0.5 | R  | O n0:0:1 | L n0>n0:1 | D  | C n0 | S n0 | A 1
