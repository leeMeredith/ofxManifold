DO place 0.2 0.8
EXPECT 1 0 ""
STATE N n0@0.2,0.2 n1@0.8,0.2 n2@0.8,0.8 n3@0.2,0.8 | R  | O n0:0:1 n1:1:1 n2:2:1 n3:3:1 | L n0>n0:1 n1>n1:1 n2>n2:1 n3>n3:1 | D  | C n0 | S n0 | A 1
SEL clear
SEL box n0 n2 n1 n3
DO join
EXPECT 1 0 "joined 4 nodes in angle order"
STATE N n0@0.2,0.2 n1@0.8,0.2 n2@0.8,0.8 n3@0.2,0.8 | R n0,n1,n2,n3 | O n0:0:1 n1:1:1 n2:2:1 n3:3:1 | L n0>n0:1 n1>n1:1 n2>n2:1 n3>n3:1 | D  | C n0 | S n0 | A 1
SEL only n0
SEL toggle n2
SEL toggle n1
SEL toggle n3
DO unjoin
EXPECT 1 0 "unjoined 1 region"
STATE N n0@0.2,0.2 n1@0.8,0.2 n2@0.8,0.8 n3@0.2,0.8 | R  | O n0:0:1 n1:1:1 n2:2:1 n3:3:1 | L n0>n0:1 n1>n1:1 n2>n2:1 n3>n3:1 | D  | C n0 | S n0 | A 1
SEL only n0
SEL toggle n2
SEL toggle n1
