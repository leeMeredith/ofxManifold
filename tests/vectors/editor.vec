DO stepvalue -1 0
EXPECT 1 0 "distance 0.5"
STATE N O@0.3,0.5 N@0.3,0.8 E@0.5,0.5 S@0.3,0.2 W@0.1,0.5 A@0.65,0.35 B@0.9,0.35 C@0.9,0.65 D@0.65,0.65 | R O,N,E O,E,S O,S,W O,W,N A,B,C,D | O front:0:1 left:1:1 right:2:1 rear:3:1 | L O>front:1 O>left:1 O>right:1 O>rear:1 N>front:1 E>right:1 S>rear:1 W>left:1 B>right:1 B>~:1 C>left:1 C>right:1 D>rear:1 D>~:0.333333 | D sub:4:N,O | C front | S front | A 1 | U 1 reverb:0:1:0 distance:0:10:0 pan:-1:1:-1 | X0 distance/O=0.6 distance/N=0.5
DO editvalue "far 0 4"
EXPECT 1 0 "value far, 0 to 4"
STATE N O@0.3,0.5 N@0.3,0.8 E@0.5,0.5 S@0.3,0.2 W@0.1,0.5 A@0.65,0.35 B@0.9,0.35 C@0.9,0.65 D@0.65,0.65 | R O,N,E O,E,S O,S,W O,W,N A,B,C,D | O front:0:1 left:1:1 right:2:1 rear:3:1 | L O>front:1 O>left:1 O>right:1 O>rear:1 N>front:1 E>right:1 S>rear:1 W>left:1 B>right:1 B>~:1 C>left:1 C>right:1 D>rear:1 D>~:0.333333 | D sub:4:N,O | C front | S front | A 1 | U 1 reverb:0:1:0 far:0:4:0 pan:-1:1:-1 | X0 far/O=0.6 far/N=0.5
VALUELINE EXPECT "far 0 4"
# narrowed to 1..2: O at 0.6 and N at 0.5 come up to 1, and so
# does the fallback every other node reads
DO editvalue "far 1 2"
