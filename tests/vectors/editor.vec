# undo and redo over whole-state snapshots. Refusals and cursor moves are never steps; a new action discards the redo steps; undoing a delete restores the node, its output and its bindings, renumbering and all
EDIT undo_redo ANALYTIC
GRID FREE
DO undo
EXPECT 0 1 "nothing to undo"
STATE N  | R  | O  | L  | D  | C - | S - | A 1
DO place 0.2 0.2
EXPECT 1 0 ""
STATE N n0@0.2,0.2 | R  | O n0:0:1 | L n0>n0:1 | D  | C n0 | S n0 | A 1
DO place 0.8 0.2
EXPECT 1 0 ""
STATE N n0@0.2,0.2 n1@0.8,0.2 | R  | O n0:0:1 n1:1:1 | L n0>n0:1 n1>n1:1 | D  | C n0 | S n0 | A 1
DO place 0.5 0.8
EXPECT 1 0 ""
STATE N n0@0.2,0.2 n1@0.8,0.2 n2@0.5,0.8 | R  | O n0:0:1 n1:1:1 n2:2:1 | L n0>n0:1 n1>n1:1 n2>n2:1 | D  | C n0 | S n0 | A 1
SEL only n0
SEL toggle n1
SEL toggle n2
DO join
EXPECT 1 0 "joined 3 nodes in click order"
STATE N n0@0.2,0.2 n1@0.8,0.2 n2@0.5,0.8 | R n0,n1,n2 | O n0:0:1 n1:1:1 n2:2:1 | L n0>n0:1 n1>n1:1 n2>n2:1 | D  | C n0 | S n0 | A 1
DO undo
EXPECT 1 0 "undid join"
STATE N n0@0.2,0.2 n1@0.8,0.2 n2@0.5,0.8 | R  | O n0:0:1 n1:1:1 n2:2:1 | L n0>n0:1 n1>n1:1 n2>n2:1 | D  | C n0 | S n0 | A 1
DO undo
EXPECT 1 0 "undid place"
STATE N n0@0.2,0.2 n1@0.8,0.2 | R  | O n0:0:1 n1:1:1 | L n0>n0:1 n1>n1:1 | D  | C n0 | S n0 | A 1
DO redo
EXPECT 1 0 "redid place"
STATE N n0@0.2,0.2 n1@0.8,0.2 n2@0.5,0.8 | R  | O n0:0:1 n1:1:1 n2:2:1 | L n0>n0:1 n1>n1:1 n2>n2:1 | D  | C n0 | S n0 | A 1
DO place 0.2004 0.2
EXPECT 0 1 "a node is already there"
STATE N n0@0.2,0.2 n1@0.8,0.2 n2@0.5,0.8 | R  | O n0:0:1 n1:1:1 n2:2:1 | L n0>n0:1 n1>n1:1 n2>n2:1 | D  | C n0 | S n0 | A 1
DO cycle
EXPECT 0 0 "current output: n1"
STATE N n0@0.2,0.2 n1@0.8,0.2 n2@0.5,0.8 | R  | O n0:0:1 n1:1:1 n2:2:1 | L n0>n0:1 n1>n1:1 n2>n2:1 | D  | C n1 | S n1 | A 1
DO undo
EXPECT 1 0 "undid place"
STATE N n0@0.2,0.2 n1@0.8,0.2 | R  | O n0:0:1 n1:1:1 | L n0>n0:1 n1>n1:1 | D  | C n0 | S n0 | A 1
DO place 0.9 0.9
EXPECT 1 0 ""
STATE N n0@0.2,0.2 n1@0.8,0.2 n2@0.9,0.9 | R  | O n0:0:1 n1:1:1 n2:2:1 | L n0>n0:1 n1>n1:1 n2>n2:1 | D  | C n0 | S n0 | A 1
DO redo
EXPECT 0 1 "nothing to redo"
STATE N n0@0.2,0.2 n1@0.8,0.2 n2@0.9,0.9 | R  | O n0:0:1 n1:1:1 n2:2:1 | L n0>n0:1 n1>n1:1 n2>n2:1 | D  | C n0 | S n0 | A 1
SEL only n0
DO remove
EXPECT 1 0 "removed 1 node, and 1 output"
STATE N n1@0.8,0.2 n2@0.9,0.9 | R  | O n1:1:1 n2:2:1 | L n1>n1:1 n2>n2:1 | D  | C n1 | S n1 | A 1
SEL clear
DO undo
EXPECT 1 0 "undid delete"
STATE N n0@0.2,0.2 n1@0.8,0.2 n2@0.9,0.9 | R  | O n0:0:1 n1:1:1 n2:2:1 | L n0>n0:1 n1>n1:1 n2>n2:1 | D  | C n0 | S n0 | A 1
SEL only n1
DO move n1 0.7 0.3
EXPECT 1 0 ""
STATE N n0@0.2,0.2 n1@0.7,0.3 n2@0.9,0.9 | R  | O n0:0:1 n1:1:1 n2:2:1 | L n0>n0:1 n1>n1:1 n2>n2:1 | D  | C n0 | S n0 | A 1
DO undo
EXPECT 1 0 "undid move"
STATE N n0@0.2,0.2 n1@0.8,0.2 n2@0.9,0.9 | R  | O n0:0:1 n1:1:1 n2:2:1 | L n0>n0:1 n1>n1:1 n2>n2:1 | D  | C n0 | S n0 | A 1
DO empty
EXPECT 1 0 ""
STATE N  | R  | O  | L  | D  | C - | S - | A 1
DO undo
EXPECT 1 0 "undid new map"
STATE N n0@0.2,0.2 n1@0.8,0.2 n2@0.9,0.9 | R  | O n0:0:1 n1:1:1 n2:2:1 | L n0>n0:1 n1>n1:1 n2>n2:1 | D  | C n0 | S n0 | A 1
ENDEDIT

