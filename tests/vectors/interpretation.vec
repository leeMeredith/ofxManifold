# ofxManifold interpretation layer conformance vectors
# GENERATED by tests/ref/reference_interpretation.py -- do not hand edit
#
# The C++ and this reference use different formulations where a
# difference is possible: cosine via sin(w*pi/2) vs cos((1-w)*pi/2),
# blend merge by linear scan vs by dict, spread as seeded floor vs
# explicit lerp. Where sqrt is simply sqrt, the vectors are ANALYTIC
# and state their expected values by hand.

TOL 1e-06

# linear is the identity. Anything else means apply() is not
# leaving the weights alone.
CURVE linear_is_identity ANALYTIC linear IN 0=0.2 1=0.5 2=0.3 OUT 0=0.2 1=0.5 2=0.3

# sqrt(0.25) is exactly 0.5 and sqrt(0.75) is not -- an
# asymmetric input so a swapped pair cannot pass
CURVE equalpower_quarter ANALYTIC equalPower IN 0=0.25 1=0.75 OUT 0=0.5 1=0.8660254038

# both endpoints are fixed points of every curve: fn(0)==0 and
# fn(1)==1. blend relies on this for its endpoint identities.
CURVE endpoints_linear ANALYTIC linear IN 0=0 1=1 OUT 0=0 1=1
CURVE endpoints_equalPower ANALYTIC equalPower IN 0=0 1=1 OUT 0=0 1=1
CURVE endpoints_cosine ANALYTIC cosine IN 0=0 1=1 OUT 0=0 1=1

CURVE cosine_half ANALYTIC cosine IN 0=0.5 1=0.5 OUT 0=0.7071067812 1=0.7071067812

# Non-contiguous, non-zero-based node IDs. Every other vector
# here uses 0,1,2, which an implementation that REINDEXES its
# output would satisfy by accident. Identity is the thing the
# whole architecture is built to retain, so it gets a case
# where losing it is visible.
CURVE identity_sparse_ids ANALYTIC linear IN 5=0.25 2=0.5 9=0.25 OUT 5=0.25 2=0.5 9=0.25
CURVE equalpower_sparse_ids CROSS equalPower IN 5=0.25 2=0.5 9=0.25 OUT 5=0.5 2=0.7071067812 9=0.5

CURVE equalpower_three CROSS equalPower IN 0=0.2 1=0.5 2=0.3 OUT 0=0.4472135955 1=0.7071067812 2=0.5477225575
CURVE cosine_three CROSS cosine IN 0=0.2 1=0.5 2=0.3 OUT 0=0.3090169944 1=0.7071067812 2=0.4539904997

# Constant power. For a TWO-node vector summing to one, both
# equalPower and cosine produce gains whose squares sum to one.
# This is the whole reason equal-power exists, so it is asserted
# directly rather than inferred from the values above.
POWER power_equalpower_two ANALYTIC equalPower IN 0=0.5 1=0.5 SUMSQ 1.0
POWER power_cosine_two ANALYTIC cosine IN 0=0.5 1=0.5 SUMSQ 1.0
POWER power_equalpower_asym ANALYTIC equalPower IN 0=0.25 1=0.75 SUMSQ 1.0

# For THREE nodes the two curves diverge -- equalPower still
# sums its squares to one, cosine does not. They are different
# instruments, not two spellings of one.
POWER power_equalpower_three ANALYTIC equalPower IN 0=0.2 1=0.5 2=0.3 SUMSQ 1.0
POWER power_cosine_three CROSS cosine IN 0=0.2 1=0.5 2=0.3 SUMSQ 0.8015988767

# A curve must NOT renormalize. equalPower on a vector summing
# to one gives a sum well above one, and that is correct: it
# preserves power instead. Renormalizing here would undo the
# only thing the curve was for.
SUM sum_after_equalpower SPEC equalPower IN 0=0.5 1=0.5 SUM 1.414213562

# normalize() restores partition of unity when a caller
# explicitly asks, discarding the power property to do it
NORMALIZE normalize_after_curve SPEC equalPower IN 0=0.5 1=0.5 OUT 0=0.5 1=0.5

# spread 0 is the identity, and preserves sparsity: the common
# case must cost nothing
SPREAD spread_zero ANALYTIC 0.0 5 IN 0=0.2 1=0.5 2=0.3 OUT 0=0.2 1=0.5 2=0.3

# spread 1 is uniform over every node in the map, regardless of
# what the point was doing
SPREAD spread_full ANALYTIC 1.0 5 IN 0=0.2 1=0.5 2=0.3 OUT 0=0.2 1=0.2 2=0.2 3=0.2 4=0.2

# halfway: the localized part halved, plus a uniform floor
SPREAD spread_half CROSS 0.5 5 IN 0=0.2 1=0.5 2=0.3 OUT 0=0.2 1=0.35 2=0.25 3=0.1 4=0.1
SPREAD spread_quarter CROSS 0.25 4 IN 0=0.5 1=0.5 OUT 0=0.4375 1=0.4375 2=0.0625 3=0.0625

# spread must preserve partition of unity at every amount --
# it is a linear interpolation between two vectors that each
# sum to one, so the result does too
SPREADSUM spreadsum_0_1 ANALYTIC 0.1 5 IN 0=0.2 1=0.5 2=0.3 SUM 1.0
SPREADSUM spreadsum_0_33 ANALYTIC 0.33 5 IN 0=0.2 1=0.5 2=0.3 SUM 1.0
SPREADSUM spreadsum_0_5 ANALYTIC 0.5 5 IN 0=0.2 1=0.5 2=0.3 SUM 1.0
SPREADSUM spreadsum_0_9 ANALYTIC 0.9 5 IN 0=0.2 1=0.5 2=0.3 SUM 1.0

# sparse IDs through spread: the localized part must land on
# the nodes it names, not on the first few slots
SPREAD spread_sparse_ids CROSS 0.4 12 IN 7=0.6 3=0.4 OUT 0=0.03333333333 1=0.03333333333 2=0.03333333333 3=0.2733333333 4=0.03333333333 5=0.03333333333 6=0.03333333333 7=0.3933333333 8=0.03333333333 9=0.03333333333 10=0.03333333333 11=0.03333333333

# amounts outside [0,1] clamp rather than extrapolating into
# negative weights
SPREAD spread_clamps_high SPEC 1.5 5 IN 0=0.2 1=0.5 2=0.3 OUT 0=0.2 1=0.2 2=0.2 3=0.2 4=0.2
SPREAD spread_clamps_low SPEC -0.5 5 IN 0=0.2 1=0.5 2=0.3 OUT 0=0.2 1=0.5 2=0.3

# blend endpoints are identities for every curve, because every
# curve fixes 0 and 1
BLEND blend_t0_linear ANALYTIC 0.0 linear A 0=0.6 1=0.4 B 2=0.3 3=0.7 OUT 0=0.6 1=0.4
BLEND blend_t1_linear ANALYTIC 1.0 linear A 0=0.6 1=0.4 B 2=0.3 3=0.7 OUT 2=0.3 3=0.7
BLEND blend_t0_equalPower ANALYTIC 0.0 equalPower A 0=0.6 1=0.4 B 2=0.3 3=0.7 OUT 0=0.6 1=0.4
BLEND blend_t1_equalPower ANALYTIC 1.0 equalPower A 0=0.6 1=0.4 B 2=0.3 3=0.7 OUT 2=0.3 3=0.7
BLEND blend_t0_cosine ANALYTIC 0.0 cosine A 0=0.6 1=0.4 B 2=0.3 3=0.7 OUT 0=0.6 1=0.4
BLEND blend_t1_cosine ANALYTIC 1.0 cosine A 0=0.6 1=0.4 B 2=0.3 3=0.7 OUT 2=0.3 3=0.7

# disjoint node sets, which is the normal case when the two
# vectors come from two different manifolds
BLEND blend_disjoint_half CROSS 0.5 linear A 0=0.6 1=0.4 B 2=0.3 3=0.7 OUT 0=0.3 1=0.2 2=0.15 3=0.35

# overlapping node sets: shared nodes accumulate rather than
# one input winning
BLEND blend_overlap CROSS 0.5 linear A 0=0.6 1=0.4 B 1=0.5 2=0.5 OUT 0=0.3 1=0.45 2=0.25

# blending a vector with itself must return it unchanged at any
# t under the linear curve -- a merge that dropped or doubled
# shared nodes fails here and nowhere else
BLEND blend_self_0_25 ANALYTIC 0.25 linear A 0=0.2 1=0.5 2=0.3 B 0=0.2 1=0.5 2=0.3 OUT 0=0.2 1=0.5 2=0.3
BLEND blend_self_0_5 ANALYTIC 0.5 linear A 0=0.2 1=0.5 2=0.3 B 0=0.2 1=0.5 2=0.3 OUT 0=0.2 1=0.5 2=0.3
BLEND blend_self_0_75 ANALYTIC 0.75 linear A 0=0.2 1=0.5 2=0.3 B 0=0.2 1=0.5 2=0.3 OUT 0=0.2 1=0.5 2=0.3

# constant-power crossfade: with equalPower the two gains'
# squares sum to one, so a source moving between two maps holds
# its power through the transition
BLEND blend_equalpower_half CROSS 0.5 equalPower A 0=0.6 1=0.4 B 2=0.3 3=0.7 OUT 0=0.4242640687 1=0.2828427125 2=0.2121320344 3=0.4949747468
BLEND blend_cosine_third CROSS 0.3333333333333333 cosine A 0=0.6 1=0.4 B 2=0.3 3=0.7 OUT 0=0.5196152423 1=0.3464101615 2=0.15 3=0.35

# a linear blend of two vectors that each sum to one also sums
# to one; an equal-power blend does NOT, and must not be
# corrected into doing so
BLENDSUM blendsum_linear ANALYTIC 0.5 linear A 0=0.6 1=0.4 B 2=0.3 3=0.7 SUM 1.0
BLENDSUM blendsum_equalpower SPEC 0.5 equalPower A 0=0.6 1=0.4 B 2=0.3 3=0.7 SUM 1.414213562

# sparse IDs through blend, including one node shared between
# the two inputs at a non-zero index
BLEND blend_sparse_ids CROSS 0.5 linear A 4=0.6 8=0.4 B 8=0.5 1=0.5 OUT 4=0.3 8=0.45 1=0.25


# INTERPOLATION: weights + values -> value. The operation the
# addon's own one-line description promises, and the one that
# was missing from the first five layers because the
# architecture treated mapping as the only consumer of a
# weight vector. See DECISIONS.md D-009.

# at a vertex the result is exactly that vertex's value
INTERP interp_vertex_0 ANALYTIC IN 0=1 VALUES 10 20 30 OUT 10
INTERP interp_vertex_1 ANALYTIC IN 1=1 VALUES 10 20 30 OUT 20
INTERP interp_vertex_2 ANALYTIC IN 2=1 VALUES 10 20 30 OUT 30

# at the centroid, exactly the mean: (10+20+30)/3 = 20
INTERP interp_centroid ANALYTIC IN 0=0.3333333333 1=0.3333333333 2=0.3333333333 VALUES 10 20 30 OUT 20

# half of the first and half of the third: exactly 20
INTERP interp_half ANALYTIC IN 0=0.5 2=0.5 VALUES 10 20 30 OUT 20

# an ordinary interior blend
INTERP interp_uneven CROSS IN 0=0.2 1=0.5 2=0.3 VALUES 10 20 30 OUT 21

# sparse, non-zero-based ids, indexing into a longer value
# array. An implementation that walked the values positionally
# instead of by node id would pass every case above and fail
# here (D-004)
INTERP interp_sparse_ids CROSS IN 5=0.25 2=0.5 9=0.25 VALUES 0 100 200 300 400 500 600 700 800 900 OUT 450

# weights summing BELOW one, as a null node produces. The
# result scales toward zero, which is the fade a null node
# exists to create. Normalizing internally would silently
# remove it, so interpolate() does not.
INTERP interp_short_sum SPEC IN 0=0.3 1=0.3 VALUES 10 20 30 OUT 9
COVERAGE coverage_short ANALYTIC IN 0=0.3 1=0.3 N 3 OUT 0.6
COVERAGE coverage_full ANALYTIC IN 0=0.2 1=0.5 2=0.3 N 3 OUT 1

# a node id past the end of the value array contributes
# nothing rather than reading past it
INTERP interp_out_of_range SPEC IN 0=0.5 99=0.5 VALUES 10 20 30 OUT 5
COVERAGE coverage_out_of_range ANALYTIC IN 0=0.5 99=0.5 N 3 OUT 0.5

# THE FOOTGUN, recorded rather than prevented. equalPower
# turns weights into gains whose squares sum to one, so the
# sum rises above one and the interpolated result is scaled
# up. Almost never wanted: curve gains are not blend
# coefficients. normalize() first, or do not curve weights
# you intend to interpolate with.
INTERP interp_after_curve SPEC IN 0=0.7071067812 1=0.7071067812 VALUES 10 20 30 OUT 21.21320344
# and normalizing first restores the affine result
INTERP interp_curve_normalized SPEC IN 0=0.5 1=0.5 VALUES 10 20 30 OUT 15

# t outside [0,1] clamps
BLEND blend_clamps_high SPEC 2.0 linear A 0=0.6 1=0.4 B 2=0.3 3=0.7 OUT 2=0.3 3=0.7
BLEND blend_clamps_low SPEC -1.0 linear A 0=0.6 1=0.4 B 2=0.3 3=0.7 OUT 0=0.6 1=0.4
