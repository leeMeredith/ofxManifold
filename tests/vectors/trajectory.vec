# ofxManifold trajectory conformance vectors
# GENERATED by tests/ref/reference_trajectory.py -- do not hand edit
#
# The C++ brackets samples with std::upper_bound; this walks
# the list. Same answer, different traversal.

TOL 1e-06

# a path recorded at even intervals, finalized to [0, 1]
TRAJ even 0:0.1,0.1 0.5:0.5,0.9 1:0.9,0.1

# finalize maps the first sample to 0 and the last to 1
AT at_start ANALYTIC even 0 0.1 0.1
AT at_end ANALYTIC even 1 0.9 0.1
# the middle sample landed at exactly 0.5
AT at_middle_sample ANALYTIC even 0.5 0.5 0.9
# halfway between two samples is their midpoint
AT at_quarter ANALYTIC even 0.25 0.3 0.5
AT at_three_quarter ANALYTIC even 0.75 0.7 0.5

# outside [0, 1] CLAMPS rather than extrapolating. A path
# records where a source went; inventing where it would have
# gone next is a different operation, asked for explicitly.
AT before_start SPEC even -2 0.1 0.1
AT after_end SPEC even 3.5 0.9 0.1

# A PAUSE. The source moved for two units, held still for six,
# then moved again. finalize preserves the SPACING, so the
# pause survives as a pause. Uniform resampling would quietly
# turn it into a slow drift, which is a performance destroyed
# by a convenience.
TRAJ paused 0:0.1,0.5 0.2:0.5,0.5 0.8:0.5,0.5 1:0.9,0.5
AT pause_before ANALYTIC paused 0.2 0.5 0.5
# anywhere in the held span returns the same point
AT pause_a ANALYTIC paused 0.3 0.5 0.5
AT pause_b ANALYTIC paused 0.5 0.5 0.5
AT pause_c ANALYTIC paused 0.75 0.5 0.5

# RECORDING: raw times in, finalized times out. These call
# addSample() and finalize() rather than handing over finished
# samples, which is the only way those two functions are
# exercised at all (D-011).

# evenly spaced: 0, 0.5, 1
RECORD record_even ANALYTIC 0:0.1,0.1 1:0.5,0.9 2:0.9,0.1 EXPECT 0 0.5 1

# recording that began at t=17.5 must still finalize to start at 0. Subtracting the first time is what makes a path portable between sessions rather than carrying a stopwatch reading around
RECORD record_offset_start ANALYTIC 17.5:0.1,0.1 18.5:0.5,0.9 19.5:0.9,0.1 EXPECT 0 0.5 1

# THE PAUSE, through the recording path. Held still for six of ten units, so the finalized times must be 0, 0.2, 0.8, 1. Uniform resampling would give 0, 0.333, 0.667, 1 and turn a held position into a slow drift
RECORD record_pause ANALYTIC 0:0.1,0.5 2:0.5,0.5 8:0.5,0.5 10:0.9,0.5 EXPECT 0 0.2 0.8 1

# irregular spacing, as a real recording produces
RECORD record_irregular CROSS 0:0.2,0.2 0.3:0.4,0.5 2.9:0.6,0.3 3.1:0.8,0.7 7:0.5,0.5 EXPECT 0 0.04285714286 0.4142857143 0.4428571429 1

# time running backwards is clamped to the previous sample
# rather than stored. A frame arriving out of order should not
# be able to corrupt the bracketing search downstream.
RECORDBACK record_backwards SPEC 0:0.1,0.1 5:0.5,0.5 3:0.9,0.9 10:0.2,0.8 EXPECT 0 0.5 0.5 1

# a single sample: every t returns it, no division by zero
TRAJ single 0:0.33,0.44
AT single_zero ANALYTIC single 0 0.33 0.44
AT single_mid ANALYTIC single 0.5 0.33 0.44
AT single_one ANALYTIC single 1 0.33 0.44

# every sample at the same instant: timing was lost, but the
# path still has shape, so the samples spread evenly rather
# than dividing by zero
TRAJ coincident 0:0.2,0.2 1:0.8,0.8
AT coincident_start SPEC coincident 0 0.2 0.2
AT coincident_end SPEC coincident 1 0.8 0.8
AT coincident_mid SPEC coincident 0.5 0.5 0.5

#--------------------------------------------------------------------
# THE TOURING CASE
#
# SpaceMap renders a move in real time during the show, so a
# touring production builds a NEW map for the new rig and
# replays its existing cues untouched. The map changes; the
# trajectory does not.
#
# That only works because a trajectory lives in the manifold's
# own normalized space (section 5). A path in screen pixels
# could not survive a change of window, let alone of venue.
#
# Below: ONE path, TWO maps. The positions must be identical
# and the weights must differ. Until these vectors existed,
# nothing in the project asserted the property the coordinate
# decision was made for.
#--------------------------------------------------------------------

TRAJ tour 0:0.3,0.3 0.3333333333:0.5,0.55 0.6666666667:0.7,0.35 1:0.5,0.25

# t = 0.0: same point, both venues
TOUR tour_t00 CROSS tour 0 0.3 0.3 venue_a.json C=0.1 A=0.5 O=0.4 venue_b.json A=0.6818181818 B=0.2272727273 O=0.09090909091
# t = 0.25: same point, both venues
TOUR tour_t25 CROSS tour 0.25 0.45 0.4875 venue_a.json C=0.25 A=0.125 O=0.625 venue_b.json A=0.2181818182 B=0.02272727273 O=0.7590909091
# t = 0.5: same point, both venues
TOUR tour_t50 CROSS tour 0.5 0.6 0.45 venue_a.json B=0.25 C=0.25 O=0.5 venue_b.json A=0.08181818182 B=0.2272727273 O=0.6909090909
# t = 0.75: same point, both venues
TOUR tour_t75 CROSS tour 0.75 0.65 0.325 venue_a.json B=0.375 C=0.075 O=0.55 venue_b.json A=0.2 B=0.5 O=0.3
# t = 1.0: same point, both venues
TOUR tour_t100 CROSS tour 1 0.5 0.25 venue_a.json A=0.25 B=0.25 O=0.5 venue_b.json A=0.5 B=0.5 O=2.523234147e-17

# The invariant itself, stated rather than inferred: replaying
# the same trajectory against two maps yields IDENTICAL
# positions at every t. A trajectory that quietly depended on
# the map it was recorded against would fail here and nowhere
# else in the suite.
PORTABLE portable_positions ANALYTIC tour venue_a.json venue_b.json

# and the weights must genuinely DIFFER, or the two venues are
# the same venue and the test proves nothing
DIFFERS weights_differ ANALYTIC tour venue_a.json venue_b.json

# round trip through the trajectory file format
ROUNDTRIP roundtrip_tour ANALYTIC tour.json

# time running backwards would make the bracketing search
# meaningless, and the failure would look like a jittering
# playhead rather than a bad file
REJECT reject_backwards ANALYTIC bad_traj_backwards.json non-decreasing
REJECT reject_short_point ANALYTIC bad_traj_short_point.json two-element
REJECT reject_no_samples ANALYTIC bad_traj_no_samples.json missing
