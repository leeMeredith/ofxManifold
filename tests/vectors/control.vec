# silent past its silence, a held point goes back, the holder told;
# a move keeps it; the hand always wins, the holder told
SCRIPT silence_and_hand SPEC - PLAN all PREFIX /manifold/room EXTENT 0 0.5 2
RECV 0 127.0.0.1 57120 /manifold/room/point/1/take i:1 i:9002 OURS 1 EXPECT MOVES EVENTS Taken 1 - 127.0.0.1:57120 ; REPLIES 127.0.0.1:9002 /manifold/room/point/1/reply i:1 i:1 s:take s: ; ACCEPTED 1 REFUSED 0 LAST -
TICK 4.9000001 EXPECT MOVES EVENTS REPLIES ACCEPTED 1 REFUSED 0 LAST -
RECV 5 127.0.0.1 57120 /manifold/room/point/1/xy f:0.5 f:0.5 OURS 1 EXPECT MOVES 1 xy 0.5 0.5 ; EVENTS REPLIES ACCEPTED 2 REFUSED 0 LAST -
TICK 9.89999962 EXPECT MOVES EVENTS REPLIES ACCEPTED 2 REFUSED 0 LAST -
TICK 10.1000004 EXPECT MOVES EVENTS Returned 1 silent 127.0.0.1:57120 ; REPLIES 127.0.0.1:9002 /manifold/room/point/1/lost s:silent ; ACCEPTED 2 REFUSED 0 LAST -
RECV 10.1999998 127.0.0.1 57120 /manifold/room/point/1/take i:2 i:9002 OURS 1 EXPECT MOVES EVENTS Taken 1 - 127.0.0.1:57120 ; REPLIES 127.0.0.1:9002 /manifold/room/point/1/reply i:2 i:1 s:take s: ; ACCEPTED 3 REFUSED 0 LAST -
HAND 1 EXPECT MOVES EVENTS Returned 1 hand 127.0.0.1:57120 ; REPLIES 127.0.0.1:9002 /manifold/room/point/1/lost s:hand ; ACCEPTED 3 REFUSED 0 LAST -
HAND 1 EXPECT MOVES EVENTS REPLIES ACCEPTED 3 REFUSED 0 LAST -
RECV 10.3000002 127.0.0.1 57120 /manifold/room/point/1/xy f:0.5 f:0.5 OURS 1 EXPECT MOVES EVENTS REPLIES ACCEPTED 3 REFUSED 1 LAST not_held
END

# a point by its name or its number; a controller's 0..127 onto
# the map; an inlet the file closed is refused; held until
# released when its silence is 2, past 2
SCRIPT named_ranged_and_closed SPEC lead.json PLAN all PREFIX /manifold/room EXTENT -0.25 0.75 2
RECV 0 127.0.0.1 57120 /manifold/room/point/lead/take i:1 i:0 OURS 1 EXPECT MOVES EVENTS Taken 1 - 127.0.0.1:57120 ; REPLIES 127.0.0.1:57120 /manifold/room/point/1/reply i:1 i:1 s:take s: ; ACCEPTED 1 REFUSED 0 LAST -
RECV 0.100000001 127.0.0.1 57120 /manifold/room/point/lead/xy i:0 f:127.0 OURS 1 EXPECT MOVES 1 xy 0 1 ; EVENTS REPLIES ACCEPTED 2 REFUSED 0 LAST -
RECV 0.200000003 127.0.0.1 57120 /manifold/room/point/1/xy f:63.5 f:31.75 OURS 1 EXPECT MOVES 1 xy 0.5 0.25 ; EVENTS REPLIES ACCEPTED 3 REFUSED 0 LAST -
RECV 0.300000012 127.0.0.1 57120 /manifold/room/point/lead/z f:0.5 OURS 1 EXPECT MOVES 1 z 0.25 ; EVENTS REPLIES ACCEPTED 4 REFUSED 0 LAST -
RECV 0.400000006 127.0.0.1 57120 /manifold/room/point/lead/z f:2.0 OURS 1 EXPECT MOVES 1 z 0.75 ; EVENTS REPLIES ACCEPTED 5 REFUSED 0 LAST -
RECV 0.5 127.0.0.1 57120 /manifold/room/point/lead/u f:1.0 OURS 1 EXPECT MOVES EVENTS REPLIES ACCEPTED 5 REFUSED 1 LAST u_closed
RECV 0.600000024 127.0.0.1 57120 /manifold/room/point/lead/xyz f:1.0 f:1.0 f:1.0 OURS 1 EXPECT MOVES EVENTS REPLIES ACCEPTED 5 REFUSED 2 LAST xyz_closed
RECV 0.699999988 127.0.0.1 57120 /manifold/room/point/Lead/take i:2 i:0 OURS 1 EXPECT MOVES EVENTS REPLIES ACCEPTED 5 REFUSED 3 LAST no_such_point
TICK 2.5999999 EXPECT MOVES EVENTS Returned 1 silent 127.0.0.1:57120 ; REPLIES 127.0.0.1:57120 /manifold/room/point/1/lost s:silent ; ACCEPTED 5 REFUSED 3 LAST no_such_point
TICK 2.79999995 EXPECT MOVES EVENTS REPLIES ACCEPTED 5 REFUSED 3 LAST no_such_point
END

