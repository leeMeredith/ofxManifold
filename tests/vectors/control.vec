# control.vec -- points moved from outside, round 3B-2f
# generated by tests/ref/reference_control.py; checked by
# tests/run_control.cpp against ofxManifoldPlayer's PointControl
# and loadControl / saveControl.
#
# FILE name file OK|REFUSED reason   -- loadControl, for N points
# ROUND name file EXPECT-FILE file   -- read, written: exactly that
# SCRIPT ... RECV/TICK/HAND ... EXPECT <moves events replies counts>

# ---- the control file ----
FILE default.json 16 OK -
FILE lead.json 16 OK -
FILE u_only.json 16 OK -
FILE two.json 16 OK -
FILE version.json 16 REFUSED missing or unsupported control version
FILE no_points.json 16 REFUSED points must be a list of at least one
FILE extra_key.json 16 REFUSED unknown key: x
FILE order.json 16 REFUSED point 1: numbered out of order
FILE bad_name.json 16 REFUSED point 1: a name is a letter
FILE long_name.json 16 REFUSED point 1: a name is a letter
FILE twice_name.json 16 REFUSED point 2: the name a is taken
FILE inlet.json 16 REFUSED point 1: unknown inlet: w
FILE inlet_twice.json 16 REFUSED point 1: the inlet z twice
FILE range_axis.json 16 REFUSED point 1: unknown range axis: w
FILE range_order.json 16 REFUSED point 1: a range's low must be below its high
FILE range_shape.json 16 REFUSED point 1: a range is two numbers
FILE silence.json 16 REFUSED point 1: silence is 0 or more seconds
FILE point_key.json 16 REFUSED point 1: unknown key: speed
FILE seventeen.json 16 REFUSED at most 16 points
# a player with one point refuses a file with two
FILE two.json 1 REFUSED this player has 1 point
FILE not_json.json 16 REFUSED json
# read and written again: the player's own form, exactly
ROUND default.json EXPECT-FILE default.saved.json
ROUND lead.json EXPECT-FILE lead.saved.json
ROUND u_only.json EXPECT-FILE u_only.saved.json
ROUND two.json EXPECT-FILE two.saved.json

# take, move, release: answered to the reply port; moves from the
# holder only, not answered; z and u held to the levels
SCRIPT take_move_release SPEC - PLAN all PREFIX /manifold/room EXTENT 0 0.5 2
RECV 0 127.0.0.1 57120 /manifold/room/point/1/xy f:0.5 f:0.5 OURS 1 EXPECT MOVES EVENTS REPLIES ACCEPTED 0 REFUSED 1 LAST not_held
RECV 0.100000001 127.0.0.1 57120 /manifold/room/point/1/take i:1 i:9002 OURS 1 EXPECT MOVES EVENTS Taken 1 - 127.0.0.1:57120 ; REPLIES 127.0.0.1:9002 /manifold/room/point/1/reply i:1 i:1 s:take s: ; ACCEPTED 1 REFUSED 1 LAST not_held
RECV 0.200000003 127.0.0.1 57120 /manifold/room/point/1/xy f:0.25 f:0.75 OURS 1 EXPECT MOVES 1 xy 0.25 0.75 ; EVENTS REPLIES ACCEPTED 2 REFUSED 1 LAST not_held
RECV 0.300000012 127.0.0.1 57120 /manifold/room/point/1/z f:0.3 OURS 1 EXPECT MOVES 1 z 0.300000012 ; EVENTS REPLIES ACCEPTED 3 REFUSED 1 LAST not_held
RECV 0.400000006 127.0.0.1 57120 /manifold/room/point/1/z f:0.9 OURS 1 EXPECT MOVES 1 z 0.5 ; EVENTS REPLIES ACCEPTED 4 REFUSED 1 LAST not_held
RECV 0.5 127.0.0.1 57120 /manifold/room/point/1/u f:-1.0 OURS 1 EXPECT MOVES 1 u 0 ; EVENTS REPLIES ACCEPTED 5 REFUSED 1 LAST not_held
RECV 0.600000024 127.0.0.1 57120 /manifold/room/point/1/xyz f:0.5 i:1 f:0.1 OURS 1 EXPECT MOVES 1 xy 0.5 1 z 0.100000001 ; EVENTS REPLIES ACCEPTED 6 REFUSED 1 LAST not_held
RECV 0.699999988 127.0.0.1 57120 /manifold/room/point/1/release i:2 OURS 1 EXPECT MOVES EVENTS Returned 1 released 127.0.0.1:57120 ; REPLIES 127.0.0.1:9002 /manifold/room/point/1/reply i:2 i:1 s:release s: ; ACCEPTED 7 REFUSED 1 LAST not_held
RECV 0.800000012 127.0.0.1 57120 /manifold/room/point/1/z f:0.2 OURS 1 EXPECT MOVES EVENTS REPLIES ACCEPTED 7 REFUSED 2 LAST not_held
END

# a second sender cannot take a held point, nor move it, nor
# release it; the holder taking again is a retry
SCRIPT two_senders SPEC - PLAN all PREFIX /manifold/room EXTENT 0 0.5 2
RECV 0 127.0.0.1 57120 /manifold/room/point/1/take i:7 i:0 OURS 1 EXPECT MOVES EVENTS Taken 1 - 127.0.0.1:57120 ; REPLIES 127.0.0.1:57120 /manifold/room/point/1/reply i:7 i:1 s:take s: ; ACCEPTED 1 REFUSED 0 LAST -
RECV 0.100000001 127.0.0.1 57300 /manifold/room/point/1/take i:1 i:0 OURS 1 EXPECT MOVES EVENTS REPLIES 127.0.0.1:57300 /manifold/room/point/1/reply i:1 i:0 s:take s:held_by_127.0.0.1:57120 ; ACCEPTED 1 REFUSED 1 LAST held
RECV 0.200000003 127.0.0.1 57300 /manifold/room/point/1/xy f:0.5 f:0.5 OURS 1 EXPECT MOVES EVENTS REPLIES ACCEPTED 1 REFUSED 2 LAST not_the_holder
RECV 0.300000012 127.0.0.1 57300 /manifold/room/point/1/release i:2 OURS 1 EXPECT MOVES EVENTS REPLIES 127.0.0.1:57300 /manifold/room/point/1/reply i:2 i:0 s:release s:not_the_holder ; ACCEPTED 1 REFUSED 3 LAST not_the_holder
RECV 0.400000006 127.0.0.1 57120 /manifold/room/point/1/take i:8 i:0 OURS 1 EXPECT MOVES EVENTS REPLIES 127.0.0.1:57120 /manifold/room/point/1/reply i:8 i:1 s:take s: ; ACCEPTED 2 REFUSED 3 LAST not_the_holder
RECV 0.5 127.0.0.1 57120 /manifold/room/point/1/release i:9 OURS 1 EXPECT MOVES EVENTS Returned 1 released 127.0.0.1:57120 ; REPLIES 127.0.0.1:57120 /manifold/room/point/1/reply i:9 i:1 s:release s: ; ACCEPTED 3 REFUSED 3 LAST not_the_holder
RECV 0.600000024 127.0.0.1 57300 /manifold/room/point/1/take i:3 i:0 OURS 1 EXPECT MOVES EVENTS Taken 1 - 127.0.0.1:57300 ; REPLIES 127.0.0.1:57300 /manifold/room/point/1/reply i:3 i:1 s:take s: ; ACCEPTED 4 REFUSED 3 LAST not_the_holder
END

# a repeated request id from the same sender: the same answer
# again, nothing done twice -- a refusal repeated stays refused
SCRIPT repeats SPEC - PLAN all PREFIX /manifold/room EXTENT 0 0.5 2
RECV 0 127.0.0.1 57120 /manifold/room/point/1/take i:5 i:9002 OURS 1 EXPECT MOVES EVENTS Taken 1 - 127.0.0.1:57120 ; REPLIES 127.0.0.1:9002 /manifold/room/point/1/reply i:5 i:1 s:take s: ; ACCEPTED 1 REFUSED 0 LAST -
RECV 0.100000001 127.0.0.1 57120 /manifold/room/point/1/take i:5 i:9002 OURS 1 EXPECT MOVES EVENTS REPLIES 127.0.0.1:9002 /manifold/room/point/1/reply i:5 i:1 s:take s: ; ACCEPTED 1 REFUSED 0 LAST -
RECV 0.200000003 127.0.0.1 57120 /manifold/room/point/1/release i:6 OURS 1 EXPECT MOVES EVENTS Returned 1 released 127.0.0.1:57120 ; REPLIES 127.0.0.1:9002 /manifold/room/point/1/reply i:6 i:1 s:release s: ; ACCEPTED 2 REFUSED 0 LAST -
RECV 0.300000012 127.0.0.1 57120 /manifold/room/point/1/release i:6 OURS 1 EXPECT MOVES EVENTS REPLIES 127.0.0.1:9002 /manifold/room/point/1/reply i:6 i:1 s:release s: ; ACCEPTED 2 REFUSED 0 LAST -
RECV 0.400000006 127.0.0.1 57120 /manifold/room/point/1/release i:7 OURS 1 EXPECT MOVES EVENTS REPLIES 127.0.0.1:57120 /manifold/room/point/1/reply i:7 i:0 s:release s:not_held ; ACCEPTED 2 REFUSED 1 LAST not_held
RECV 0.5 127.0.0.1 57120 /manifold/room/point/1/release i:7 OURS 1 EXPECT MOVES EVENTS REPLIES 127.0.0.1:57120 /manifold/room/point/1/reply i:7 i:0 s:release s:not_held ; ACCEPTED 2 REFUSED 1 LAST not_held
END

