# ofxManifold smoother conformance vectors
# GENERATED by tests/ref/reference_smoother.py -- do not hand edit
#
# SEQUENCES, not single calls. A smoother has memory, so one
# call proves nothing: an implementation right on the first
# tick and wrong on the fourth passes any single-shot check.

TOL 1e-06

# half-life 0 and no slew limit: the target passes through untouched, immediately, every tick. Smoothing must be something you can turn off completely
SMOOTH disabled_passthrough ANALYTIC HALFLIFE 0 MAXRATE 0 DT 0.01666666667
SNAP 0=0.5 1=0.3 2=0.2
TICK 5=0.6 6=0.4 EXPECT 5=0.6 6=0.4
TICK 5=0.6 6=0.4 EXPECT 5=0.6 6=0.4
TICK 0=0.5 1=0.3 2=0.2 EXPECT 0=0.5 1=0.3 2=0.2
ENDSMOOTH

# Disabled AND dt = 0. The early return for a disabled
# smoother sits BEFORE the dt check, deliberately: if
# smoothing is off, elapsed time is irrelevant and the target
# should pass through regardless.
#
# This is the only case that distinguishes the early return
# from the general path. With half-life 0 the general path
# computes alpha = 1 and lands on the target anyway, so every
# other disabled vector passes either way -- the early return
# looked like an untested optimization until dt = 0 was tried.
SMOOTH disabled_zero_dt ANALYTIC HALFLIFE 0 MAXRATE 0 DT 0
SNAP 0=0.5 1=0.3 2=0.2
TICK 5=0.6 6=0.4 EXPECT 5=0.6 6=0.4
TICK 5=0.6 6=0.4 EXPECT 5=0.6 6=0.4
ENDSMOOTH

# dt equals the half-life exactly, so each tick closes half the remaining distance: 0.5, 0.75, 0.875, 0.9375. This is what 'half-life' has to mean, checked rather than assumed
SMOOTH one_half_life_per_tick ANALYTIC HALFLIFE 0.25 MAXRATE 0 DT 0.25
SNAP 0=0
TICK 0=1 EXPECT 0=0.5
TICK 0=1 EXPECT 0=0.75
TICK 0=1 EXPECT 0=0.875
TICK 0=1 EXPECT 0=0.9375
ENDSMOOTH

# FRAME-RATE INDEPENDENCE. Six ticks at 60fps and three at
# 30fps cover the same 0.1 seconds and must land in the same
# place. A per-frame coefficient would not: a smoother tuned
# in rehearsal on one machine would behave differently on
# another, which is a bad surprise on an opening night.
RATEMATCH rate_independent ANALYTIC 0.1 0.01666666667 6 0.03333333333 3 TARGET 0=1 EXPECT 0.5

# PARTITION OF UNITY, through a transition between two
# weight vectors that share NO nodes at all.
#
# Exponential smoothing preserves it exactly. The smoothed
# vector is a lerp between two vectors that each sum to one,
# taken over their union with absent nodes at zero, so the
# sum is a lerp of 1 and 1.
#
# This is worth knowing rather than assuming, because it
# means smoothing can sit anywhere in the chain without
# disturbing the invariant every other layer relies on.
SUMAT sum_disjoint_1 ANALYTIC 0.1 0 0.01666666667 SNAP 0=0.5 1=0.3 2=0.2 TARGET 5=0.6 6=0.4 TICKS 1 SUM 1
SUMAT sum_disjoint_2 ANALYTIC 0.1 0 0.01666666667 SNAP 0=0.5 1=0.3 2=0.2 TARGET 5=0.6 6=0.4 TICKS 2 SUM 1
SUMAT sum_disjoint_4 ANALYTIC 0.1 0 0.01666666667 SNAP 0=0.5 1=0.3 2=0.2 TARGET 5=0.6 6=0.4 TICKS 4 SUM 1
SUMAT sum_disjoint_8 ANALYTIC 0.1 0 0.01666666667 SNAP 0=0.5 1=0.3 2=0.2 TARGET 5=0.6 6=0.4 TICKS 8 SUM 1
SUMAT sum_disjoint_12 ANALYTIC 0.1 0 0.01666666667 SNAP 0=0.5 1=0.3 2=0.2 TARGET 5=0.6 6=0.4 TICKS 12 SUM 1

# A SLEW LIMIT DOES NOT preserve partition of unity during a
# transition, and that is not a bug to be corrected.
#
# Each component is clamped independently, so while three
# nodes fall and two rise the totals do not balance. The sum
# dips, holds while the rates happen to match, and recovers
# to one once the departing nodes reach zero.
#
# Renormalizing would hide it and would break the bound the
# caller asked for -- the whole point of a slew limit is that
# nothing moves faster than the stated rate. Recorded rather
# than fixed.
SUMAT sum_slewed_1 SPEC 0 2 0.01666666667 SNAP 0=0.5 1=0.3 2=0.2 TARGET 5=0.6 6=0.4 TICKS 1 SUM 0.9666666667
SUMAT sum_slewed_5 SPEC 0 2 0.01666666667 SNAP 0=0.5 1=0.3 2=0.2 TARGET 5=0.6 6=0.4 TICKS 5 SUM 0.8333333333
SUMAT sum_slewed_10 SPEC 0 2 0.01666666667 SNAP 0=0.5 1=0.3 2=0.2 TARGET 5=0.6 6=0.4 TICKS 10 SUM 0.8333333333
SUMAT sum_slewed_20 ANALYTIC 0 2 0.01666666667 SNAP 0=0.5 1=0.3 2=0.2 TARGET 5=0.6 6=0.4 TICKS 20 SUM 1
SUMAT sum_slewed_40 ANALYTIC 0 2 0.01666666667 SNAP 0=0.5 1=0.3 2=0.2 TARGET 5=0.6 6=0.4 TICKS 40 SUM 1

# The bound itself: no component may move by more than
# maxRate * dt in one tick, however far away its target is.
# target 1.0 from 0.0 with a 2.0/s limit at 1/60s: exactly 0.0333 per tick, five ticks reaching 0.1667
SMOOTH slew_bounded ANALYTIC HALFLIFE 0 MAXRATE 2 DT 0.01666666667
SNAP 0=0
TICK 0=1 EXPECT 0=0.03333333333
TICK 0=1 EXPECT 0=0.06666666667
TICK 0=1 EXPECT 0=0.1
TICK 0=1 EXPECT 0=0.1333333333
TICK 0=1 EXPECT 0=0.1666666667
ENDSMOOTH

# same node set, weights moving
SMOOTH converge_same_set CROSS HALFLIFE 0.08 MAXRATE 0 DT 0.01666666667
SNAP 0=0.5 1=0.3 2=0.2
TICK 0=0.2 1=0.2 2=0.6 EXPECT 0=0.4596609683 1=0.2865536561 2=0.2537853756
TICK 0=0.2 1=0.2 2=0.6 EXPECT 0=0.4247460615 1=0.2749153538 2=0.3003385846
TICK 0=0.2 1=0.2 2=0.6 EXPECT 0=0.3945259332 1=0.2648419777 2=0.3406320891
TICK 0=0.2 1=0.2 2=0.6 EXPECT 0=0.3683693072 1=0.2561231024 2=0.3755075903
TICK 0=0.2 1=0.2 2=0.6 EXPECT 0=0.3457297912 1=0.2485765971 2=0.4056936118
TICK 0=0.2 1=0.2 2=0.6 EXPECT 0=0.3261344623 1=0.2420448208 2=0.4318207169
ENDSMOOTH

# the node set changes completely
SMOOTH disjoint_transition CROSS HALFLIFE 0.08 MAXRATE 0 DT 0.01666666667
SNAP 0=0.5 1=0.3 2=0.2
TICK 5=0.6 6=0.4 EXPECT 0=0.4327682805 1=0.2596609683 2=0.1731073122 5=0.0806780634 6=0.0537853756
TICK 5=0.6 6=0.4 EXPECT 0=0.3745767692 1=0.2247460615 2=0.1498307077 5=0.1505078769 6=0.1003385846
TICK 5=0.6 6=0.4 EXPECT 0=0.3242098887 1=0.1945259332 2=0.1296839555 5=0.2109481336 6=0.1406320891
TICK 5=0.6 6=0.4 EXPECT 0=0.2806155121 1=0.1683693072 2=0.1122462048 5=0.2632613855 6=0.1755075903
TICK 5=0.6 6=0.4 EXPECT 0=0.2428829853 1=0.1457297912 2=0.09715319412 5=0.3085404177 6=0.2056936118
TICK 5=0.6 6=0.4 EXPECT 0=0.2102241038 1=0.1261344623 2=0.08408964153 5=0.3477310754 6=0.2318207169
ENDSMOOTH

# one node leaves, one arrives, two persist -- the ordinary case when a point crosses a region boundary
SMOOTH partial_overlap CROSS HALFLIFE 0.08 MAXRATE 0 DT 0.01666666667
SNAP 0=0.5 1=0.3 2=0.2
TICK 1=0.4 2=0.3 7=0.3 EXPECT 0=0.4327682805 1=0.3134463439 2=0.2134463439 7=0.0403390317
TICK 1=0.4 2=0.3 7=0.3 EXPECT 0=0.3745767692 1=0.3250846462 2=0.2250846462 7=0.07525393847
TICK 1=0.4 2=0.3 7=0.3 EXPECT 0=0.3242098887 1=0.3351580223 2=0.2351580223 7=0.1054740668
TICK 1=0.4 2=0.3 7=0.3 EXPECT 0=0.2806155121 1=0.3438768976 2=0.2438768976 7=0.1316306928
TICK 1=0.4 2=0.3 7=0.3 EXPECT 0=0.2428829853 1=0.3514234029 2=0.2514234029 7=0.1542702088
ENDSMOOTH

# the point leaves the hull and the target becomes EMPTY. Every node decays toward zero rather than vanishing in one frame, which is the fade a hull exit should sound like
SMOOTH hull_exit CROSS HALFLIFE 0.08 MAXRATE 0 DT 0.01666666667
SNAP 0=0.5 1=0.3 2=0.2
TICK  EXPECT 0=0.4327682805 1=0.2596609683 2=0.1731073122
TICK  EXPECT 0=0.3745767692 1=0.2247460615 2=0.1498307077
TICK  EXPECT 0=0.3242098887 1=0.1945259332 2=0.1296839555
TICK  EXPECT 0=0.2806155121 1=0.1683693072 2=0.1122462048
TICK  EXPECT 0=0.2428829853 1=0.1457297912 2=0.09715319412
TICK  EXPECT 0=0.2102241038 1=0.1261344623 2=0.08408964153
ENDSMOOTH

# exponential and slew together: the exponential result is computed first and then clamped by the rate
SMOOTH both_enabled CROSS HALFLIFE 0.05 MAXRATE 3 DT 0.01666666667
SNAP 0=0.5 1=0.3 2=0.2
TICK 5=0.6 6=0.4 EXPECT 0=0.45 1=0.25 2=0.1587401052 5=0.05 6=0.05
TICK 5=0.6 6=0.4 EXPECT 0=0.4 1=0.2 2=0.125992105 5=0.1 6=0.1
TICK 5=0.6 6=0.4 EXPECT 0=0.35 1=0.1587401052 2=0.1 5=0.15 6=0.15
TICK 5=0.6 6=0.4 EXPECT 0=0.3 1=0.125992105 2=0.0793700526 5=0.2 6=0.2
TICK 5=0.6 6=0.4 EXPECT 0=0.25 1=0.1 2=0.06299605249 5=0.25 6=0.2412598948
TICK 5=0.6 6=0.4 EXPECT 0=0.2 1=0.0793700526 2=0.05 5=0.3 6=0.274007895
ENDSMOOTH

# PRUNING. A node that has decayed below the threshold AND is
# no longer wanted is dropped, or a source that wandered the
# whole map would carry an entry for every node it ever
# touched.
PRUNE prune_drops_decayed ANALYTIC 0.02 0 0.01666666667 SNAP 0=1 TARGET 1=1 TICKS 20 FINALCOUNT 1

# but a node genuinely HELD at a tiny weight must not be
# pruned, or it would flicker out and back as the point moved
PRUNE prune_keeps_held SPEC 0.02 0 0.01666666667 SNAP 0=0.5 1=0.5 2=1e-05 TARGET 0=0.5 1=0.5 2=1e-05 TICKS 30 FINALCOUNT 3

# dt of zero or less leaves the state untouched rather than
# dividing by it
SMOOTH zero_dt ANALYTIC HALFLIFE 0.1 MAXRATE 0 DT 0
SNAP 0=0.5 1=0.3 2=0.2
TICK 5=0.6 6=0.4 EXPECT 0=0.5 1=0.3 2=0.2
TICK 5=0.6 6=0.4 EXPECT 0=0.5 1=0.3 2=0.2
ENDSMOOTH

# settled() answers when a transition is over. Exponential
# smoothing never exactly arrives, so a consumer needs a
# threshold, and picking it once is better than every caller
# picking a different one.
SETTLED settles_eventually ANALYTIC 0.05 0 0.01666666667 SNAP 0=0.5 1=0.3 2=0.2 TARGET 5=0.6 6=0.4 FIRSTSETTLED 28
