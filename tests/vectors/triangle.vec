# ofxManifold triangle conformance vectors
# GENERATED by tests/ref/reference.py -- do not hand edit
#
# class ANALYTIC : expected value known by hand from geometry
# class CROSS    : expected value from the Python reference
# class SPEC     : expected value follows a rule we invented;
#                  green means self-consistent, not correct
#
# TRI  name class ax ay bx by cx cy  na nb nc  px py  ea eb ec
# tolerance 1e-06

TOL 1e-06

# centroid is exactly one third at each vertex
TRI centroid_thirds ANALYTIC 0.2 0.2 0.8 0.25 0.45 0.85 1 1 1 0.4833333333 0.4333333333 0.3333333333 0.3333333333 0.3333333333

# a point at vertex A is entirely that vertex
TRI vertex_a_unity ANALYTIC 0.2 0.2 0.8 0.25 0.45 0.85 1 1 1 0.2 0.2 1 0 0

# a point at vertex B is entirely that vertex
TRI vertex_b_unity ANALYTIC 0.2 0.2 0.8 0.25 0.45 0.85 1 1 1 0.8 0.25 0 1 0

# a point at vertex C is entirely that vertex
TRI vertex_c_unity ANALYTIC 0.2 0.2 0.8 0.25 0.45 0.85 1 1 1 0.45 0.85 0 0 1

# midpoint of edge AB: opposite vertex contributes zero
TRI midpoint_ab ANALYTIC 0.2 0.2 0.8 0.25 0.45 0.85 1 1 1 0.5 0.225 0.5 0.5 0

# midpoint of edge BC: opposite vertex contributes zero
TRI midpoint_bc ANALYTIC 0.2 0.2 0.8 0.25 0.45 0.85 1 1 1 0.625 0.55 0 0.5 0.5

# midpoint of edge CA: opposite vertex contributes zero
TRI midpoint_ca ANALYTIC 0.2 0.2 0.8 0.25 0.45 0.85 1 1 1 0.325 0.525 0.5 0 0.5

# interior point, value from the Python reference
TRI interior_1 CROSS 0.2 0.2 0.8 0.25 0.45 0.85 1 1 1 0.45 0.4 0.417218543 0.298013245 0.2847682119

# interior point, value from the Python reference
TRI interior_2 CROSS 0.2 0.2 0.8 0.25 0.45 0.85 1 1 1 0.35 0.3 0.6688741722 0.1920529801 0.1390728477

# interior point, value from the Python reference
TRI interior_3 CROSS 0.2 0.2 0.8 0.25 0.45 0.85 1 1 1 0.6 0.45 0.1324503311 0.5231788079 0.3443708609

# interior point, value from the Python reference
TRI interior_4 CROSS 0.2 0.2 0.8 0.25 0.45 0.85 1 1 1 0.48 0.7 0.09139072848 0.1509933775 0.757615894

# just inside edge AB; catches cancellation in the solve
TRI near_edge_ab CROSS 0.2 0.2 0.8 0.25 0.45 0.85 1 1 1 0.501 0.226 0.4974834437 0.5010596026 0.001456953642

# equal coords, so result is the normalized bias vector
TRI bias_at_centroid SPEC 0.2 0.2 0.8 0.25 0.45 0.85 2 1 1 0.4833333333 0.4333333333 0.5 0.25 0.25

# bias of 1.0 everywhere must not perturb the result
TRI bias_unity_is_identity SPEC 0.2 0.2 0.8 0.25 0.45 0.85 1 1 1 0.45 0.4 0.417218543 0.298013245 0.2847682119

# multiply-then-renormalize, from the Python reference
TRI bias_asymmetric SPEC 0.2 0.2 0.8 0.25 0.45 0.85 1 3 0.5 0.45 0.4 0.2870159453 0.6150341686 0.0979498861

# near-zero bias must vanish smoothly, not divide by zero
TRI bias_near_zero SPEC 0.2 0.2 0.8 0.25 0.45 0.85 1 1 0.0001 0.45 0.4 0.5833101089 0.4166500778 3.981322966e-05

# shared edge B-C: both triangles must agree on B and C, and
# each must report exactly zero for its opposite vertex
PAIR shared_edge_bc ANALYTIC 0.2 0.2 0.8 0.25 0.45 0.85 0.8 0.25 0.45 0.85 0.95 0.8 0.625 0.55

# exactly collinear: doubled area is zero in exact arithmetic
# and 4.17e-09 under FMA contraction. Must be REJECTED either way.
DEGENERATE collinear_zero_area ANALYTIC 0.1 0.1 0.4 0.4 0.7 0.7

# thin but not collinear: doubled area 1e-7, below epsilon
DEGENERATE sliver_below_eps ANALYTIC 0.0 0.0 1.0 0.0 0.5 0.0000001

# thin but valid: doubled area 1e-5, ten times epsilon.
# Must be ACCEPTED -- this is the guard against an epsilon
# raised so far that it eats legitimate topology.
ACCEPT thin_but_valid ANALYTIC 0.0 0.0 1.0 0.0 0.5 0.00001

# a cell of a 100x100 normalized grid: doubled area 1e-4.
# Ordinary fine-mesh topology, must be ACCEPTED.
ACCEPT fine_mesh_cell ANALYTIC 0.0 0.0 0.01 0.0 0.0 0.01

# the canonical test triangle: unremarkable, must be ACCEPTED
ACCEPT canonical_triangle ANALYTIC 0.2 0.2 0.8 0.25 0.45 0.85
