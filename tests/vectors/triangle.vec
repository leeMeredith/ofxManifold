# ofxManifold triangle conformance vectors
# GENERATED by tests/ref/reference.py -- do not hand edit
#
# class ANALYTIC : expected value known by hand from geometry
# class CROSS    : expected value from the Python reference
# class SPEC     : expected value follows a rule we invented;
#                  green means self-consistent, not correct
#
# TRI  name class ax ay bx by cx cy  na nb nc  px py  ea eb ec
# tolerance 1e-06

TOL 9.9999999999999995e-07

# centroid is exactly one third at each vertex
TRI centroid_thirds ANALYTIC 0.20000000000000001 0.20000000000000001 0.80000000000000004 0.25 0.45000000000000001 0.84999999999999998 1 1 1 0.48333333333333334 0.43333333333333335 0.33333333333333331 0.33333333333333331 0.33333333333333331

# a point at vertex A is entirely that vertex
TRI vertex_a_unity ANALYTIC 0.20000000000000001 0.20000000000000001 0.80000000000000004 0.25 0.45000000000000001 0.84999999999999998 1 1 1 0.20000000000000001 0.20000000000000001 1 0 0

# a point at vertex B is entirely that vertex
TRI vertex_b_unity ANALYTIC 0.20000000000000001 0.20000000000000001 0.80000000000000004 0.25 0.45000000000000001 0.84999999999999998 1 1 1 0.80000000000000004 0.25 0 1 0

# a point at vertex C is entirely that vertex
TRI vertex_c_unity ANALYTIC 0.20000000000000001 0.20000000000000001 0.80000000000000004 0.25 0.45000000000000001 0.84999999999999998 1 1 1 0.45000000000000001 0.84999999999999998 0 0 1

# midpoint of edge AB: opposite vertex contributes zero
TRI midpoint_ab ANALYTIC 0.20000000000000001 0.20000000000000001 0.80000000000000004 0.25 0.45000000000000001 0.84999999999999998 1 1 1 0.5 0.22500000000000001 0.5 0.5 0

# midpoint of edge BC: opposite vertex contributes zero
TRI midpoint_bc ANALYTIC 0.20000000000000001 0.20000000000000001 0.80000000000000004 0.25 0.45000000000000001 0.84999999999999998 1 1 1 0.625 0.55000000000000004 0 0.5 0.5

# midpoint of edge CA: opposite vertex contributes zero
TRI midpoint_ca ANALYTIC 0.20000000000000001 0.20000000000000001 0.80000000000000004 0.25 0.45000000000000001 0.84999999999999998 1 1 1 0.32500000000000001 0.52500000000000002 0.5 0 0.5

# interior point, value from the Python reference
TRI interior_1 CROSS 0.20000000000000001 0.20000000000000001 0.80000000000000004 0.25 0.45000000000000001 0.84999999999999998 1 1 1 0.45000000000000001 0.40000000000000002 0.41721854304635758 0.29801324503311249 0.28476821192052987

# interior point, value from the Python reference
TRI interior_2 CROSS 0.20000000000000001 0.20000000000000001 0.80000000000000004 0.25 0.45000000000000001 0.84999999999999998 1 1 1 0.34999999999999998 0.29999999999999999 0.66887417218543055 0.19205298013245023 0.13907284768211922

# interior point, value from the Python reference
TRI interior_3 CROSS 0.20000000000000001 0.20000000000000001 0.80000000000000004 0.25 0.45000000000000001 0.84999999999999998 1 1 1 0.59999999999999998 0.45000000000000001 0.13245033112582782 0.52317880794701976 0.34437086092715241

# interior point, value from the Python reference
TRI interior_4 CROSS 0.20000000000000001 0.20000000000000001 0.80000000000000004 0.25 0.45000000000000001 0.84999999999999998 1 1 1 0.47999999999999998 0.69999999999999996 0.091390728476821281 0.15099337748344366 0.75761589403973506

# just inside edge AB; catches cancellation in the solve
TRI near_edge_ab CROSS 0.20000000000000001 0.20000000000000001 0.80000000000000004 0.25 0.45000000000000001 0.84999999999999998 1 1 1 0.501 0.22600000000000001 0.49748344370860936 0.50105960264900651 0.0014569536423841155

# equal coords, so result is the normalized bias vector
TRI bias_at_centroid SPEC 0.20000000000000001 0.20000000000000001 0.80000000000000004 0.25 0.45000000000000001 0.84999999999999998 2 1 1 0.48333333333333334 0.43333333333333335 0.5 0.25 0.25

# bias of 1.0 everywhere must not perturb the result
TRI bias_unity_is_identity SPEC 0.20000000000000001 0.20000000000000001 0.80000000000000004 0.25 0.45000000000000001 0.84999999999999998 1 1 1 0.45000000000000001 0.40000000000000002 0.41721854304635758 0.29801324503311249 0.28476821192052987

# multiply-then-renormalize, from the Python reference
TRI bias_asymmetric SPEC 0.20000000000000001 0.20000000000000001 0.80000000000000004 0.25 0.45000000000000001 0.84999999999999998 1 3 0.5 0.45000000000000001 0.40000000000000002 0.28701594533029617 0.6150341685649201 0.09794988610478364

# near-zero bias must vanish smoothly, not divide by zero
TRI bias_near_zero SPEC 0.20000000000000001 0.20000000000000001 0.80000000000000004 0.25 0.45000000000000001 0.84999999999999998 1 1 0.0001 0.45000000000000001 0.40000000000000002 0.58331010894936597 0.41665007782097563 3.98132296584488e-05

# shared edge B-C: both triangles must agree on B and C, and
# each must report exactly zero for its opposite vertex
PAIR shared_edge_bc ANALYTIC 0.20000000000000001 0.20000000000000001 0.80000000000000004 0.25 0.45000000000000001 0.84999999999999998 0.80000000000000004 0.25 0.45000000000000001 0.84999999999999998 0.94999999999999996 0.80000000000000004 0.625 0.55000000000000004

# exactly collinear: doubled area is zero in exact arithmetic
# and 4.17e-09 under FMA contraction. Must be REJECTED either way.
DEGENERATE collinear_zero_area ANALYTIC 0.1 0.1 0.4 0.4 0.7 0.7

# thin but not collinear: doubled area 1e-7, below epsilon
DEGENERATE sliver_below_eps ANALYTIC 0.0 0.0 1.0 0.0 0.5 0.0000001

# thin but valid: doubled area 1e-5, ten times epsilon.
# Must be ACCEPTED -- this is the guard against an epsilon
# raised so far that it eats legitimate topology.
ACCEPT thin_but_valid ANALYTIC 0.0 0.0 1.0 0.0 0.5 0.00001

# a cell of a 100x100 normalized grid: doubled area 1e-4.
# Ordinary fine-mesh topology, must be ACCEPTED.
ACCEPT fine_mesh_cell ANALYTIC 0.0 0.0 0.01 0.0 0.0 0.01

# the canonical test triangle: unremarkable, must be ACCEPTED
ACCEPT canonical_triangle ANALYTIC 0.2 0.2 0.8 0.25 0.45 0.85
