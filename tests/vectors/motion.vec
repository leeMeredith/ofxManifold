# ---- clocks
# a drop of more than half (0.98 to 0.02) is a new bar; of less (0.5 to 0.01) is not
PHASE phase_wraps ANALYTIC
COUNT 0 0 0
FEED 0 0.1
COUNT 0 0.1 1
FEED 0.01 0.6
FEED 0.02 0.98
COUNT 0.02 0.98 1
FEED 0.03 0.02
COUNT 0.03 1.02 1
FEED 0.04 0.5
FEED 0.05 0.01
COUNT 0.05 1.5 1
END
# a smaller drop is a packet out of order: held, never backwards
PHASE phase_out_of_order SPEC
FEED 0 0.4
FEED 0.01 0.42
FEED 0.02 0.41
COUNT 0.02 0.42 1
FEED 0.03 0.43
COUNT 0.03 0.43 1
FEED 0.04 0.9
FEED 0.05 0.45
COUNT 0.05 0.9 1
END
# bridge.scd run again: the phase back to 0 late in a bar is a new bar
PHASE phase_restart SPEC
FEED 0 0.3
FEED 0.5 0.8
FEED 0.6 0
COUNT 0.6 1 1
FEED 0.7 0.2
COUNT 0.7 1.2 1
END
# a bar number sent with the phase is the bar itself; never backwards
PHASE phase_bar_given ANALYTIC
FEED 0 0.25 7
COUNT 0 7.25 1
FEED 0.1 0.9 7
FEED 0.2 0.1 8
COUNT 0.2 8.1 1
FEED 0.3 0.95 7
COUNT 0.3 8.1 1
END
# no phase for over a second: not heard, the count held
PHASE phase_not_heard SPEC
FEED 0 0.5
COUNT 0.5 0.5 1
COUNT 1 0.5 1
COUNT 1.01 0.5 0
FEED 3 0.6
COUNT 3 0.6 1
END
