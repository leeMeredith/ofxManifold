CONN 7.1 0 ""
FRAME 7.2 | - | - | - | 3
MSG /manifold/map ,siii "/manifold/untitled" 0 0 2
MSG /manifold/untitled/outputs ,i 0
MSG /manifold/untitled/levels ,
END
